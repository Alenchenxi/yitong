{
  "name": "yitong",
  "version": "0.1.0",
  "private": true,
  "description": "燚桐 - 校园生活聚合小程序（表白墙 / 树洞 / 兼职）",
  "scripts": {
    "dev:server": "pnpm --filter @yitong/shared-types build && pnpm --filter @yitong/shared-utils build && pnpm --filter @yitong/server dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @yitong/shared-types build && pnpm --filter @yitong/shared-utils build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.7.0",
    "miniprogram-api-typings": "^5.2.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core"
    ]
  }
}
