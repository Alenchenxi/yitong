.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: var(--yt-tabbar-height, 104rpx);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e5e6eb;
  box-sizing: content-box;
}

.tabbar-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: var(--yt-tabbar-height, 104rpx);
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
}

.tabbar-text {
  margin-top: 4rpx;
  color: #86909c;
  font-size: 20rpx;
  line-height: 28rpx;
}

.tabbar-text.selected {
  color: #1d2129;
}
