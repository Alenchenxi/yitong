.bt {
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid var(--yt-border, #f0f0f0);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bt-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
  color: var(--yt-text-weak, #86909c);
  font-size: 22rpx;
}
/* 选中态：图标品牌黄（selectedIconPath）+ 文字主黑 #1D2129（UI 规范 §6.5） */
.bt-item.bt-active {
  color: var(--yt-text-main, #1D2129);
  font-weight: 600;
}
.bt-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}
.bt-label {
  line-height: 1.2;
}
