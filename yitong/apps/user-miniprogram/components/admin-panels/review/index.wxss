@import "../admin-common.wxss";

.adm-context {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--yt-border);
  border-radius: 8rpx;
  background: var(--yt-card);
}
.adm-context-scopes { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.adm-context-scope {
  min-width: 120rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--yt-border);
  border-radius: 8rpx;
  text-align: center;
  color: var(--yt-text-sub);
  font-size: 24rpx;
}
.adm-context-scope.on {
  border-color: var(--yt-primary);
  background: var(--yt-primary-light);
  color: var(--yt-text-main);
  font-weight: 600;
}
.adm-context-picker {
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--yt-border);
  border-radius: 8rpx;
  background: var(--yt-bg);
  color: var(--yt-text-main);
  font-size: 24rpx;
}
.adm-context-note { color: var(--yt-text-sub); font-size: 22rpx; line-height: 1.6; }
.adm-platform-badge {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid #E3BD22;
  border-radius: 8rpx;
  background: #FFF7D1;
  color: #735700;
  font-size: 20rpx;
  font-weight: 500;
  vertical-align: middle;
}

/* P2-95 列表理由超两行折叠，点击条目进详情看全文 */
.adm-item-reason {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* P2-95 举报详情弹层（复用 users 面板 adm-dialog 体系） */
.adm-dialog {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}
.adm-dialog-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
}
.adm-dialog-panel {
  position: absolute;
  top: 8%;
  bottom: 8%;
  left: 5%;
  right: 5%;
  background-color: var(--yt-card);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
}
.adm-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--yt-text-main);
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.adm-dialog-list { flex: 1; min-height: 0; }
.adm-dialog-footer {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  padding-top: 16rpx;
  flex-shrink: 0;
}
.adm-detail-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--yt-border);
}
.adm-detail-row .adm-status { align-self: flex-start; } /* 弹层行是 column flex，否则胶囊背景被 stretch 拉满整行 */
.adm-detail-label { font-size: 22rpx; color: var(--yt-text-sub); }
.adm-detail-content { font-size: 28rpx; color: var(--yt-text-main); line-height: 1.6; word-break: break-all; white-space: pre-wrap; }
