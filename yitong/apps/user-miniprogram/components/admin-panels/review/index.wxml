<wxs src="../admin-status.wxs" module="st" />
<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="adm-page">
  <scroll-view scroll-x class="adm-subtabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{allowedSubs}}" wx:key="*this" class="adm-subtab {{sub === item ? 'on' : ''}}" data-sub="{{item}}" bindtap="switchSub">{{subLabels[item]}}</view>
  </scroll-view>

  <view class="adm-context" wx:if="{{sub === 'posts' || sub === 'anon' || sub === 'reports' || sub === 'jobs'}}">
    <view class="adm-context-scopes">
      <view
        wx:for="{{moderationScopes}}"
        wx:key="scope"
        class="adm-context-scope {{moderationScope === item.scope ? 'on' : ''}}"
        data-scope="{{item.scope}}"
        bindtap="switchModerationScope"
      >{{item.label}}</view>
    </view>
    <picker
      wx:if="{{moderationScope === 'COMMUNITY'}}"
      mode="selector"
      range="{{moderationCommunityOptions}}"
      range-key="name"
      value="{{moderationCommunityIndex}}"
      bindchange="onModerationCommunityChange"
    >
      <view class="adm-context-picker">{{moderationCommunityOptions[moderationCommunityIndex].name || '选择圈子'}}</view>
    </picker>
    <view class="adm-context-note" wx:if="{{moderationScope === 'PLATFORM'}}">平台内容仅平台管理员可管理，处置结果对所有圈子生效</view>
  </view>

  <!-- 商家入驻 -->
  <block wx:if="{{sub === 'merchant' && queue}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{merchantStatus === 'all' ? 'on' : ''}}" data-s="all" bindtap="switchMerchantStatus">全部</view>
      <view class="adm-filter-btn {{merchantStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchMerchantStatus">待审核</view>
      <view class="adm-filter-btn {{merchantStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchMerchantStatus">已通过</view>
      <view class="adm-filter-btn {{merchantStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchMerchantStatus">已拒绝</view>
    </view>
    <view class="adm-section-title">商家入驻 ({{filteredMerchants.length}})</view>
    <view class="adm-batch" wx:if="{{merchantStatus === 'PENDING' && filteredMerchants.length > 0}}" hover-class="adm-hover" bindtap="batchApprove">批量通过待审核</view>
    <view class="adm-item" wx:for="{{filteredMerchants}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.shopName}}</text>
        <text class="adm-item-sub">{{item.userNickname}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'PENDING'}}" size="mini" data-id="{{item.id}}" bindtap="approve">通过</button>
        <button wx:if="{{item.status === 'PENDING' || item.status === 'APPROVED'}}" size="mini" data-id="{{item.id}}" bindtap="reject">拒绝</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{filteredMerchants.length === 0}}">暂无商家</view>
  </block>

  <!-- 表白墙帖 -->
  <block wx:if="{{sub === 'posts'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{postStatus === '' ? 'on' : ''}}" data-s="" bindtap="switchPostStatus">全部</view>
      <view class="adm-filter-btn {{postStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchPostStatus">待审核</view>
      <view class="adm-filter-btn {{postStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchPostStatus">已通过</view>
      <view class="adm-filter-btn {{postStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchPostStatus">已拒绝</view>
    </view>
    <view class="adm-search">
      <input class="adm-search-input" placeholder="搜索帖子内容" value="{{postKeyword}}" bindinput="onPostKeywordInput" bindconfirm="searchPosts" />
      <button size="mini" bindtap="searchPosts">搜索</button>
    </view>
    <view class="adm-item" wx:for="{{posts}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title"><text wx:if="{{item.publisherScope === 'PLATFORM'}}" class="adm-platform-badge">平台发布</text>{{item.content}}</text>
        <text class="adm-item-sub">{{item.authorNickname}} · {{item.circleName}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text>{{item.pinned ? ' · 置顶' : ''}}{{item.featured ? ' · 精' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-pinned="{{item.pinned}}" bindtap="togglePin">{{item.pinned ? '取消置顶' : '置顶'}}</button>
        <button size="mini" data-id="{{item.id}}" data-featured="{{item.featured}}" bindtap="toggleFeature">{{item.featured ? '取消加精' : '加精'}}</button>
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedown">下架</button>
        <button wx:if="{{item.status === 'REJECTED' && item.moderationAuthority && (isPlatformAdmin || item.moderationAuthority === 'COMMUNITY')}}" size="mini" data-id="{{item.id}}" data-version="{{item.moderationVersion}}" bindtap="restorePostTap">恢复</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{postHasMore}}" bindtap="loadMorePosts">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="adm-empty" wx:if="{{!loading && posts.length === 0}}">暂无帖子</view>
  </block>

  <!-- 树洞帖 -->
  <block wx:if="{{sub === 'anon'}}">
    <view class="adm-item" wx:for="{{anonPosts}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title"><text wx:if="{{item.publisherScope === 'PLATFORM'}}" class="adm-platform-badge">平台发布</text>{{item.content}}</text>
        <text class="adm-item-sub">{{item.anonId}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedownAnon">下架</button>
        <button wx:if="{{item.status === 'REJECTED' && item.moderationAuthority && (isPlatformAdmin || item.moderationAuthority === 'COMMUNITY')}}" size="mini" data-id="{{item.id}}" data-version="{{item.moderationVersion}}" bindtap="restoreAnonPostTap">恢复</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{anonPostHasMore}}" bindtap="loadMoreAnonPosts">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="adm-empty" wx:if="{{!loading && anonPosts.length === 0}}">暂无树洞帖</view>
  </block>

  <!-- 评论 -->
  <block wx:if="{{sub === 'comments'}}">
    <view class="adm-search">
      <input class="adm-search-input" placeholder="按帖子ID筛选" value="{{commentPostId}}" bindinput="onCommentPostIdInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按内容搜索" value="{{commentKeyword}}" bindinput="onCommentKeywordInput" bindconfirm="searchComments" />
    </view>
    <view class="adm-search">
      <input class="adm-search-input" placeholder="按作者ID" value="{{commentAuthorId}}" bindinput="onAuthorIdInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按作者昵称" value="{{commentAuthorNickname}}" bindinput="onAuthorNicknameInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按帖子内容" value="{{commentPostTitleKw}}" bindinput="onPostTitleKwInput" bindconfirm="searchComments" />
    </view>
    <view class="adm-search"><button size="mini" bindtap="searchComments">筛选</button></view>
    <view class="adm-item" wx:for="{{comments}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.content}}</text>
        <text class="adm-item-sub">{{item.postTitle ? '帖：' + item.postTitle + ' · ' : ''}}赞{{item.likeCount}}{{item.pinned ? ' · 已置顶' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-pinned="{{item.pinned}}" bindtap="pinCommentTap">{{item.pinned ? '取消置顶' : '置顶'}}</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{commentHasMore}}" bindtap="loadMoreComments">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="adm-empty" wx:if="{{!loading && comments.length === 0}}">暂无评论</view>
  </block>

  <!-- 举报处理 -->
  <block wx:if="{{sub === 'reports'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{reportStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchReportStatus">待处理</view>
      <view class="adm-filter-btn {{reportStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchReportStatus">成立</view>
      <view class="adm-filter-btn {{reportStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchReportStatus">驳回</view>
    </view>
    <view class="adm-item" wx:for="{{reports}}" wx:key="id">
      <view class="adm-item-main" data-id="{{item.id}}" bindtap="openReportDetail">
        <text class="adm-item-title">{{item.targetSummary || item.targetType}}</text>
        <text class="adm-item-sub">举报人：{{item.reporterNickname || '匿名'}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{fmt.dateTime(item.createdAt)}}</text>
        <text class="adm-item-sub adm-item-reason" wx:if="{{item.reason}}">理由：{{item.reason}}</text>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status === 'PENDING'}}">
        <button size="mini" data-id="{{item.id}}" data-action="approve" bindtap="resolveReportTap">成立</button>
        <button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="resolveReportTap">驳回</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{reportHasMore}}" bindtap="loadMoreReports">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="adm-empty" wx:if="{{!loading && reports.length === 0}}">暂无举报</view>

    <!-- P2-95 举报详情弹层（目标全文 + 完整举报信息；表白墙/树洞/兼职/商家/报名/群聊通用） -->
    <view wx:if="{{reportDetail}}" class="adm-dialog">
      <view class="adm-dialog-mask" catchtouchmove="noop" bindtap="closeReportDetail" />
      <view class="adm-dialog-panel">
        <view class="adm-dialog-title">举报详情 · {{reportDetail.typeText}}</view>
        <scroll-view scroll-y class="adm-dialog-list" enhanced show-scrollbar="{{false}}">
          <view class="adm-detail-row">
            <text class="adm-detail-label">被举报内容</text>
            <text class="adm-detail-content">{{reportDetail.targetContent || reportDetail.targetSummary || '（内容不存在或已删除）'}}</text>
          </view>
          <view class="adm-detail-row">
            <text class="adm-detail-label">举报理由</text>
            <text class="adm-detail-content">{{reportDetail.reason || '（未填写）'}}</text>
          </view>
          <view class="adm-detail-row">
            <text class="adm-detail-label">状态</text>
            <text class="adm-status {{st.cls(reportDetail.status)}}">{{st.text(reportDetail.status)}}</text>
          </view>
          <view class="adm-detail-row">
            <text class="adm-detail-label">举报人</text>
            <text class="adm-detail-content">{{reportDetail.reporterNickname || '匿名用户'}}</text>
          </view>
          <view class="adm-detail-row">
            <text class="adm-detail-label">提交时间</text>
            <text class="adm-detail-content">{{fmt.dateTime(reportDetail.createdAt)}}</text>
          </view>
          <view class="adm-detail-row" wx:if="{{reportDetail.result}}">
            <text class="adm-detail-label">处理结果</text>
            <text class="adm-detail-content">{{reportDetail.result}}</text>
          </view>
          <view class="adm-detail-row" wx:if="{{reportDetail.resolvedAt}}">
            <text class="adm-detail-label">处理时间</text>
            <text class="adm-detail-content">{{fmt.dateTime(reportDetail.resolvedAt)}}</text>
          </view>
          <view class="adm-detail-row">
            <text class="adm-detail-label">目标 ID</text>
            <text class="adm-detail-content">{{reportDetail.targetId}}</text>
          </view>
        </scroll-view>
        <view class="adm-dialog-footer" wx:if="{{reportDetail.status === 'PENDING'}}">
          <button size="mini" data-id="{{reportDetail.id}}" data-action="approve" bindtap="resolveReportTap">成立</button>
          <button size="mini" data-id="{{reportDetail.id}}" data-action="reject" bindtap="resolveReportTap">驳回</button>
          <button size="mini" bindtap="closeReportDetail">关闭</button>
        </view>
        <view class="adm-dialog-footer" wx:else>
          <button size="mini" bindtap="closeReportDetail">关闭</button>
        </view>
      </view>
    </view>
  </block>

  <!-- 岗位（R4 管理员主动下架）-->
  <block wx:if="{{sub === 'jobs'}}">
    <view class="adm-item" wx:for="{{jobs}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title"><text wx:if="{{item.publisherScope === 'PLATFORM'}}" class="adm-platform-badge">平台发布</text>{{item.title}}</text>
        <text class="adm-item-sub">{{item.merchantShopName}} · <text class="adm-status {{st.cls(item.status)}}">{{st.jobText(item.status)}}</text>{{item.urgent ? ' · 急招' : ''}}{{item.featured ? ' · 精' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'PUBLISHED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedownJob">下架</button>
        <button wx:if="{{item.status === 'TAKEN_DOWN' && item.moderationAuthority && (isPlatformAdmin || item.moderationAuthority === 'COMMUNITY')}}" size="mini" data-id="{{item.id}}" data-version="{{item.moderationVersion}}" bindtap="restoreJobPostTap">恢复</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{jobHasMore}}" bindtap="loadMoreJobs">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    <view class="adm-empty" wx:if="{{!loading && jobs.length === 0}}">暂无岗位</view>
  </block>
</view>
