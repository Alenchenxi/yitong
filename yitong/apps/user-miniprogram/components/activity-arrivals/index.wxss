/* 活动上新弹窗：遮罩 + 居中卡 + swiper 轮播（对齐 UI设计规范 §2/§4/§6） */
.aa-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.aa-modal {
  width: 640rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  position: relative;
}

.aa-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.aa-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1d2129;
}

.aa-sub {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.aa-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  font-size: 32rpx;
  color: #86909c;
  padding: 8rpx;
}

.aa-swiper {
  height: 620rpx;
}

.aa-card {
  display: flex;
  flex-direction: column;
  background: #fffbea;
  border-radius: 16rpx;
  overflow: hidden;
  height: 560rpx;
}

.aa-cover {
  width: 100%;
  height: 280rpx;
  flex-shrink: 0;
}

.aa-info {
  padding: 20rpx 24rpx;
  flex: 1;
  min-height: 0;
}

.aa-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aa-desc {
  font-size: 24rpx;
  color: #4e5969;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.aa-time {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.aa-meta {
  font-size: 22rpx;
  color: #c59a00;
  margin-top: 8rpx;
}

.aa-actions {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 20rpx;
}

.aa-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.aa-btn-primary {
  background: #f9c801;
  color: #1d2129;
  font-weight: 600;
}

.aa-btn-ghost {
  background: #ffffff;
  border: 1rpx solid #e5e6eb;
  color: #4e5969;
}

.aa-btn-disabled {
  background: #f5f6f8;
  color: #86909c;
}

.aa-undo {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #2f80ed;
  padding: 12rpx;
}
