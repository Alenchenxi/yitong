<view class="nearby">
  <view class="presence-bar">
    <view class="presence-copy">
      <view class="presence-title">附近可见</view>
      <view class="presence-status">{{enabled ? '已开启' : '未开启'}}</view>
    </view>
    <switch color="#F9C801" checked="{{enabled}}" bindchange="onVisibilityChange" />
  </view>

  <view class="nearby-loading" wx:if="{{statusLoading || locating}}">
    {{locating ? '正在获取模糊位置...' : '正在加载...'}}
  </view>

  <view class="nearby-enable" wx:elif="{{!enabled}}">
    <view class="enable-icon">◎</view>
    <view class="enable-title">发现附近的人</view>
    <button class="enable-button" bindtap="enableFromButton">开启附近可见</button>
  </view>

  <block wx:else>
    <view class="location-error" wx:if="{{locationError}}">
      <text>{{locationError}}</text>
      <button class="retry-button" bindtap="onLocationAction">{{locationActionLabel || '重试'}}</button>
    </view>

    <view class="people-list" wx:if="{{people.length > 0}}">
      <view class="person-card" wx:for="{{people}}" wx:key="id">
        <image wx:if="{{item.avatarUrl}}" class="person-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="person-avatar person-avatar-placeholder">{{item.avatarText}}</view>
        <view class="person-main">
          <view class="person-name">{{item.nickname}}</view>
          <view class="person-distance">{{item.distanceLabel}}</view>
        </view>
        <view class="person-actions">
          <button
            class="person-button follow-button {{item.following ? 'is-following' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleFollow"
            loading="{{followLoadingId === item.id}}"
            disabled="{{followLoadingId === item.id}}"
          >{{item.following ? '已关注' : '关注'}}</button>
          <button class="person-button view-button" data-id="{{item.id}}" bindtap="openProfile">查看</button>
        </view>
      </view>
      <view class="list-tip" wx:if="{{loading}}">加载中...</view>
      <view class="list-tip" wx:elif="{{!hasMore}}">没有更多了</view>
    </view>

    <view class="nearby-empty" wx:elif="{{!loading && !locationError}}">
      <view class="empty-mark">◎</view>
      <view>附近暂时没有可见用户</view>
    </view>
  </block>
</view>
