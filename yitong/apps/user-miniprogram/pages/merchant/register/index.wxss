.page { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 8rpx; }
.last-reject { background: rgba(0,0,0,0.04); padding: 16rpx; border-radius: 12rpx; font-size: 24rpx; color: var(--yt-danger); margin-bottom: 16rpx; }
.hint { font-size: 24rpx; color: #999; margin-bottom: 24rpx; }
.form { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.row:last-child { border-bottom: none; }
.label { width: 180rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; }
.submit {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}
.submit[disabled] { background: #ffb3c1 !important; }
