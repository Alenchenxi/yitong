.page { padding: 24rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.tab { flex: 1; padding: 16rpx 0; text-align: center; font-size: 26rpx; color: var(--yt-text-sub); background: var(--yt-card); border-radius: 12rpx; }
.tab.active { background: var(--yt-primary); color: var(--yt-text-main); font-weight: 600; }
.loading { text-align: center; color: var(--yt-text-sub); padding: 80rpx 0; }
.empty { text-align: center; color: var(--yt-text-sub); padding: 80rpx 0; }

.hero { background: linear-gradient(135deg, var(--yt-primary), var(--yt-primary-dark)); border-radius: 16rpx; padding: 36rpx; text-align: center; margin-bottom: 24rpx; }
.hero-num { font-size: 64rpx; font-weight: 700; color: var(--yt-text-main); line-height: 1.2; }
.hero-label { font-size: 24rpx; color: var(--yt-text-main); margin-top: 8rpx; }

.section-title { font-size: 26rpx; color: var(--yt-text-main); font-weight: 600; margin: 24rpx 0 12rpx; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.card { background: var(--yt-card); border-radius: 12rpx; padding: 24rpx; text-align: center; }
.status-card { padding: 20rpx; }
.card-num { font-size: 40rpx; font-weight: 700; color: var(--yt-text-main); line-height: 1.3; }
.card-label { font-size: 22rpx; color: var(--yt-text-sub); margin-top: 4rpx; }

.status-pending { color: var(--yt-text-main); }
.status-accepted { color: #2BA471; }
.status-completed { color: #2BA471; }
.status-rejected { color: #E63946; }
.status-cancelled { color: var(--yt-text-sub); }