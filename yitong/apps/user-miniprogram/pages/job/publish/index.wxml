<view class="container">
  <view class="title">选择要招的职位类别</view>

  <view class="grid">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="grid-item {{item.key === selectedKey ? 'active' : ''}}"
      bindtap="onPickCategory"
      data-key="{{item.key}}"
    >
      <view class="icon">{{item.icon}}</view>
      <view class="label">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{selectedKey === 'CUSTOM'}}" class="custom-category">
    <input
      class="custom-category-input"
      value="{{customCategory}}"
      maxlength="20"
      placeholder="输入岗位类型"
      placeholder-class="placeholder"
      bindinput="onCustomCategoryInput"
      focus
    />
  </view>

  <!-- 归属圈子（职位类别和工作地点之间；新建岗位默认当前圈子，可改）；P2-75 发布后全圈同步 -->
  <view class="circle-block">
    <view class="label">发布圈子</view>
    <view class="circle-hint">岗位发布后全圈可见，所选圈子作为归属（治理与统计）</view>
    <picker range="{{communityNames}}" value="{{selectedCommunityIndex}}" bindchange="onPickCommunity">
      <view class="circle-cell" bindtap="onTapCircleField">
        <text class="{{communityLoadFailed ? 'circle-failed' : 'circle-value'}}">{{selectedCommunityName || (communityLoadFailed ? '圈子加载失败，点击重试' : '选择圈子')}}</text>
        <text class="circle-arrow">{{communityLoadFailed ? '重试' : '›'}}</text>
      </view>
    </picker>
  </view>

  <!-- P2-79 去百度地图:微信原生地图选点(wx.chooseLocation) -->
  <view wx:if="{{selectedKey}}" class="location-block">
    <view class="label">
      <text>工作地点</text>
      <text wx:if="{{location}}" class="locked-tag">已选择</text>
    </view>

    <view wx:if="{{location}}" class="chosen-card">
      <view class="chosen-icon">📍</view>
      <view class="chosen-info">
        <view class="chosen-name">{{location.name}}</view>
        <view class="chosen-address">{{location.address}}</view>
      </view>
    </view>
    <view wx:else class="hint">请选择工作地点（地图选点，支持搜索）</view>

    <button class="btn-secondary" bindtap="onChooseLocation">{{location ? '重新选点' : '地图选点'}}</button>
  </view>

  <view class="action">
    <button
      class="btn-primary {{canSubmit ? '' : 'disabled'}}"
      bindtap="onNext"
      disabled="{{!canSubmit}}"
    >下一步</button>
  </view>
</view>

<!-- P2-81 版本升级弹窗（全局组件，utils/update.ts 广播驱动） -->
<update-modal />
