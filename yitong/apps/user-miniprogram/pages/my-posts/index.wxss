.page { padding: 20rpx 24rpx 120rpx; }
.tabs-scroll { white-space: nowrap; }
.tabs {
  display: inline-flex;
  gap: 32rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 24rpx;
}
.tab { font-size: 28rpx; color: #86909C; padding: 8rpx 0; flex-shrink: 0; }
.tab.active { color: #1D2129; font-weight: 600; border-bottom: 4rpx solid var(--yt-primary, #F9C801); }

.list { display: flex; flex-direction: column; gap: 16rpx; }
.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  gap: 16rpx;
}
.item-main { flex: 1; min-width: 0; }

.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}
.badge-draft { background: #FFF7D1; color: #B45309; }
.badge-private { background: #E6E6FA; color: #5D3FD3; }

.content { font-size: 28rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; word-break: break-word; }
.meta { display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 22rpx; color: #999; }
.stats { color: #ff4d6d; }

.action {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--yt-primary, #F9C801);
  color: var(--yt-text-main, #1D2129);
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
.tip { text-align: center; color: #C9CDD4; font-size: 24rpx; padding: 16rpx 0; }
