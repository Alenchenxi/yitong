<wxs src="../../../utils/format.wxs" module="fmt" />
<view class="page">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tabs-inner">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >{{item.label}}<text wx:if="{{item.key === 'PENDING_REVIEW' && detail && detail.pendingCount}}" class="tab-badge">{{detail.pendingCount}}</text></view>
    </view>
  </scroll-view>

  <view wx:if="{{!list.length}}" class="yt-empty">暂无记录</view>

  <!-- 活动设置（仅发起人）：管理员管理与发起人转让，从发布表单迁入 -->
  <view wx:if="{{detail && detail.isInitiator}}" class="yt-card settings">
    <view class="section-title">活动设置</view>
    <view class="field">
      <view class="field-label">活动管理员</view>
      <view class="admin-chips">
        <view wx:for="{{adminList}}" wx:key="id" class="admin-chip">
          <text class="admin-chip-name">{{item.nickname}}</text>
          <text class="admin-chip-x" catchtap="removeAdminChip" data-id="{{item.id}}">✕</text>
        </view>
      </view>
      <view class="user-search-row">
        <input class="field-input user-search-input" value="{{adminKw}}" bindinput="onAdminKwInput" confirm-type="search" bindconfirm="searchAdmins" placeholder="搜索用户昵称添加" />
        <view class="user-search-btn" bindtap="searchAdmins">搜索</view>
      </view>
      <view class="user-result-list">
        <view wx:for="{{adminResults}}" wx:key="id" class="user-result" bindtap="pickAdmin" data-index="{{index}}">
          <image wx:if="{{item.avatarUrl}}" class="user-result-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="user-result-avatar user-result-avatar-ph"></view>
          <text class="user-result-name">{{item.nickname}}</text>
          <text class="user-result-add">添加</text>
        </view>
      </view>
      <view class="ff-add-btn" bindtap="saveAdmins">保存管理员</view>
    </view>
    <view class="field">
      <view class="field-label">转让发起人</view>
      <view wx:if="{{transferTarget}}" class="transfer-target">已选择：{{transferTarget.nickname}}<text class="admin-chip-x" catchtap="clearTransferTarget">✕</text></view>
      <view class="user-search-row">
        <input class="field-input user-search-input" value="{{transferKw}}" bindinput="onTransferKwInput" confirm-type="search" bindconfirm="searchTransfer" placeholder="搜索用户昵称选择" />
        <view class="user-search-btn" bindtap="searchTransfer">搜索</view>
      </view>
      <view class="user-result-list">
        <view wx:for="{{transferResults}}" wx:key="id" class="user-result" bindtap="pickTransferTarget" data-index="{{index}}">
          <image wx:if="{{item.avatarUrl}}" class="user-result-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="user-result-avatar user-result-avatar-ph"></view>
          <text class="user-result-name">{{item.nickname}}</text>
          <text class="user-result-add">选择</text>
        </view>
      </view>
      <view class="ff-add-btn ff-danger" bindtap="doTransfer">转让</view>
    </view>
  </view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="yt-card item">
      <view class="item-head">
        <image class="item-avatar" src="{{item.avatarUrl || '/assets/tabbar/activity.png'}}" mode="aspectFill" />
        <view class="item-info">
          <view class="item-name">{{item.nickname}}</view>
          <view class="item-sub">提交于 {{fmt.dateTime(item.createdAt)}}</view>
          <view wx:if="{{item.waitlistedAt}}" class="item-sub">候补进入时间 {{fmt.dateTime(item.waitlistedAt)}}</view>
        </view>
      </view>
      <view class="item-actions">
        <view class="op" data-id="{{item.id}}" data-pending="{{false}}" bindtap="viewData">查看资料</view>
        <block wx:if="{{activeTab === 'PENDING_REVIEW' || activeTab === 'RE_REVIEW'}}">
          <view class="op op-primary" data-id="{{item.id}}" bindtap="onApprove">通过</view>
          <view class="op op-danger" data-id="{{item.id}}" bindtap="openReject">拒绝</view>
        </block>
        <view
          wx:if="{{activeTab === 'APPROVED'}}"
          class="op op-primary"
          data-id="{{item.id}}"
          data-uid="{{item.userId}}"
          data-name="{{item.nickname}}"
          bindtap="onRemindOne"
        >提醒</view>
        <view
          wx:if="{{activeTab === 'APPROVED' || activeTab === 'WAITLIST'}}"
          class="op op-danger"
          data-id="{{item.id}}"
          bindtap="openRevoke"
        >取消资格</view>
      </view>
    </view>
  </view>

  <view wx:if="{{viewing}}" class="mask" bindtap="closeView">
    <view class="sheet" catchtap="">
      <view class="sheet-title">{{viewing.nickname}} 的报名资料</view>
      <view class="kv" wx:for="{{viewingEntries}}" wx:key="label">
        <text class="kv-k">{{item.label}}</text>
        <text class="kv-v">{{item.value}}</text>
      </view>
      <view wx:if="{{viewingPendingEntries.length}}" class="sheet-warn">—— 待复审新资料 ——</view>
      <view class="kv" wx:for="{{viewingPendingEntries}}" wx:key="label">
        <text class="kv-k">{{item.label}}</text>
        <text class="kv-v">{{item.value}}</text>
      </view>
      <view class="sheet-close" bindtap="closeView">关闭</view>
    </view>
  </view>

  <view wx:if="{{rejectId}}" class="mask" bindtap="closeReject">
    <view class="sheet" catchtap="">
      <view class="sheet-title">拒绝报名</view>
      <textarea class="sheet-input" value="{{rejectReason}}" bindinput="onRejectInput" placeholder="拒绝原因（将通知用户，选填）" maxlength="200" />
      <view class="sheet-btns">
        <view class="sheet-btn" bindtap="closeReject">取消</view>
        <view class="sheet-btn sheet-btn-primary" bindtap="doReject">确认拒绝</view>
      </view>
    </view>
  </view>

  <view wx:if="{{revokeId}}" class="mask" bindtap="closeRevoke">
    <view class="sheet" catchtap="">
      <view class="sheet-title">取消参与资格</view>
      <textarea class="sheet-input" value="{{revokeReason}}" bindinput="onRevokeInput" placeholder="取消原因（必填，将通知用户）" maxlength="200" />
      <view class="sheet-btns">
        <view class="sheet-btn" bindtap="closeRevoke">取消</view>
        <view class="sheet-btn sheet-btn-danger" bindtap="doRevoke">确认取消</view>
      </view>
    </view>
  </view>
</view>
