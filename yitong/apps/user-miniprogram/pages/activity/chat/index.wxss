/* 活动群聊：消息流 + 底部输入条（HTTP 轮询） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.readonly-tip {
  background: #fff7d1;
  color: #c59a00;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx;
}

.msgs {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.msg.mine {
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f6f8;
  flex-shrink: 0;
}

.bubble-wrap {
  max-width: 70%;
}

.nick {
  font-size: 22rpx;
  color: #86909c;
  margin-bottom: 6rpx;
}

.bubble {
  background: #ffffff;
  border-radius: 4rpx 16rpx 16rpx 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1d2129;
  word-break: break-all;
}

.mine .bubble {
  background: #f9c801;
  border-radius: 16rpx 4rpx 16rpx 16rpx;
}

.input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e5e6eb;
}

.chat-input {
  flex: 1;
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #f9c801;
  color: #1d2129;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
}

.send-disabled {
  opacity: 0.5;
}
