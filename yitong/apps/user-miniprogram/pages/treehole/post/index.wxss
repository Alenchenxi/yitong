.page { padding: 24rpx; padding-bottom: 80rpx; }
.composer {
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 0;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}
.image-item,
.add-image {
  position: relative;
  width: 100%;
  min-width: 0;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.selected-image {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--yt-disabled-bg);
}
.remove-image {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--yt-mask);
  color: var(--yt-card);
  font-size: 32rpx;
  line-height: 1;
}
.add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--yt-text-weak);
  background: var(--yt-bg);
  color: var(--yt-text-sub);
}
.add-image-pressed { background: var(--yt-disabled-bg); }
.add-image-icon { font-size: 52rpx; font-weight: 300; line-height: 1; }
.composer-count {
  margin-top: 18rpx;
  color: var(--yt-text-sub);
  font-size: 22rpx;
  line-height: 1;
  text-align: right;
}

.mood-section { margin-top: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.mood-label { font-size: 28rpx; font-weight: 600; color: #1D2129; margin-bottom: 20rpx; }
.mood-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mood-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 24rpx;
}
.mood-chip.on {
  background: #FFF7D1;
  color: #1D2129;
  font-weight: 500;
}

.submit {
  min-height: 88rpx;
  margin-top: 40rpx;
  background: #F9C801 !important;
  color: #1D2129 !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
}
.submit[disabled] { background: #FFF7D1 !important; color: #C9CDD4 !important; }
