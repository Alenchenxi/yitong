.page { padding: 24rpx; padding-bottom: 80rpx; }
.composer {
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.textarea {
  width: 100%;
  min-height: 320rpx;
  padding: 0;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}
.image-item,
.add-image {
  position: relative;
  width: 100%;
  min-width: 0;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 12rpx;
  box-sizing: border-box;
}
.selected-image {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--yt-disabled-bg);
}
.remove-image {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--yt-mask);
  color: var(--yt-card);
  font-size: 32rpx;
  line-height: 1;
}
.add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--yt-text-weak);
  background: var(--yt-bg);
  color: var(--yt-text-sub);
}
.add-image-pressed { background: var(--yt-disabled-bg); }
.add-image-icon { font-size: 52rpx; font-weight: 300; line-height: 1; }
.add-image-tip { margin-top: 6rpx; font-size: 22rpx; line-height: 1; }

/* P2-83 视频盒（与图片互斥，长按呼出删除） */
.video-box {
  position: relative;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #000;
}
.video { display: block; width: 100%; height: 400rpx; }
.video-del { top: 12rpx; right: 12rpx; }
.composer-count {
  margin-top: 18rpx;
  color: var(--yt-text-sub);
  font-size: 22rpx;
  line-height: 1;
  text-align: right;
}

.mood-section { margin-top: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
/* CR-006 发布地：与 mood-section 同卡片体系，一行式入口/已选态 */
.location-section { margin-top: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.location-entry { display: flex; align-items: center; gap: 8rpx; }
.location-entry.chosen { padding-right: 8rpx; }
.location-icon { font-size: 26rpx; }
.location-text { font-size: 26rpx; color: #4E5969; }
.location-text.loc-chosen { color: #1D2129; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.location-clear {
  margin-left: auto;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  border-radius: 50%; background: #F2F3F5; color: #86909C; font-size: 28rpx;
}
.mood-label { font-size: 28rpx; font-weight: 600; color: #1D2129; margin-bottom: 20rpx; }
.mood-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mood-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 24rpx;
}
.mood-chip.on {
  background: #FFF7D1;
  color: #1D2129;
  font-weight: 500;
}

/* CR-007 可见性：公开/私密（样式对齐表白墙 post-create visibility-row） */
.visibility-section { margin-top: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; }
.visibility-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.visibility-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 26rpx;
}
.visibility-btn.on {
  background: #F9C801;
  color: #1D2129;
  font-weight: 600;
}
.visibility-tip { margin-top: 16rpx; font-size: 22rpx; color: #86909C; line-height: 1.5; }

.submit {
  min-height: 88rpx;
  margin-top: 40rpx;
  background: #F9C801 !important;
  color: #1D2129 !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
}
.submit[disabled] { background: #FFF7D1 !important; color: #C9CDD4 !important; }
