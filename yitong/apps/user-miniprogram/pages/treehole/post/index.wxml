<view class="page">
  <view class="composer">
    <textarea class="textarea" placeholder="匿名说点什么…（不会暴露你的身份）" value="{{content}}" bindinput="onInput" maxlength="500" auto-height show-confirm-bar="{{false}}" />
    <!-- P2-83 媒体区：图片/视频互斥，朋友圈式九宫格（长按媒体呼出右上角删除，删除后自动重排） -->
    <view class="image-grid" wx:if="{{!video}}">
      <view class="image-item" wx:for="{{imagePaths}}" wx:key="*this" bindlongpress="toggleDelete">
        <image class="selected-image" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
        <view class="remove-image" wx:if="{{showDelete}}" data-index="{{index}}" catchtap="removeImage" aria-role="button" aria-label="删除图片">×</view>
      </view>
      <view
        wx:if="{{imagePaths.length < maxImageCount}}"
        class="add-image"
        bindtap="chooseImages"
        aria-role="button"
        aria-label="添加图片"
        hover-class="add-image-pressed"
      >
        <text class="add-image-icon">＋</text>
      </view>
      <view
        wx:if="{{imagePaths.length === 0}}"
        class="add-image"
        bindtap="chooseVideo"
        aria-role="button"
        aria-label="添加视频"
        hover-class="add-image-pressed"
      >
        <text class="add-image-icon">▶</text>
        <text class="add-image-tip">视频</text>
      </view>
    </view>
    <view class="video-box" wx:if="{{video}}" bindlongpress="toggleDelete">
      <video class="video" src="{{video.localPath}}" poster="{{video.coverLocalPath}}" object-fit="cover" controls></video>
      <view class="remove-image video-del" wx:if="{{showDelete}}" catchtap="removeVideo" aria-role="button" aria-label="删除视频">×</view>
    </view>
    <view class="composer-count">{{content.length}}/500</view>
  </view>
  <view class="mood-section">
    <view class="mood-label">心情（可选）</view>
    <view class="mood-chips">
      <view class="mood-chip {{selectedMood === item ? 'on' : ''}}" wx:for="{{moods}}" wx:key="*this" data-mood="{{item}}" bindtap="pickMood">{{item}}</view>
    </view>
  </view>
  <button class="submit" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? '发布中…' : '匿名发布'}}</button>
</view>

<!-- P2-81 版本升级弹窗（全局组件，utils/update.ts 广播驱动） -->
<update-modal />
