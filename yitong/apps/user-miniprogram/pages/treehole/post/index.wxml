<view class="page">
  <view class="composer">
    <textarea class="textarea" placeholder="匿名说点什么…（不会暴露你的身份）" value="{{content}}" bindinput="onInput" maxlength="500" auto-height show-confirm-bar="{{false}}" />
    <!-- P2-83 媒体区：图片/视频互斥，朋友圈式九宫格（长按媒体呼出右上角删除，删除后自动重排） -->
    <view class="image-grid" wx:if="{{!video && !keptVideoUrl}}">
      <view class="image-item" wx:for="{{imagePaths}}" wx:key="*this" bindlongpress="toggleDelete">
        <image class="selected-image" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage" />
        <view class="remove-image" wx:if="{{showDelete}}" data-index="{{index}}" catchtap="removeImage" aria-role="button" aria-label="删除图片">×</view>
      </view>
      <view
        wx:if="{{imagePaths.length < maxImageCount}}"
        class="add-image"
        bindtap="chooseImages"
        aria-role="button"
        aria-label="添加图片"
        hover-class="add-image-pressed"
      >
        <text class="add-image-icon">＋</text>
      </view>
      <view
        wx:if="{{imagePaths.length === 0}}"
        class="add-image"
        bindtap="chooseVideo"
        aria-role="button"
        aria-label="添加视频"
        hover-class="add-image-pressed"
      >
        <text class="add-image-icon">▶</text>
        <text class="add-image-tip">视频</text>
      </view>
    </view>
    <view class="video-box" wx:if="{{video || keptVideoUrl}}" bindlongpress="toggleDelete">
      <video class="video" src="{{video ? video.localPath : keptVideoUrl}}" poster="{{video ? video.coverLocalPath : keptVideoCover}}" object-fit="cover" controls></video>
      <view class="remove-image video-del" wx:if="{{showDelete}}" catchtap="removeVideo" aria-role="button" aria-label="删除视频">×</view>
    </view>
    <view class="composer-count">{{content.length}}/500</view>
  </view>
  <!-- CR-006 发布地：地图选点，可选不强制；选中显示地点名，× 清除 -->
  <view class="location-section">
    <view class="location-entry" bindtap="pickLocation" wx:if="{{!chosenLocation}}" aria-role="button" aria-label="添加所在位置">
      <text class="location-icon">📍</text>
      <text class="location-text">所在位置</text>
    </view>
    <view class="location-entry chosen" wx:else>
      <text class="location-icon">📍</text>
      <text class="location-text loc-chosen">{{chosenLocation.name}}</text>
      <text class="location-clear" catchtap="clearLocation" aria-role="button" aria-label="清除位置">×</text>
    </view>
  </view>
  <view class="mood-section">
    <view class="mood-label">心情（可选）</view>
    <view class="mood-chips">
      <view class="mood-chip {{selectedMood === item ? 'on' : ''}}" wx:for="{{moods}}" wx:key="*this" data-mood="{{item}}" bindtap="pickMood">{{item}}</view>
    </view>
  </view>
  <!-- CR-007 可见性：公开 / 私密（私密仅作者可见，跳公开流；匿名开关关闭时整页不可达，私密选项天然隐藏） -->
  <view class="visibility-section">
    <view class="mood-label">发布到</view>
    <view class="visibility-row">
      <text class="visibility-btn {{visibility === 'PUBLIC' ? 'on' : ''}}" data-visibility="PUBLIC" catchtap="setVisibility">公开</text>
      <text class="visibility-btn {{visibility === 'PRIVATE' ? 'on' : ''}}" data-visibility="PRIVATE" catchtap="setVisibility">仅自己可见（私密）</text>
    </view>
    <view class="visibility-tip">{{visibility === 'PUBLIC' ? '所有人可见，进入树洞广场/推荐' : '仅自己可见，不会出现在树洞广场/推荐/搜索'}}</view>
  </view>
  <button class="submit" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">{{submitting ? (editId ? '保存中…' : '发布中…') : (editId ? '保存' : '匿名发布')}}</button>
</view>

<!-- P2-81 版本升级弹窗（全局组件，utils/update.ts 广播驱动） -->
<update-modal />
