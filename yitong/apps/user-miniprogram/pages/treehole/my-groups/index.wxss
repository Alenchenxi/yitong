.page { padding: 24rpx; }
.group-item { display: flex; gap: 16rpx; padding: 20rpx; background: var(--yt-card); border-radius: 16rpx; margin-bottom: 16rpx; border: 1rpx solid var(--yt-border); }
.group-avatar { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: var(--yt-primary-lighter); display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; color: var(--yt-primary-dark); flex-shrink: 0; }
.group-info { flex: 1; min-width: 0; }
.group-name { display: flex; align-items: center; gap: 10rpx; font-size: 30rpx; font-weight: 600; color: var(--yt-text-main); }
.group-private { font-size: 22rpx; }
.group-desc { font-size: 24rpx; color: var(--yt-text-sub); margin-top: 6rpx; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 1; overflow: hidden; }
.group-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; flex-wrap: wrap; }
.group-count { font-size: 22rpx; color: var(--yt-text-sub); }
.group-tag { font-size: 20rpx; color: var(--yt-primary-dark); background: var(--yt-primary-lighter); padding: 2rpx 12rpx; border-radius: 999rpx; }
.yt-empty { text-align: center; padding-top: 200rpx; }
.yt-empty-emoji { font-size: 80rpx; }
.yt-empty-text { font-size: 26rpx; color: var(--yt-text-sub); margin-top: 16rpx; }
