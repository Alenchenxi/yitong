.page { padding: 24rpx; padding-bottom: 120rpx; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item { background: #fff; border-radius: 12rpx; padding: 24rpx; }
.content { font-size: 28rpx; color: #333; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.post-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 16rpx;
}
.post-images-1 { grid-template-columns: 1fr; width: 66%; }
.post-images-2 { grid-template-columns: repeat(2, 1fr); }
/* P2-83 视频帖 */
.post-video { width: 100%; height: 360rpx; margin-top: 16rpx; border-radius: 8rpx; background: #000; }
.post-image {
  display: block;
  width: 100%;
  height: 190rpx;
  min-width: 0;
  border-radius: 8rpx;
  background: var(--yt-disabled-bg);
}
.post-images-1 .post-image { height: 300rpx; }
.meta { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; font-size: 22rpx; color: #999; }
.stats { color: #C59A00; }
/* CR-007 本人编辑/删除入口 + 私密徽标 */
.item-actions { display: flex; align-items: center; gap: 20rpx; }
.action { color: #4E5969; }
.action.danger { color: #E63946; }
.private-badge {
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: #86909C;
  background: #F2F3F5;
  border-radius: 999rpx;
}
.edited-tip { font-size: 20rpx; color: #bbb; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
