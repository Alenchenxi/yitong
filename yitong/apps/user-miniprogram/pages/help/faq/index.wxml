<view class="page">
  <view class="faq-item" wx:for="{{items}}" wx:key="id">
    <view class="faq-q">Q{{index + 1}}：{{item.q}}</view>
    <view class="faq-a">{{item.a}}</view>
  </view>
  <view class="empty" wx:if="{{items.length === 0}}">暂无内容</view>
</view>

