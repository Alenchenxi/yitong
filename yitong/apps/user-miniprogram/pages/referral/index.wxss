.page { padding: 24rpx; padding-bottom: 120rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 32rpx; margin-bottom: 24rpx; }
.code-card { text-align: center; }
.label { font-size: 26rpx; color: #999; }
.code { font-size: 64rpx; font-weight: 700; color: #ff4d6d; letter-spacing: 8rpx; margin: 16rpx 0; }
.hint { font-size: 22rpx; color: #bbb; margin-bottom: 24rpx; }
.copy-btn { background: #ff4d6d !important; color: #fff !important; font-size: 28rpx; border-radius: 40rpx; margin-bottom: 16rpx; }
.share-btn { background: #fff !important; color: #ff4d6d !important; font-size: 28rpx; border-radius: 40rpx; border: 1rpx solid #ff4d6d; }
.stats-card { text-align: center; }
.stats-num { font-size: 56rpx; font-weight: 700; color: #ff4d6d; }
.stats-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.list-card { padding: 24rpx 32rpx; }
.list-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.record { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-top: 1rpx solid #f5f5f5; }
.r-avatar { flex-shrink: 0; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.avatar-ph { background: linear-gradient(135deg, #ff6b8a, #ff4d6d); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.r-main { flex: 1; min-width: 0; }
.r-nick { font-size: 28rpx; color: #333; }
.r-time { font-size: 22rpx; color: #bbb; margin-top: 4rpx; }
.empty { text-align: center; padding-top: 120rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }