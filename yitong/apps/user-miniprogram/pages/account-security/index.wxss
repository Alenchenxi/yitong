.page { padding: 24rpx; padding-bottom: 120rpx; }
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #333; }
.label.danger { color: #ff4d6d; }
.input { flex: 1; text-align: right; font-size: 28rpx; margin-left: 24rpx; }
.value { font-size: 28rpx; color: #666; }
.arrow { color: #ccc; font-size: 32rpx; }
.save-btn { margin-top: 24rpx; background: #ff4d6d !important; color: #fff !important; font-size: 28rpx; border-radius: 40rpx; }
.cancel-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; flex-direction: column; justify-content: flex-end; }
.cancel-notice { background: #fff; padding: 32rpx; margin: 0 24rpx; border-radius: 12rpx 12rpx 0 0; }
.notice-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.notice-body { font-size: 26rpx; color: #666; line-height: 1.6; white-space: pre-wrap; }
.cancel-actions { background: #fff; padding: 16rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); display: flex; gap: 16rpx; }
.cancel-btn { flex: 1; background: #ff4d6d !important; color: #fff !important; font-size: 28rpx; border-radius: 40rpx; }
.cancel-btn.secondary { background: #f5f5f5 !important; color: #666 !important; }
