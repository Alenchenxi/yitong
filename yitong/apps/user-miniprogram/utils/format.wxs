// 通用展示格式化：后端 ISO 时间戳（含 T）→ 年月日 时分秒（getDate 解析后按设备本地时区显示）；非 ISO 字符串原样返回，不误伤已格式化字段
var pad = function (n) {
  return n < 10 ? '0' + n : '' + n;
};

var dateTime = function (s) {
  if (!s) return '';
  if (s.indexOf('T') < 0) return s;
  var d = getDate(s);
  return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
};

module.exports = {
  dateTime: dateTime,
};
