# 生产环境变量模板 —— 复制为 .env.production 并填入实际值
# （.env.production 已 gitignore，勿提交真实凭证）
# 供 docker-compose.prod.yml 使用：
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# 说明：--env-file 负责 ${VAR} 插值（DB_PASSWORD/DOMAIN/MINIO 密钥）；server.env_file 注入业务变量。
# DATABASE_URL / REDIS_URL / CHAT_WS_URL / NODE_ENV / PORT 由 compose 的 environment 注入，本文件无需填。

# === 运行模式（🔴 生产必须 prod：dev 会跳过角色登录权限校验=后台裸奔）===
MODE=prod
NODE_ENV=production
# 域名（供 compose 拼接 CHAT_WS_URL；TLS 证书也绑定此域名）
DOMAIN=yourdomain.com

# === 数据库密码（供 compose 拼接 DATABASE_URL；postgres 容器同密码）===
DB_PASSWORD=<强随机密码>

# === 鉴权 ===
JWT_SECRET=<64位强随机>
ADMIN_API_KEY=<强随机>
# 管理员微信 openid（预设绑定；填真实 openid 后选「管理员」角色登录才放行）
ADMIN_OPENID=

# === 微信小程序 ===
WX_USER_APPID=wx6a5034bb04012e76
WX_USER_SECRET=

# === 微信支付 V3（缺失则 prod 抛 90003 阻断付费发布；6 项凭证齐全才走真实下单/退款）===
WX_PAY_MCH_ID=
# APIv3 密钥（32 位）
WX_PAY_API_V3_KEY=
# 商户 API 私钥（apiclient_key.pem 内容，\n 转义；也可用 WX_PAY_PRIVATE_KEY_PATH）
WX_PAY_PRIVATE_KEY=
# 商户证书序列号
WX_PAY_MCH_SERIAL_NO=
# 微信支付平台公钥（回调验签）
WX_PAY_PLATFORM_PUBLIC_KEY=
# 支付/退款回调（公网 https）
WX_PAY_NOTIFY_URL=https://yourdomain.com/api/v1/payments/notify
WX_PAY_REFUND_NOTIFY_URL=https://yourdomain.com/api/v1/payments/refund-notify

# === 微信订阅消息（未配置仅记录日志跳过，站内消息不受影响）===
WX_SUBSCRIBE_JOB_APPLY_TEMPLATE_ID=
WX_SUBSCRIBE_JOB_STATUS_TEMPLATE_ID=

# === 家教平台同步（仅部署秘密；容量在管理端“运营 -> 设置”中配置）===
TUTOR_SYNC_ENABLED=false
TUTOR_SYNC_URL=
TUTOR_SYNC_TOKEN=

# === 聊天 WS（客户端连接地址由 compose 注入 wss://${DOMAIN}/ws；此处仅端口）===
CHAT_WS_PORT=3001

# === 对象存储 MinIO（host 网络：minio 监听 127.0.0.1:9000；公网经 nginx /files 代理访问）===
# host 网络下 docker DNS 不工作，不能用服务名 minio，必须 127.0.0.1
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<强随机>
MINIO_SECRET_KEY=<强随机>
MINIO_BUCKET=yitong
MINIO_USE_SSL=false
# 公网访问基址（图片/视频 URL 前缀；nginx /files/ 反代到 127.0.0.1:9000）
MINIO_PUBLIC_URL=https://yourdomain.com/files

# === 试用授权锁（phone-home；留空 = 授权功能关闭、不阻断；填齐 3 项才启用）===
# 授权服务器（Cloudflare Worker）部署见 infra/license-server/README.md
LICENSE_SERVER_URL=
LICENSE_ID=
# /check 共享密钥（与授权服务器 wrangler secret LICENSE_API_KEY 一致）
LICENSE_API_KEY=
LICENSE_TRIAL_DAYS=10
# 断网容忍窗口（小时）：授权服务器连不上时，超此窗口则锁定（建议 2-6）
LICENSE_TOLERANCE_HOURS=2
# 完整性检测：部署时对 dist/license/*.js 算一次 SHA256，填这里；运行时若不一致立即 fail-closed
# 计算方式：cd apps/server && node -e "const {createHash}=require('crypto'),{readdirSync,readFileSync}=require('fs'),{join}=require('path');const d='dist/license';const h=createHash('sha256');for(const n of readdirSync(d).filter(f=>f.endsWith('.js')&&!f.endsWith('.js.map')).sort()){const c=readFileSync(join(d,n));h.update(n);h.update(String(c.length));h.update(c);}console.log(h.digest('hex'));"
LICENSE_BOOT_HASH=
# 关闭本地完整性比对（仅用于测试；生产请保持默认）
# LICENSE_LOCAL_CHECK_ENABLED=true
