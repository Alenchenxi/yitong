generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 身份 =====
model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  unionid   String?
  nickname  String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  postLikes PostLike[]
  posts     Post[]
  comments  Comment[]
  userRoles UserRole[]
  applications JobApplication[]
  favorites Favorite[]
  referralCode ReferralCode?
  referralsGiven ReferralRecord[] @relation("ReferrerRel")
  referralGot    ReferralRecord? @relation("RefereeRel")
  @@map("users")
}
enum Role {
  USER
  MERCHANT
  ADMIN
}

// 用户拥有的角色集合（多角色并存）；当前角色由 token 携带，不在此表
model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      Role     @map("role")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, role])
  @@map("user_roles")
}

model AnonymousProfile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  anonId    String   @unique @map("anon_id")
  nickname  String
  createdAt DateTime @default(now()) @map("created_at")
  @@map("anonymous_profiles")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String?  @map("password_hash")
  openid       String?  @unique @map("openid")
  createdAt    DateTime @default(now()) @map("created_at")
  @@map("admin_users")
}

// ===== 表白墙 =====
model Circle {
  id    String @id @default(cuid())
  name  String
  icon  String?
  posts Post[]
  @@map("circles")
}
model Post {
  id        String     @id @default(cuid())
  circleId  String     @map("circle_id")
  authorId  String     @map("author_id")
  content   String
  images    String[]
  likeCount Int        @default(0) @map("like_count")
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  circle    Circle     @relation(fields: [circleId], references: [id])
  author    User       @relation(fields: [authorId], references: [id])
  postLikes PostLike[]
  comments  Comment[]
  @@index([circleId, createdAt])
  @@map("posts")
}
enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
  @@map("comments")
}

// 帖子点赞（postId+userId 唯一，支持去重 / 取消）
model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([postId, userId])
  @@map("post_likes")
}

// ===== 树洞（匿名）=====
model AnonymousPost {
  id        String     @id @default(cuid())
  anonId    String     @map("anon_id")
  content   String
  images    String[]
  status    PostStatus @default(PENDING)
  createdAt DateTime   @default(now()) @map("created_at")
  likeCount Int        @default(0) @map("like_count")
  likes    AnonPostLike[]
  @@index([createdAt])
  @@map("anonymous_posts")
}

// 树洞匿名帖点赞（postId+anonId 唯一，支持去重/取消）
model AnonPostLike {
  id        String         @id @default(cuid())
  postId    String         @map("post_id")
  anonId    String         @map("anon_id")
  createdAt DateTime       @default(now()) @map("created_at")
  post      AnonymousPost  @relation(fields: [postId], references: [id])
  @@unique([postId, anonId])
  @@map("anon_post_likes")
}
model ChatMatch {
  id        String      @id @default(cuid())
  anonIdA   String      @map("anon_id_a")
  anonIdB   String      @map("anon_id_b")
  status    MatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  @@map("chat_matches")
}
enum MatchStatus {
  ACTIVE
  CLOSED
}

// ===== 聊天（1v1，通用）=====
// fromId/toId 为标识符：实名场景用 uid，树洞匿名场景用 anonId（不存 uid，匿名隔离）
model ChatMessage {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([fromId, toId, createdAt])
  @@index([toId, createdAt])
  @@map("chat_messages")
}

// 会话列表（每用户每对端一行；ownerId/peerId 同 ChatMessage 标识约定）
model ChatSession {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  peerId      String   @map("peer_id")
  lastMessage String   @map("last_message")
  lastAt      DateTime @default(now()) @map("last_at")
  @@unique([ownerId, peerId])
  @@index([ownerId, lastAt])
  @@map("chat_sessions")
}

// ===== 通知 =====
model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // job_apply / job_accept / job_complete / post_takedown
  title       String
  content     String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([userId, read, createdAt])
  @@map("notifications")
}

// ===== 公告 =====
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("announcements")
}

// ===== 收藏（跨内容类型：表白墙帖 post / 树洞帖 anon_post / 兼职岗位 job_post）=====
model Favorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") // 'post' | 'anon_post' | 'job_post'
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])
  @@unique([userId, targetType, targetId])
  @@index([userId, targetType, createdAt])
  @@map("favorites")
}

// ===== 分享拉新 =====
// 每个用户唯一邀请码；记录谁邀请了谁（每个被邀请人只能被记录一次）
model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  @@map("referral_codes")
}

model ReferralRecord {
  id           String   @id @default(cuid())
  referrerId   String   @map("referrer_id")
  refereeId    String   @unique @map("referee_id")
  referralCode String   @map("referral_code")
  createdAt    DateTime @default(now()) @map("created_at")
  referrer     User     @relation("ReferrerRel", fields: [referrerId], references: [id])
  referee      User     @relation("RefereeRel", fields: [refereeId], references: [id])
  @@index([referrerId, createdAt])
  @@map("referral_records")
}

// ===== 兼职 =====
model Merchant {
  id           String         @id @default(cuid())
  userId       String         @unique @map("user_id")
  shopName     String         @map("shop_name")
  licenseNo    String         @map("license_no")
  contactPhone String         @map("contact_phone")
  status       MerchantStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  jobPosts     JobPost[]
  @@map("merchants")
}
enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobPost {
  id           String        @id @default(cuid())
  merchantId   String        @map("merchant_id")
  title        String
  description  String
  salary       String
  location     String
  duration     JobDuration
  expireAt     DateTime      @map("expire_at")
  status       JobPostStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  applications JobApplication[]
  @@index([status, expireAt])
  @@map("job_posts")
}
enum JobDuration {
  D30
  D90
}
enum JobPostStatus {
  PENDING
  PUBLISHED
  TAKEN_DOWN
  EXPIRED
}

model JobApplication {
  id        String    @id @default(cuid())
  jobPostId String    @map("job_post_id")
  userId    String    @map("user_id")
  status    AppStatus @default(PENDING)
  createdAt DateTime  @default(now()) @map("created_at")
  jobPost   JobPost   @relation(fields: [jobPostId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  review    JobReview?
  @@unique([jobPostId, userId])
  @@map("job_applications")
}
enum AppStatus {
  PENDING
  ACCEPTED
  DONE
  CANCELLED
}

model JobReview {
  id            String         @id @default(cuid())
  applicationId String         @unique @map("application_id")
  rating        Int
  content       String
  createdAt     DateTime       @default(now()) @map("created_at")
  application   JobApplication @relation(fields: [applicationId], references: [id])
  @@map("job_reviews")
}

// ===== 支付（付费发布）=====
model PricingConfig {
  id        String      @id @default(cuid())
  duration  JobDuration
  price     Decimal     @db.Decimal(10, 2)
  updatedAt DateTime    @updatedAt @map("updated_at")
  @@unique([duration])
  @@map("pricing_config")
}
model PaymentOrder {
  id         String    @id @default(cuid())
  merchantId String    @map("merchant_id")
  jobPostId  String    @map("job_post_id")
  duration   JobDuration
  amount     Decimal   @db.Decimal(10, 2)
  wxPrepayId String?   @map("wx_prepay_id")
  status     PayStatus @default(PENDING)
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  @@map("payment_orders")
}
enum PayStatus {
  PENDING
  PAID
  REFUNDED
  CLOSED
}

// ===== 内容审核 =====
model ModerationRecord {
  id         String            @id @default(cuid())
  targetType String            @map("target_type")
  targetId   String            @map("target_id")
  reason     String?
  status     ModerationStatus  @default(PENDING)
  reviewerId String?           @map("reviewer_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  @@map("moderation_records")
}
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
