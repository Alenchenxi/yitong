# 复制为 .env 并填入实际值（.env 已 gitignore，勿提交真实凭证）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yitong?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
# 运行模式：dev 跳过角色登录权限校验（admin/merchant 直接放行，方便本地点角色即进）；prod 保留校验
# 🔴 生产部署必须 MODE=prod（见根目录 .env.production.example），否则角色权限校验被跳过=后台裸奔
MODE=dev
JWT_SECRET=change-me-in-prod
ADMIN_API_KEY=dev-admin-key

# 微信小程序
WX_USER_APPID=
WX_USER_SECRET=

# 微信支付 V3（M0-03 / M6：金额一律由服务端按 PricingConfig 计算，不信前端传入金额）
# V3 鉴权：商户 API 私钥 RSA-SHA256 签请求；微信支付平台公钥验回调；APIv3 密钥 AES-256-GCM 解密回调。
# JSAPI 下单 appid 复用 WX_USER_APPID（须与商户号绑定同一主体）；商家 openid 取自 User.openid。
# mock/prod 策略（见 wx-pay.service.ts isReady）：6 项凭证齐全 -> 真实 V3 下单/退款 + 回调验签解密；
# 缺失 -> dev 走 mock（自动支付成功），prod 抛 90003 阻断。
WX_PAY_MCH_ID=
# APIv3 密钥（32 位，商户平台「API安全」->「APIv3 密钥」设置；支付/退款回调 AES-256-GCM 解密用）
WX_PAY_API_V3_KEY=
# 商户 API 私钥（apiclient_key.pem 内容；多行用 \n 转义；也可放文件用 WX_PAY_PRIVATE_KEY_PATH）
WX_PAY_PRIVATE_KEY=
# WX_PAY_PRIVATE_KEY_PATH=
# 商户证书序列号（请求头 Wechatpay-Serial；商户平台「API安全」可查）
WX_PAY_MCH_SERIAL_NO=
# 微信支付平台公钥（回调验签；同样支持 _PATH）
WX_PAY_PLATFORM_PUBLIC_KEY=
# WX_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 支付回调，落点 POST /api/v1/payments/notify（公网 https；V3 回调为 JSON 加密报文）
WX_PAY_NOTIFY_URL=
# 退款回调，落点 POST /api/v1/payments/refund-notify（V3 退款接口同套 RSA 签名，无需 apiclient_cert.p12）
WX_PAY_REFUND_NOTIFY_URL=

# 微信订阅消息模板（M0-03 / M4：模板 ID 从微信公众平台订阅消息后台申请后填入）
# 未配置时仅记录日志跳过发送，站内消息不受影响（降级策略见 wx-subscribe-message.service.ts，M4-05）
# 新报名提醒（job_apply）
WX_SUBSCRIBE_JOB_APPLY_TEMPLATE_ID=
# 报名状态提醒（job_accept 录用 / job_reject 未录用 / job_complete 完成）
WX_SUBSCRIBE_JOB_STATUS_TEMPLATE_ID=
# 支付状态提醒（M6 接入支付后启用：payment_paid / payment_refunded）
# WX_SUBSCRIBE_PAYMENT_TEMPLATE_ID=

# 自建 WebSocket 聊天
CHAT_WS_URL=ws://localhost:3001
CHAT_WS_PORT=3001

# MinIO 对象存储（单桶，按 type 分文件夹：posts/anon/avatars/merchant/common）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yitong
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# 百度地图 API（智能生成流程：工作地点强制地图选点）
# JS API（前端 https://api.map.baidu.com/api?v=3.0&ak=...）+ geocoding/v3（服务端反查校验）
# 缺失时 dev 走 mock（随机 poiId/lng/lat），prod 抛 90003（沿用 §8 mock 策略）。
# 真实 AK 由用户写入本地 .env（gitignored），严禁提交到仓库。
BAIDU_MAP_AK=

# 试用授权锁（phone-home）。未设置 LICENSE_SERVER_URL = 授权功能关闭（dev 放行，不阻断）
# 授权服务器（Cloudflare Worker）部署见 infra/license-server/README.md
LICENSE_SERVER_URL=
LICENSE_ID=
LICENSE_API_KEY=
LICENSE_TRIAL_DAYS=10
# 断网容忍窗口（小时）：授权服务器连不上时，超此窗口则锁定
LICENSE_TOLERANCE_HOURS=2
# 完整性检测：部署时对 dist/license/*.js 算一次 SHA256，填这里；运行时若不一致立即 fail-closed
# 计算：cd apps/server && node -e "const{createHash}=require('crypto'),{readdirSync,readFileSync}=require('fs'),{join}=require('path');const d='dist/license';const h=createHash('sha256');for(const n of readdirSync(d).filter(f=>f.endsWith('.js')&&!f.endsWith('.js.map')).sort()){const c=readFileSync(join(d,n));h.update(n);h.update(String(c.length));h.update(c);}console.log(h.digest('hex'));"
LICENSE_BOOT_HASH=
# 关闭本地完整性比对（仅用于测试；生产请保持默认）
# LICENSE_LOCAL_CHECK_ENABLED=true

# 家教需求同步：每 5 分钟拉取源平台完整快照；失败时不下架现有岗位
TUTOR_SYNC_ENABLED=false
# 完整接口地址，例如 https://tutor.example.com/api/internal/sync/tutor-demands
TUTOR_SYNC_URL=
# 与源平台 TUTOR_SYNC_TOKEN 保持一致，真实值仅写本地 .env / 部署环境
TUTOR_SYNC_TOKEN=
