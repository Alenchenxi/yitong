# 复制为 .env 并填入实际值（.env 已 gitignore，勿提交真实凭证）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yitong?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
# 运行模式：dev 跳过角色登录权限校验（admin/merchant 直接放行，方便本地点角色即进）；prod 保留校验
MODE=dev
JWT_SECRET=change-me-in-prod
ADMIN_API_KEY=dev-admin-key

# 微信小程序
WX_USER_APPID=
WX_USER_SECRET=

# 微信支付（M0-03 / M6：金额一律由服务端按 PricingConfig 计算，不信前端传入金额）
# JSAPI 下单 appid 复用 WX_USER_APPID（须与商户号绑定同一主体）；商家 openid 取自 User.openid。
# mock/prod 策略（见 wx-pay.service.ts isReady）：以下凭证齐全 -> 真实 JSAPI 下单 + 回调验签 + 退款；
# 任一缺失 -> dev 走 mock（自动支付成功/直接退款），prod 抛 90003 阻断。
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_CERT_SERIAL=
# 商户证书 apiclient_cert.pem（绝对路径）
WX_PAY_CERT_PATH=
# 商户私钥 apiclient_key.pem（绝对路径）
WX_PAY_PRIVATE_KEY_PATH=
# 支付回调，落点 POST /api/v1/payments/notify（公网 https）
WX_PAY_NOTIFY_URL=
# 退款回调，落点 POST /api/v1/payments/refund-notify（公网 https；dev 可留空走 mock）
WX_PAY_REFUND_NOTIFY_URL=

# 微信订阅消息模板（M0-03 / M4：模板 ID 从微信公众平台订阅消息后台申请后填入）
# 未配置时仅记录日志跳过发送，站内消息不受影响（降级策略见 wx-subscribe-message.service.ts，M4-05）
# 新报名提醒（job_apply）
WX_SUBSCRIBE_JOB_APPLY_TEMPLATE_ID=
# 报名状态提醒（job_accept 录用 / job_reject 未录用 / job_complete 完成）
WX_SUBSCRIBE_JOB_STATUS_TEMPLATE_ID=
# 支付状态提醒（M6 接入支付后启用：payment_paid / payment_refunded）
# WX_SUBSCRIBE_PAYMENT_TEMPLATE_ID=

# 自建 WebSocket 聊天
CHAT_WS_URL=ws://localhost:3001
CHAT_WS_PORT=3001

# MinIO 对象存储（单桶，按 type 分文件夹：posts/anon/avatars/merchant/common）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yitong
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
