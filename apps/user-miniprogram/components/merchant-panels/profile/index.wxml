<view class="page">
  <!-- M5-02 认证状态卡 -->
  <view class="auth-card" wx:if="{{merchant}}">
    <view class="auth-head">
      <view class="shop-name">{{merchant.shopName}}</view>
      <view class="auth-badge auth-badge-{{merchant.status}}">{{statusText}}</view>
    </view>
    <view class="auth-tip" wx:if="{{merchant.status === 'PENDING'}}">资质审核中，通过后可发布岗位</view>
    <!-- REJECTED 三件套必须同层渲染：之前 tip / reason / 按钮串在同一条 wx:elif 链上，
         第一条 REJECTED 命中后，后两条永远不会渲染，「重新提交资质」按钮点不到 -->
    <block wx:elif="{{merchant.status === 'REJECTED'}}">
      <view class="auth-tip">资质未通过，请重新提交或联系平台</view>
      <view class="auth-tip auth-tip-reason" wx:if="{{lastRejectReason}}">上次未通过原因：{{lastRejectReason}}</view>
      <button class="register-btn" bindtap="goReapply">重新提交资质</button>
    </block>
    <view class="auth-tip" wx:elif="{{merchant.status === 'APPROVED'}}">资质已认证</view>
  </view>

  <!-- 未入驻引导 -->
  <view class="auth-card" wx:elif="{{notMerchant}}">
    <view class="auth-head">
      <view class="shop-name">未入驻商家</view>
      <view class="auth-badge auth-badge-NONE">未认证</view>
    </view>
    <view class="auth-tip">完成商家入驻并通过审核后可发布岗位</view>
    <button class="register-btn" bindtap="goRegister">去入驻</button>
  </view>

  <!-- M5-01 商家工作台 -->
  <block wx:if="{{merchant && merchant.status === 'APPROVED'}}">
    <!-- 店铺资料 -->
    <view class="section yt-card">
      <view class="section-head">
        <text class="section-title">店铺资料</text>
        <text class="edit-link" bindtap="toggleEdit">{{editing ? '取消' : '编辑'}}</text>
      </view>
      <view class="row" wx:if="{{!editing}}">
        <text class="label">店铺名称</text><text class="value">{{merchant.shopName}}</text>
      </view>
      <view class="row" wx:else>
        <text class="label">店铺名称</text>
        <input class="input" value="{{shopName}}" data-field="shopName" bindinput="onInput" />
      </view>
      <view class="row">
        <text class="label">营业执照号</text><text class="value">{{merchant.licenseNo}}</text>
      </view>
      <view class="row" wx:if="{{!editing}}">
        <text class="label">联系电话</text><text class="value">{{merchant.contactPhone}}</text>
      </view>
      <view class="row" wx:else>
        <text class="label">联系电话</text>
        <input class="input" type="number" value="{{contactPhone}}" data-field="contactPhone" bindinput="onInput" maxlength="11" />
      </view>
      <button class="save-btn" wx:if="{{editing}}" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
    </view>

    <!-- 招聘管理 -->
    <view class="section yt-card">
      <view class="section-title">招聘管理</view>
      <view class="menu-item" bindtap="goJobs"><text class="menu-item-label">我的岗位</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goCandidates"><text class="menu-item-label">候选人</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goPostJob"><text class="menu-item-label">发布岗位</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goDashboard"><text class="menu-item-label">数据看板</text><text class="arrow">›</text></view>
    </view>

    <!-- 订单与评价 -->
    <view class="section yt-card">
      <view class="section-title">订单与评价</view>
      <view class="menu-item" bindtap="goOrders"><text class="menu-item-label">订单记录</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goReviews"><text class="menu-item-label">评价管理</text><text class="arrow">›</text></view>
    </view>

    <!-- 消息与反馈 -->
    <view class="section yt-card">
      <view class="section-title">消息与反馈</view>
      <view class="menu-item" bindtap="goNotifications"><text class="menu-item-label">消息中心</text><text wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount}}</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goFeedback"><text class="menu-item-label">意见反馈</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goHelp"><text class="menu-item-label">帮助中心</text><text class="arrow">›</text></view>
    </view>

    <!-- 账号 -->
    <view class="section yt-card">
      <view class="section-title">账号</view>
      <view class="menu-item" bindtap="goAccountSecurity"><text class="menu-item-label">账号与安全</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goSettings"><text class="menu-item-label">设置</text><text class="arrow">›</text></view>
    </view>
  </block>

  <!-- 切换角色 -->
  <view class="section yt-card" wx:if="{{myRoles.length > 1}}">
    <view class="section-title">切换角色</view>
    <view
      wx:for="{{myRoles}}"
      wx:key="*this"
      class="menu-item role-item {{currentRole === item ? 'role-current-item' : ''}} {{switchingRole === item ? 'role-switching' : ''}}"
      data-role="{{item}}"
      catchtap="onSwitchRole"
    >
      <text>{{item === 'USER' ? '👤 用户端' : item === 'MERCHANT' ? '🏪 商家端' : '⚙ 管理端'}}</text>
      <text wx:if="{{currentRole === item}}" class="yt-tag yt-tag-accent">当前</text>
      <text wx:elif="{{switchingRole === item}}" style="font-size:24rpx;color:var(--yt-text-sub)">切换中…</text>
      <text wx:else class="arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section yt-card">
    <view class="section-title">关于</view>
    <view class="menu-item" bindtap="openPrivacyGuide"><text class="menu-item-label">用户隐私保护指引</text><text class="arrow">›</text></view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
