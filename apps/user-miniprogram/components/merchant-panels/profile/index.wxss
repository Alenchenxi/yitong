.page { padding: 24rpx; box-sizing: border-box; }

/* M5-02 认证状态卡 */
.auth-card {
  background: linear-gradient(135deg, var(--yt-primary-light, #ffe98f), var(--yt-primary, #F9C801));
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.auth-head { display: flex; justify-content: space-between; align-items: center; }
.shop-name { font-size: 34rpx; font-weight: 600; color: var(--yt-text-main); }
.auth-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  color: var(--yt-text-main);
}
.auth-badge-REJECTED { background: rgba(0, 0, 0, 0.15); color: var(--yt-danger); }
.auth-badge-NONE { background: rgba(134, 144, 156, 0.2); color: var(--yt-text-sub); }
.auth-tip { margin-top: 16rpx; font-size: 24rpx; color: var(--yt-text-main); opacity: 0.8; }
.auth-tip-reason { font-size: 24rpx; color: var(--yt-danger); opacity: 0.85; margin-top: 8rpx; }
.register-btn {
  margin-top: 24rpx;
  background: var(--yt-text-main) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}

/* M5-01 工作台分区 */
.section { margin-bottom: 24rpx; padding: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.section-title { font-size: 26rpx; color: var(--yt-text-sub); }
.edit-link { font-size: 26rpx; color: var(--yt-primary); }

.row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--yt-border); }
.row:last-of-type { border-bottom: none; }
.label { width: 180rpx; font-size: 28rpx; color: var(--yt-text-sub); flex-shrink: 0; }
.value { flex: 1; font-size: 28rpx; color: var(--yt-text-main); }
.input { flex: 1; font-size: 28rpx; border: 1rpx solid var(--yt-border); border-radius: 8rpx; padding: 8rpx 16rpx; }
.save-btn {
  margin-top: 24rpx;
  background: var(--yt-primary) !important;
  color: var(--yt-text-main) !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}

.menu-item {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--yt-text-main);
  border-bottom: 1rpx solid var(--yt-border);
}
.menu-item:last-child { border-bottom: none; }
.menu-item-label { flex: 1; }
.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--yt-danger);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  margin-right: 16rpx;
}
.arrow { color: var(--yt-text-weak); font-size: 32rpx; }

/* 角色切换 */
.role-current-item {
  background: linear-gradient(135deg, var(--yt-primary-lighter), var(--yt-primary-light));
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 12rpx;
}
.role-switching { opacity: 0.6; }

.logout-btn {
  margin-top: 32rpx;
  background: var(--yt-card) !important;
  color: var(--yt-danger) !important;
  border: 1rpx solid var(--yt-border) !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
}
