<view class="page">
  <view class="row"><text class="label">标题</text><input class="input" placeholder="如：周末奶茶店兼职" value="{{title}}" data-field="title" bindinput="onInput" /></view>
  <view class="row"><text class="label">薪资</text><input class="input" placeholder="如：150元/天" value="{{salary}}" data-field="salary" bindinput="onInput" /></view>
  <view class="row">
    <text class="label">工作地点</text>
    <view class="location-cell" bindtap="onPickLocation">
      <text wx:if="{{location}}" class="loc-val">{{location}}</text>
      <text wx:else class="loc-placeholder">点击选择工作地点</text>
      <text class="loc-arrow">›</text>
    </view>
  </view>

  <view class="block">
    <text class="label">分类</text>
    <view class="chips">
      <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{categoryOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="pickCategory"><text wx:if="{{item.icon}}">{{item.icon}} </text>{{item.label}}</view>
    </view>
    <input wx:if="{{customSelected}}" class="custom-category-input" value="{{customCategory}}" bindinput="onCustomCategoryInput" placeholder="输入岗位类型" maxlength="20" />
  </view>

  <view class="block">
    <text class="label">结算方式</text>
    <view class="chips">
      <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{settlementOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="pickSettlement">{{item.label}}</view>
    </view>
  </view>

  <view class="block">
    <text class="label">工作日期</text>
    <view class="chips">
      <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{workDateOptions}}" wx:key="label" data-label="{{item.label}}" bindtap="toggleWorkDate">{{item.label}}</view>
    </view>
  </view>

  <view class="block">
    <text class="label">工作时段</text>
    <view class="chips">
      <view class="chip {{item.selected ? 'active' : ''}}" wx:for="{{workPeriodOptions}}" wx:key="label" data-label="{{item.label}}" bindtap="toggleWorkPeriod">{{item.label}}</view>
    </view>
  </view>

  <view class="row"><text class="label">招聘人数</text><input class="input" type="number" placeholder="1" value="{{headcount}}" bindinput="onHeadcountInput" /></view>
  <view class="row"><text class="label">急招</text><switch checked="{{urgent}}" bindchange="toggleUrgent" color="#F9C801" /></view>
  <view class="row"><text class="label">可线上</text><switch checked="{{online}}" bindchange="toggleOnline" color="#F9C801" /></view>

  <view class="block">
    <text class="label">报名问题（选填）</text>
    <view class="tags" wx:if="{{questions.length > 0}}">
      <view class="tag" wx:for="{{questions}}" wx:key="*this" data-idx="{{index}}" bindtap="removeQuestion">{{item}} ✕</view>
    </view>
    <view class="add-row">
      <input class="add-input" value="{{questionInput}}" bindinput="onQuestionInput" placeholder="如：何时能到岗 / 有无相关经验" bindconfirm="addQuestion" />
      <view class="add-btn" bindtap="addQuestion">添加</view>
    </view>
  </view>

  <view class="textarea-wrap">
    <text class="label">工作内容</text>
    <textarea class="textarea" placeholder="岗位职责 / 工作内容" value="{{description}}" data-field="description" bindinput="onInput" maxlength="2000" auto-height show-confirm-bar="{{false}}" />
  </view>
  <view class="textarea-wrap">
    <text class="label">任职要求</text>
    <textarea class="textarea" placeholder="学历 / 技能 / 经验等（选填）" value="{{requirements}}" data-field="requirements" bindinput="onInput" maxlength="2000" auto-height show-confirm-bar="{{false}}" />
  </view>
  <view class="row">
    <text class="label">发布时长</text>
    <view class="dur">
      <view class="dur-opt {{duration === 'D30' ? 'active' : ''}} {{isEdit ? 'dur-readonly' : ''}}" data-d="D30" bindtap="pickDuration">30 天</view>
      <view class="dur-opt {{duration === 'D90' ? 'active' : ''}} {{isEdit ? 'dur-readonly' : ''}}" data-d="D90" bindtap="pickDuration">90 天</view>
    </view>
  </view>
  <view class="hint" wx:if="{{isEdit}}">发布时长创建后不可修改</view>
  <button class="submit" bindtap="submit" disabled="{{submitting}}">{{submitting ? '保存中…' : (isEdit ? '保存修改' : '发布岗位')}}</button>
  <view class="hint" wx:if="{{!isEdit}}">创建为草稿，提交后需付费发布（30/90 天单价由后台配置）</view>
  <view class="hint" wx:if="{{isEdit}}">已发布岗位编辑后将回退为待发布，需重新付费发布</view>
</view>
