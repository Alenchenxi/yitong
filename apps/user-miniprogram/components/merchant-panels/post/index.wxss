.page { padding: 24rpx; padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.label { width: 140rpx; font-size: 28rpx; color: #333; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; }
.location-cell {
  flex: 1; display: flex; align-items: center; gap: 12rpx;
  font-size: 28rpx; color: #1D2129;
}
.loc-val { flex: 1; }
.loc-placeholder { flex: 1; color: #86909C; }
.loc-arrow { color: #86909C; font-size: 32rpx; }
.textarea-wrap { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.textarea { width: 100%; min-height: 200rpx; font-size: 28rpx; line-height: 1.6; margin-top: 12rpx; }
.dur { display: flex; gap: 16rpx; flex: 1; }
.dur-opt { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #f5f6f8; font-size: 26rpx; color: #666; }
.dur-opt.active { background: #ff4d6d; color: #fff; font-weight: 600; }
.dur-readonly { opacity: 0.5; }

.block { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.block .label { display: block; width: auto; margin-bottom: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 12rpx 28rpx; border-radius: 999rpx; background: #f5f6f8; font-size: 26rpx; color: #666; }
.chip.active { background: #ff4d6d; color: #fff; font-weight: 600; }

.tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 16rpx; }
.tag { padding: 8rpx 22rpx; border-radius: 999rpx; background: #ffe4ea; color: #ff4d6d; font-size: 24rpx; }
.add-row { display: flex; align-items: center; gap: 16rpx; }
.add-input { flex: 1; background: #f5f6f8; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 26rpx; }
.add-btn { background: #ff4d6d; color: #fff; font-size: 26rpx; font-weight: 600; padding: 14rpx 28rpx; border-radius: 12rpx; }
.submit {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}
.submit[disabled] { background: #ffb3c1 !important; }
.hint { text-align: center; color: #999; font-size: 22rpx; margin-top: 20rpx; }
