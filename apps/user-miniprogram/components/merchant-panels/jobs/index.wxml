<view class="page">
  <!-- 顶部 banner + 发岗按钮 -->
  <view class="banner">
    <view class="banner-title">商家招聘工作台</view>
    <view class="banner-sub">发布岗位 · 收到报名 · 录用学生</view>
    <button class="post-btn" bindtap="goPost">+ 发布新岗位</button>
  </view>

  <!-- M3-01 数据看板：时间范围 tab + 4 列概览 -->
  <view class="dashboard yt-card" wx:if="{{dashboard}}">
    <scroll-view class="range-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="range-row">
        <view
          wx:for="{{rangeFilters}}"
          wx:key="value"
          class="range-chip {{activeRange === item.value ? 'range-chip-active' : ''}}"
          data-value="{{item.value}}"
          catchtap="onRangeTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{dashboard.viewCount}}</text>
        <text class="stat-label">浏览</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{dashboard.applicationCount}}</text>
        <text class="stat-label">报名</text>
      </view>
      <view class="stat">
        <text class="stat-num highlight">{{dashboard.pendingCount}}</text>
        <text class="stat-label">待处理</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{dashboard.acceptedCount}}</text>
        <text class="stat-label">已录用</text>
      </view>
    </view>
  </view>

  <!-- M3-02 搜索 + M3-03 状态筛选 -->
  <view class="filter yt-card">
    <view class="search-row">
      <input
        class="search-input"
        placeholder="搜索岗位标题 / 描述"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" catchtap="onSearch">搜索</view>
    </view>
    <scroll-view class="status-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="status-row">
        <view
          wx:for="{{statusFilters}}"
          wx:key="value"
          class="status-chip {{activeStatus === item.value ? 'status-chip-active' : ''}}"
          data-value="{{item.value}}"
          catchtap="onStatusTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section-title">
    <text>我的岗位</text>
    <text class="section-extra">{{posts.length}} 个</text>
  </view>
  <view class="card" wx:for="{{posts}}" wx:key="id">
    <view class="card-main" data-id="{{item.id}}" bindtap="goDetail">
      <view class="title">{{item.title}}</view>
      <view class="meta">
        <text class="salary">{{item.salary}}</text>
        <text class="status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="dur">{{item.duration === 'D90' ? '90 天' : '30 天'}} · {{item.location}}</view>
    </view>
    <!-- M3-06 报名管理入口：待处理数 badge，点击跳候选人 tab 预筛选 -->
    <view
      wx:if="{{item.pendingCount > 0}}"
      class="pending-badge"
      data-id="{{item.id}}"
      catchtap="goCandidates"
    >{{item.pendingCount}} 条待处理报名</view>
    <!-- M3-04 编辑 / M3-05 下架 -->
    <view class="card-actions" wx:if="{{item.status === 'PENDING' || item.status === 'PUBLISHED'}}">
      <button
        class="action-btn edit-btn"
        size="mini"
        catchtap="goEdit"
        data-id="{{item.id}}"
      >编辑</button>
      <button
        wx:if="{{item.status === 'PUBLISHED'}}"
        class="action-btn takedown-btn"
        size="mini"
        catchtap="onTakeDown"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
      >下架</button>
    </view>
    <button
      wx:if="{{item.status === 'PENDING'}}"
      class="pay-btn"
      size="mini"
      catchtap="goPay"
      data-id="{{item.id}}"
      data-dur="{{item.duration}}"
    >付费发布</button>
  </view>
  <view class="empty" wx:if="{{posts.length === 0}}">
    <view class="empty-title">还没有岗位</view>
    <view class="empty-sub">点上方按钮发布第一个岗位</view>
  </view>
</view>
