<view class="card" wx:if="{{post}}" bindtap="onTap">
  <!-- P2-05 置顶/加精角标 -->
  <view class="badges" wx:if="{{post.pinned || post.featured}}">
    <text class="badge badge-pin" wx:if="{{post.pinned}}">置顶</text>
    <text class="badge badge-feature" wx:if="{{post.featured}}">精</text>
  </view>
  <view class="header">
    <image wx:if="{{hasAvatar}}" class="avatar" src="{{post.authorAvatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="avatar avatar-ph">{{avatarChar}}</view>
    <view class="meta">
      <view class="nickname">
        {{post.authorNickname}}
        <text class="anon-badge" wx:if="{{post.isAnonymous}}">匿名</text>
      </view>
      <view class="time">{{timeText}}</view>
    </view>
  </view>
  <view class="content">{{post.content}}</view>
  <view class="tags" wx:if="{{post.tags.length}}">
    <text class="tag" wx:for="{{post.tags}}" wx:key="*this">#{{item}}</text>
  </view>
  <video wx:if="{{post.videoUrl}}" class="video" src="{{post.videoUrl}}" poster="{{post.videoCover}}" object-fit="cover" controls></video>
  <view class="images images-{{imgLayout}}" wx:elif="{{imgLayout}}">
    <image
      wx:for="{{post.images}}"
      wx:key="*this"
      class="img img-{{imgLayout}}"
      src="{{item}}"
      mode="aspectFill"
      data-src="{{item}}"
      catchtap="previewImage"
    ></image>
  </view>
  <view class="actions">
    <view class="action" catchtap="onLike">
      <text class="icon {{post.liked ? 'liked' : ''}}">{{post.liked ? '♥' : '♡'}}</text>
      <text class="count">{{post.likeCount || ''}}</text>
    </view>
    <view class="action" catchtap="onComment">
      <text class="icon">💬</text>
      <text class="count">{{post.commentCount || ''}}</text>
    </view>
  </view>
</view>
