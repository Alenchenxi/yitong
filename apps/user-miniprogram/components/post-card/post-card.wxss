.card {
  background: var(--yt-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--yt-border);
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--yt-disabled-bg);
  margin-right: 16rpx;
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE99A, var(--yt-primary));
  color: var(--yt-text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.meta { flex: 1; }

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--yt-text-main);
}

.time {
  font-size: 22rpx;
  color: var(--yt-text-sub);
  margin-top: 4rpx;
}

.content {
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--yt-text-main);
  white-space: pre-wrap;
  word-break: break-word;
}

.images {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
}

.images-one { grid-template-columns: 1fr; }
.images-two { grid-template-columns: repeat(2, 1fr); }
.images-three { grid-template-columns: repeat(3, 1fr); }

.img {
  width: 100%;
  background: var(--yt-disabled-bg);
  border-radius: 8rpx;
}

.img-one { height: 360rpx; width: 540rpx; }
.img-two, .img-three { height: 200rpx; }

.actions {
  display: flex;
  gap: 48rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--yt-border);
}

.action {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--yt-text-sub);
}

.icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.icon.liked {
  color: var(--yt-primary);
}

.count { min-width: 32rpx; }
