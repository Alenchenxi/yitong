.nearby {
  padding: 16rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.presence-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  min-height: 88rpx;
  padding: 0 4rpx 16rpx;
  border-bottom: 1rpx solid var(--yt-border);
}

.presence-copy {
  min-width: 0;
}

.presence-title {
  color: var(--yt-text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.presence-status {
  margin-top: 4rpx;
  color: var(--yt-text-sub);
  font-size: 22rpx;
}

.nearby-loading,
.nearby-empty {
  padding: 120rpx 0;
  color: var(--yt-text-sub);
  font-size: 26rpx;
  text-align: center;
}

.nearby-enable {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 104rpx 0;
}

.enable-icon,
.empty-mark {
  color: var(--yt-primary-dark);
  font-size: 52rpx;
}

.enable-title {
  margin-top: 18rpx;
  color: var(--yt-text-main);
  font-size: 30rpx;
  font-weight: 600;
}

.enable-button {
  min-width: 260rpx;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-size: 26rpx;
  line-height: 88rpx;
}

.enable-button::after,
.retry-button::after,
.person-button::after {
  border: none;
}

.location-error {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 20rpx 0 4rpx;
  padding: 20rpx;
  border: 1rpx solid var(--yt-warning);
  border-radius: 12rpx;
  background: var(--yt-warning-bg);
  color: var(--yt-text-body);
  font-size: 24rpx;
}

.retry-button {
  flex-shrink: 0;
  min-width: 128rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: var(--yt-card);
  color: var(--yt-text-main);
  font-size: 23rpx;
  line-height: 56rpx;
}

.people-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 20rpx;
}

.person-card {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  width: 100%;
  min-width: 0;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--yt-border);
  border-radius: 16rpx;
  background: var(--yt-card);
}

.person-avatar {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--yt-disabled-bg);
}

.person-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--yt-text-main);
  font-size: 34rpx;
}

.person-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.person-name {
  overflow: hidden;
  color: var(--yt-text-main);
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-distance {
  margin-top: 8rpx;
  color: var(--yt-text-sub);
  font-size: 22rpx;
}

.person-actions {
  display: flex;
  flex-shrink: 0;
  flex-wrap: wrap;
  justify-content: flex-start;
  flex-basis: calc(100% - 102rpx);
  gap: 10rpx;
  margin: 14rpx 0 0 102rpx;
}

.person-button {
  width: 104rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  font-size: 23rpx;
  line-height: 58rpx;
}

.follow-button {
  background: var(--yt-primary);
  color: var(--yt-text-main);
}

.follow-button.is-following {
  border: 1rpx solid var(--yt-border);
  background: var(--yt-disabled-bg);
  color: var(--yt-text-sub);
}

.view-button {
  border: 1rpx solid var(--yt-border);
  background: var(--yt-card);
  color: var(--yt-text-body);
}

.list-tip {
  padding: 24rpx 0;
  color: var(--yt-text-sub);
  font-size: 24rpx;
  text-align: center;
}
