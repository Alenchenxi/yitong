<wxs src="../admin-status.wxs" module="st" />
<view class="adm-page">
  <scroll-view scroll-x class="adm-subtabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{allowedSubs}}" wx:key="*this" class="adm-subtab {{sub === item ? 'on' : ''}}" data-sub="{{item}}" bindtap="switchSub">{{subLabels[item]}}</view>
  </scroll-view>

  <!-- 商家入驻 -->
  <block wx:if="{{sub === 'merchant' && queue}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{merchantStatus === 'all' ? 'on' : ''}}" data-s="all" bindtap="switchMerchantStatus">全部</view>
      <view class="adm-filter-btn {{merchantStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchMerchantStatus">待审核</view>
      <view class="adm-filter-btn {{merchantStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchMerchantStatus">已通过</view>
      <view class="adm-filter-btn {{merchantStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchMerchantStatus">已拒绝</view>
    </view>
    <view class="adm-section-title">商家入驻 ({{filteredMerchants.length}})</view>
    <view class="adm-batch" wx:if="{{merchantStatus === 'PENDING' && filteredMerchants.length > 0}}" hover-class="adm-hover" bindtap="batchApprove">批量通过待审核</view>
    <view class="adm-item" wx:for="{{filteredMerchants}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.shopName}}</text>
        <text class="adm-item-sub">{{item.userNickname}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'PENDING'}}" size="mini" data-id="{{item.id}}" bindtap="approve">通过</button>
        <button wx:if="{{item.status === 'PENDING' || item.status === 'APPROVED'}}" size="mini" data-id="{{item.id}}" bindtap="reject">拒绝</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{filteredMerchants.length === 0}}">暂无商家</view>
  </block>

  <!-- 表白墙帖 -->
  <block wx:if="{{sub === 'posts'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{postStatus === '' ? 'on' : ''}}" data-s="" bindtap="switchPostStatus">全部</view>
      <view class="adm-filter-btn {{postStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchPostStatus">待审核</view>
      <view class="adm-filter-btn {{postStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchPostStatus">已通过</view>
      <view class="adm-filter-btn {{postStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchPostStatus">已拒绝</view>
    </view>
    <view class="adm-search">
      <input class="adm-search-input" placeholder="搜索帖子内容" value="{{postKeyword}}" bindinput="onPostKeywordInput" bindconfirm="searchPosts" />
      <button size="mini" bindtap="searchPosts">搜索</button>
    </view>
    <view class="adm-item" wx:for="{{posts}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.content}}</text>
        <text class="adm-item-sub">{{item.authorNickname}} · {{item.circleName}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text>{{item.pinned ? ' · 置顶' : ''}}{{item.featured ? ' · 精' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-pinned="{{item.pinned}}" bindtap="togglePin">{{item.pinned ? '取消置顶' : '置顶'}}</button>
        <button size="mini" data-id="{{item.id}}" data-featured="{{item.featured}}" bindtap="toggleFeature">{{item.featured ? '取消加精' : '加精'}}</button>
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedown">下架</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{postHasMore}}" bindtap="loadMorePosts">加载更多</view>
    <view class="adm-empty" wx:if="{{posts.length === 0}}">暂无帖子</view>
  </block>

  <!-- 树洞帖 -->
  <block wx:if="{{sub === 'anon'}}">
    <view class="adm-item" wx:for="{{anonPosts}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.content}}</text>
        <text class="adm-item-sub">{{item.anonId}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedownAnon">下架</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{anonPostHasMore}}" bindtap="loadMoreAnonPosts">加载更多</view>
    <view class="adm-empty" wx:if="{{anonPosts.length === 0}}">暂无树洞帖</view>
  </block>

  <!-- 评论 -->
  <block wx:if="{{sub === 'comments'}}">
    <view class="adm-search">
      <input class="adm-search-input" placeholder="按帖子ID筛选" value="{{commentPostId}}" bindinput="onCommentPostIdInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按内容搜索" value="{{commentKeyword}}" bindinput="onCommentKeywordInput" bindconfirm="searchComments" />
    </view>
    <view class="adm-search">
      <input class="adm-search-input" placeholder="按作者ID" value="{{commentAuthorId}}" bindinput="onAuthorIdInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按作者昵称" value="{{commentAuthorNickname}}" bindinput="onAuthorNicknameInput" bindconfirm="searchComments" />
      <input class="adm-search-input" placeholder="按帖子内容" value="{{commentPostTitleKw}}" bindinput="onPostTitleKwInput" bindconfirm="searchComments" />
    </view>
    <view class="adm-search"><button size="mini" bindtap="searchComments">筛选</button></view>
    <view class="adm-item" wx:for="{{comments}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.content}}</text>
        <text class="adm-item-sub">{{item.postTitle ? '帖：' + item.postTitle + ' · ' : ''}}赞{{item.likeCount}}{{item.pinned ? ' · 已置顶' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-pinned="{{item.pinned}}" bindtap="pinCommentTap">{{item.pinned ? '取消置顶' : '置顶'}}</button>
      </view>
    </view>
    <view class="adm-loadmore" wx:if="{{commentHasMore}}" bindtap="loadMoreComments">加载更多</view>
    <view class="adm-empty" wx:if="{{comments.length === 0}}">暂无评论</view>
  </block>

  <!-- 举报处理 -->
  <block wx:if="{{sub === 'reports'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{reportStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchReportStatus">待处理</view>
      <view class="adm-filter-btn {{reportStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchReportStatus">成立</view>
      <view class="adm-filter-btn {{reportStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchReportStatus">驳回</view>
    </view>
    <view class="adm-item" wx:for="{{reports}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.targetSummary || item.targetType}}</text>
        <text class="adm-item-sub">举报人：{{item.reporterNickname || '匿名'}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{item.createdAt}}</text>
        <text class="adm-item-sub" wx:if="{{item.reason}}">理由：{{item.reason}}</text>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status === 'PENDING'}}">
        <button size="mini" data-id="{{item.id}}" data-action="approve" bindtap="resolveReportTap">成立</button>
        <button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="resolveReportTap">驳回</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{reports.length === 0}}">暂无举报</view>
  </block>

  <!-- 岗位（R4 管理员主动下架）-->
  <block wx:if="{{sub === 'jobs'}}">
    <view class="adm-item" wx:for="{{jobs}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub">{{item.merchantShopName}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text>{{item.urgent ? ' · 急招' : ''}}{{item.featured ? ' · 精' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'PUBLISHED'}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="takedownJob">下架</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{jobs.length === 0}}">暂无岗位</view>
  </block>
</view>
