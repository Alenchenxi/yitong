@import "../admin-common.wxss";

/* ===== P2-30 管理员 sub-tab 扩展样式 ===== */
/* 主要补充 dialog/badge/btn 变体；列表项复用 adm-item-* */

/* 主色按钮（与 UI 规范 #F9C801 对齐） */
.adm-btn--primary {
  background-color: var(--yt-primary);
  color: var(--yt-text-main);
}

/* 「自己」徽标：浅蓝底色 + 白字，区别于 status 状态色 */
.adm-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}
.adm-badge--self {
  background-color: var(--yt-info);
  color: #fff;
}

/* 添加管理员弹窗：fixed 全屏 + mask + 居中面板（wxss 不支持 inset:0，展开四角） */
.adm-dialog {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}
.adm-dialog-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
}
.adm-dialog-panel {
  position: absolute;
  top: 10%;
  bottom: 10%;
  left: 5%;
  right: 5%;
  background-color: var(--yt-card);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}
.adm-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--yt-text-main);
  margin-bottom: 16rpx;
}
.adm-dialog-list {
  flex: 1;
  margin-top: 16rpx;
}
.adm-dialog-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--yt-border);
}
