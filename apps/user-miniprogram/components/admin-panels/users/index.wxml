<wxs src="../admin-status.wxs" module="st" />
<view class="adm-page">
  <scroll-view scroll-x class="adm-subtabs" enhanced show-scrollbar="{{false}}">
    <view class="adm-subtab {{sub === 'users' ? 'on' : ''}}" data-sub="users" bindtap="switchSub">用户</view>
    <view class="adm-subtab {{sub === 'tickets' ? 'on' : ''}}" data-sub="tickets" bindtap="switchSub">工单</view>
  </scroll-view>

  <!-- 用户 -->
  <block wx:if="{{sub === 'users'}}">
    <view class="adm-search">
      <input class="adm-search-input" placeholder="搜索昵称/用户ID" value="{{userKeyword}}" bindinput="onUserKeywordInput" bindconfirm="searchUsers" />
      <button size="mini" bindtap="searchUsers">搜索</button>
    </view>
    <view class="adm-item" wx:for="{{users}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.nickname}}</text>
        <text class="adm-item-sub"><text class="adm-status {{item.banned ? 'adm-status--rejected' : 'adm-status--approved'}}">{{item.banned ? '已封禁' : '正常'}}</text>{{item.mutedUntil ? ' · 禁言至 ' + item.mutedUntil : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{!item.banned}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="banUserTap">封禁</button>
        <button size="mini" data-id="{{item.id}}" data-muted="{{item.mutedUntil}}" bindtap="muteUserTap">{{item.mutedUntil ? '解除禁言' : '禁言'}}</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{users.length === 0}}">暂无用户</view>
  </block>

  <!-- 工单 -->
  <block wx:if="{{sub === 'tickets'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{ticketStatus === 'OPEN' ? 'on' : ''}}" data-s="OPEN" bindtap="switchTicketStatus">待处理</view>
      <view class="adm-filter-btn {{ticketStatus === 'IN_PROGRESS' ? 'on' : ''}}" data-s="IN_PROGRESS" bindtap="switchTicketStatus">处理中</view>
      <view class="adm-filter-btn {{ticketStatus === 'CLOSED' ? 'on' : ''}}" data-s="CLOSED" bindtap="switchTicketStatus">已关闭</view>
    </view>
    <view class="adm-item" wx:for="{{tickets}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub">{{item.userNickname}}（{{item.role === 'merchant' ? '商家' : '用户'}}）· <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{item.createdAt}}</text>
        <text class="adm-item-sub">内容：{{item.content}}</text>
        <text class="adm-item-sub" wx:if="{{item.reply}}">回复：{{item.reply}}</text>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status === 'CLOSED'}}">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="reopenTicketTap">重开</button>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status !== 'CLOSED'}}">
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketTap">回复关闭</button>
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketKeepTap">保留处理</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{tickets.length === 0}}">暂无工单</view>
  </block>
</view>
