<wxs src="../admin-status.wxs" module="st" />
<view class="adm-page">
  <scroll-view scroll-x class="adm-subtabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{subs}}" wx:key="*this" class="adm-subtab {{sub === item ? 'on' : ''}}" data-sub="{{item}}" bindtap="switchSub">{{subLabels[item]}}</view>
  </scroll-view>

  <!-- 用户 -->
  <block wx:if="{{sub === 'users'}}">
    <view class="adm-user-scope">
      <view class="adm-user-scope-options">
        <view
          wx:for="{{userScopes}}"
          wx:key="scope"
          class="adm-user-scope-btn {{userScope === item.scope ? 'on' : ''}}"
          data-scope="{{item.scope}}"
          bindtap="switchUserScope"
        >{{item.label}}</view>
      </view>
      <picker
        wx:if="{{userScope === 'COMMUNITY'}}"
        mode="selector"
        range="{{userCommunities}}"
        range-key="name"
        value="{{userCommunityIndex}}"
        bindchange="onUserCommunityChange"
      >
        <view class="adm-user-community">{{userCommunities[userCommunityIndex].name || '请选择圈子'}}</view>
      </picker>
      <view class="adm-user-scope-note">{{userScope === 'PLATFORM' ? '平台封禁对所有圈子生效，仅平台管理员可解除' : '圈子封禁仅在当前圈子生效，平台管理员可解除'}}</view>
    </view>
    <view class="adm-search">
      <input class="adm-search-input" placeholder="搜索昵称/用户ID" value="{{userKeyword}}" bindinput="onUserKeywordInput" bindconfirm="searchUsers" />
      <button size="mini" bindtap="searchUsers">搜索</button>
    </view>
    <view class="adm-item" wx:for="{{users}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.nickname}}</text>
        <text class="adm-item-sub"><text class="adm-status {{item.banned ? 'adm-status--rejected' : 'adm-status--approved'}}">{{item.banned ? (item.banAuthority === 'PLATFORM' ? '平台封禁' : '圈子封禁') : '正常'}}</text>{{item.mutedUntil ? ' · 禁言至 ' + item.mutedUntil : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{!item.banned}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="banUserTap">封禁</button>
        <button wx:elif="{{isPlatformAdmin || item.banAuthority === 'COMMUNITY'}}" size="mini" data-id="{{item.id}}" bindtap="unbanUserTap">解除封禁</button>
        <button size="mini" data-id="{{item.id}}" data-muted="{{item.mutedUntil}}" bindtap="muteUserTap">{{item.mutedUntil ? '解除禁言' : '禁言'}}</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{users.length === 0}}">暂无用户</view>
  </block>

  <!-- 工单 -->
  <block wx:if="{{sub === 'tickets'}}">
    <view class="adm-filter">
      <view class="adm-filter-btn {{ticketStatus === 'OPEN' ? 'on' : ''}}" data-s="OPEN" bindtap="switchTicketStatus">待处理</view>
      <view class="adm-filter-btn {{ticketStatus === 'IN_PROGRESS' ? 'on' : ''}}" data-s="IN_PROGRESS" bindtap="switchTicketStatus">处理中</view>
      <view class="adm-filter-btn {{ticketStatus === 'CLOSED' ? 'on' : ''}}" data-s="CLOSED" bindtap="switchTicketStatus">已关闭</view>
    </view>
    <view class="adm-item" wx:for="{{tickets}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub">{{item.userNickname}}（{{item.role === 'merchant' ? '商家' : '用户'}}）· <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{item.createdAt}}</text>
        <text class="adm-item-sub">内容：{{item.content}}</text>
        <text class="adm-item-sub" wx:if="{{item.reply}}">回复：{{item.reply}}</text>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status === 'CLOSED'}}">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="reopenTicketTap">重开</button>
      </view>
      <view class="adm-item-actions" wx:if="{{item.status !== 'CLOSED'}}">
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketTap">回复关闭</button>
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketKeepTap">保留处理</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{tickets.length === 0}}">暂无工单</view>
  </block>

  <!-- 管理员（P2-30） -->
  <block wx:if="{{sub === 'admins'}}">
    <view class="adm-search">
      <input class="adm-search-input" placeholder="搜昵称/用户名/openid" value="{{adminKeyword}}" bindinput="onAdminKeywordInput" bindconfirm="searchAdmins" />
      <button size="mini" bindtap="searchAdmins">搜索</button>
      <button size="mini" class="adm-btn--primary" bindtap="openAddDialog">添加</button>
    </view>
    <view class="adm-item" wx:for="{{admins}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.linkedUser ? item.linkedUser.nickname : item.username}}<text wx:if="{{item.isSelf}}" class="adm-badge adm-badge--self">自己</text></text>
        <text class="adm-item-sub">{{item.adminType.name}} · {{item.allCommunities ? '全部圈子' : item.communities.length + ' 个圈子'}}</text>
        <text class="adm-item-sub">username: {{item.username}} · 加入于 {{item.createdAt}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-admin="{{item}}" bindtap="editAdminTap">调整</button>
        <button size="mini" type="warn" data-admin="{{item}}" bindtap="deleteAdminTap" disabled="{{item.isSelf}}">{{item.isSelf ? '自己' : '删除'}}</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{admins.length === 0}}">暂无管理员</view>
  </block>

  <block wx:if="{{sub === 'adminTypes'}}">
    <view class="adm-section-title">管理员类型</view>
    <view class="adm-item" wx:for="{{adminTypes}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.name}}</text>
        <text class="adm-item-sub">{{item.code}} · {{item.adminCount}} 位管理员 · {{item.permissionCodes.length}} 项权限</text>
        <text class="adm-item-sub" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
      <view class="adm-item-actions">
        <switch checked="{{item.active}}" disabled="{{item.systemProtected}}" data-id="{{item.id}}" bindchange="toggleAdminType" color="#F9C801" />
        <button wx:if="{{!item.isPlatform}}" size="mini" data-type="{{item}}" bindtap="startEditType">编辑</button>
        <button wx:if="{{!item.systemProtected}}" size="mini" type="warn" data-type="{{item}}" bindtap="deleteAdminTypeTap">删除</button>
      </view>
    </view>

    <view class="adm-section-title">{{typeFormId ? '编辑类型' : '新建类型'}}</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="类型名称" value="{{typeName}}" data-field="typeName" bindinput="onTypeInput" />
      <input class="adm-input" placeholder="类型编码，如 CAMPUS_OPERATOR" value="{{typeCode}}" data-field="typeCode" bindinput="onTypeInput" disabled="{{typeFormId}}" />
      <input class="adm-input" placeholder="职责说明" value="{{typeDescription}}" data-field="typeDescription" bindinput="onTypeInput" />
      <checkbox-group bindchange="onTypePermissionsChange" class="adm-permission-list">
        <label class="adm-check-row" wx:for="{{permissionOptions}}" wx:key="code">
          <checkbox value="{{item.code}}" checked="{{item.checked}}" color="#F9C801" />
          <view>
            <text class="adm-item-title">{{item.name}}</text>
            <text class="adm-item-sub">{{item.module}} · {{item.description}}</text>
          </view>
        </label>
      </checkbox-group>
      <view class="adm-form-actions">
        <button class="adm-btn--primary" size="mini" bindtap="saveAdminType">保存</button>
        <button size="mini" bindtap="startCreateType">清空</button>
      </view>
    </view>
  </block>

  <!-- 添加管理员弹窗 -->
  <view wx:if="{{showAddDialog}}" class="adm-dialog" catchtouchmove="noop">
    <view class="adm-dialog-mask" bindtap="closeAddDialog" />
    <view class="adm-dialog-panel">
      <view class="adm-dialog-title">{{editingManagerId ? '调整管理员权限' : '添加管理员'}}</view>
      <view class="adm-scope-form">
        <text class="adm-field-label">管理员类型</text>
        <picker mode="selector" range="{{adminTypes}}" range-key="name" value="{{selectedAdminTypeIndex}}" bindchange="onAdminTypeChange">
          <view class="adm-picker">{{adminTypes[selectedAdminTypeIndex].name || '请选择管理员类型'}}</view>
        </picker>
        <view class="adm-scope-switch">
          <view>
            <text class="adm-field-label">管理全部圈子</text>
            <text class="adm-item-sub">关闭后请选择具体授权圈子</text>
          </view>
          <switch checked="{{allCommunities}}" disabled="{{adminTypes[selectedAdminTypeIndex].isPlatform}}" color="#F9C801" bindchange="onAllCommunitiesChange" />
        </view>
        <checkbox-group wx:if="{{!allCommunities}}" class="adm-community-grid" bindchange="onCommunityScopeChange">
          <label class="adm-community-option" wx:for="{{scopeCommunityOptions}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.selected}}" color="#F9C801" />
            <text>{{item.name}}</text>
          </label>
        </checkbox-group>
      </view>
      <view wx:if="{{!editingManagerId}}" class="adm-search">
        <input class="adm-search-input" placeholder="搜昵称（已绑微信）" value="{{candidateKeyword}}" bindinput="onCandidateKeywordInput" bindconfirm="searchCandidates" />
        <button size="mini" bindtap="searchCandidates">搜索</button>
      </view>
      <scroll-view wx:if="{{!editingManagerId}}" class="adm-dialog-list" scroll-y>
        <view class="adm-item" wx:for="{{candidates}}" wx:key="id">
          <view class="adm-item-main">
            <text class="adm-item-title">{{item.nickname}}</text>
            <text class="adm-item-sub">id: {{item.id}}</text>
          </view>
          <view class="adm-item-actions">
            <button
              size="mini"
              class="adm-btn--primary"
              data-user-id="{{item.id}}"
              data-user-nickname="{{item.nickname}}"
              bindtap="addCandidateTap"
              disabled="{{addingUserId !== ''}}"
              loading="{{addingUserId === item.id}}"
            >添加</button>
          </view>
        </view>
        <view class="adm-empty" wx:if="{{candidates.length === 0 && candidateKeyword}}">无匹配用户</view>
      </scroll-view>
      <view class="adm-dialog-footer">
        <button wx:if="{{editingManagerId}}" size="mini" class="adm-btn--primary" bindtap="saveAdminAssignment">保存调整</button>
        <button size="mini" bindtap="closeAddDialog" disabled="{{addingUserId !== ''}}">关闭</button>
      </view>
    </view>
  </view>
</view>
