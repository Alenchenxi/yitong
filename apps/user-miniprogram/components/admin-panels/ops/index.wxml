<wxs src="../admin-status.wxs" module="st" />
<view class="adm-page">
  <scroll-view scroll-x class="adm-subtabs" enhanced show-scrollbar="{{false}}">
    <view class="adm-subtab {{sub === 'announce' ? 'on' : ''}}" data-sub="announce" bindtap="switchSub">公告</view>
    <view class="adm-subtab {{sub === 'activity' ? 'on' : ''}}" data-sub="activity" bindtap="switchSub">活动专题</view>
    <view class="adm-subtab {{sub === 'topic' ? 'on' : ''}}" data-sub="topic" bindtap="switchSub">话题</view>
    <view class="adm-subtab {{sub === 'tags' ? 'on' : ''}}" data-sub="tags" bindtap="switchSub">树洞标签</view>
    <view class="adm-subtab {{sub === 'jobs' ? 'on' : ''}}" data-sub="jobs" bindtap="switchSub">岗位精品</view>
    <view class="adm-subtab {{sub === 'pricing' ? 'on' : ''}}" data-sub="pricing" bindtap="switchSub">单价</view>
    <view class="adm-subtab {{sub === 'boost' ? 'on' : ''}}" data-sub="boost" bindtap="switchSub">推广价</view>
    <view class="adm-subtab {{sub === 'banner' ? 'on' : ''}}" data-sub="banner" bindtap="switchSub">广告位</view>
    <view class="adm-subtab {{sub === 'community' ? 'on' : ''}}" data-sub="community" bindtap="switchSub">圈子<text wx:if="{{cmPendingCount > 0}}" style="color:#F53F3F;font-size:20rpx;margin-left:6rpx;">·{{cmPendingCount}}</text></view>
    <view class="adm-subtab {{sub === 'settings' ? 'on' : ''}}" data-sub="settings" bindtap="switchSub">设置</view>
  </scroll-view>

  <!-- 公告 -->
  <block wx:if="{{sub === 'announce'}}">
    <view class="adm-section-title">新建公告</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="标题（最多 100 字）" value="{{annTitle}}" data-field="annTitle" bindinput="onAnnInput" maxlength="100" />
      <textarea class="adm-textarea" placeholder="内容（最多 2000 字）" value="{{annContent}}" data-field="annContent" bindinput="onAnnInput" maxlength="2000" auto-height />
      <button class="yt-btn-primary" bindtap="createAnn">发布</button>
    </view>
    <view class="adm-section-title">公告列表 ({{announcements.length}})</view>
    <view class="adm-item" wx:for="{{announcements}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub"><text class="adm-status {{item.active ? 'adm-status--approved' : 'adm-status--neutral'}}">{{item.active ? '启用' : '停用'}}</text> · {{item.createdAt}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleAnn">{{item.active ? '停用' : '启用'}}</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteAnn">删除</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{announcements.length === 0}}">暂无公告</view>
  </block>

  <!-- 活动专题 -->
  <block wx:if="{{sub === 'activity'}}">
    <view class="adm-section-title">新建专题</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="专题标题" value="{{actTitle}}" data-field="actTitle" bindinput="onActInput" />
      <textarea class="adm-textarea" placeholder="简介（选填）" value="{{actDesc}}" data-field="actDesc" bindinput="onActInput" auto-height />
      <button class="yt-btn-primary" bindtap="createAct">发布</button>
    </view>
    <view class="adm-section-title">专题列表 ({{activityTopics.length}})</view>
    <view class="adm-item" wx:for="{{activityTopics}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub"><text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{item.createdAt}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteAct">删除</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{activityTopics.length === 0}}">暂无专题</view>
  </block>

  <!-- 话题 -->
  <block wx:if="{{sub === 'topic'}}">
    <view class="adm-section-title">新建话题</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="话题名称" value="{{topicName}}" data-field="topicName" bindinput="onTopicInput" />
      <textarea class="adm-textarea" placeholder="描述（选填）" value="{{topicDesc}}" data-field="topicDesc" bindinput="onTopicInput" auto-height />
      <button class="yt-btn-primary" bindtap="createTopic">发布</button>
    </view>
    <view class="adm-section-title">话题列表 ({{topics.length}})</view>
    <view class="adm-item" wx:for="{{topics}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">#{{item.name}}</text>
        <text class="adm-item-sub"><text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text> · {{item.createdAt}}</text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteTopic">删除</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{topics.length === 0}}">暂无话题</view>
  </block>

  <!-- 树洞标签 -->
  <block wx:if="{{sub === 'tags'}}">
    <view class="adm-section-title">新建标签</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="标签名（最多 12 字）" maxlength="12" value="{{tagName}}" data-field="tagName" bindinput="onTagInput" />
      <input class="adm-input" placeholder="排序（数字，选填）" type="digit" value="{{tagSort}}" data-field="tagSort" bindinput="onTagInput" />
      <view class="adm-filter">
        <view class="adm-filter-btn {{tagCategory === 'personality' ? 'on' : ''}}" data-c="personality" bindtap="pickTagCat">性格</view>
        <view class="adm-filter-btn {{tagCategory === 'interest' ? 'on' : ''}}" data-c="interest" bindtap="pickTagCat">兴趣</view>
        <view class="adm-filter-btn {{tagCategory === 'mood' ? 'on' : ''}}" data-c="mood" bindtap="pickTagCat">心情</view>
      </view>
      <button class="yt-btn-primary" bindtap="createTag">创建</button>
    </view>
    <view class="adm-section-title">标签列表 ({{anonTags.length}})</view>
    <view class="adm-filter">
      <view class="adm-filter-btn {{tagFilterCat === '' ? 'on' : ''}}" data-c="" bindtap="switchTagCat">全部</view>
      <view class="adm-filter-btn {{tagFilterCat === 'personality' ? 'on' : ''}}" data-c="personality" bindtap="switchTagCat">性格</view>
      <view class="adm-filter-btn {{tagFilterCat === 'interest' ? 'on' : ''}}" data-c="interest" bindtap="switchTagCat">兴趣</view>
      <view class="adm-filter-btn {{tagFilterCat === 'mood' ? 'on' : ''}}" data-c="mood" bindtap="switchTagCat">心情</view>
    </view>
    <view class="adm-item" wx:for="{{anonTags}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.name}}</text>
        <text class="adm-item-sub">{{item.category}} · 排序{{item.sortOrder}} · <text class="adm-status {{item.active ? 'adm-status--approved' : 'adm-status--neutral'}}">{{item.active ? '启用' : '停用'}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-name="{{item.name}}" data-sort="{{item.sortOrder}}" bindtap="startEditTag">编辑</button>
        <button size="mini" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleTag">{{item.active ? '停用' : '启用'}}</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteTag">停用</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{anonTags.length === 0}}">暂无标签</view>
    <view class="adm-form" wx:if="{{editingTagId}}">
      <text class="adm-section-title" style="margin:0">编辑标签</text>
      <input class="adm-input" placeholder="标签名（最多 12 字）" maxlength="12" value="{{editingTagName}}" data-field="editingTagName" bindinput="onEditTagInput" />
      <input class="adm-input" type="digit" placeholder="排序" value="{{editingTagSort}}" data-field="editingTagSort" bindinput="onEditTagInput" />
      <view class="adm-search">
        <button class="yt-btn-primary" bindtap="saveTag">保存</button>
        <button class="yt-btn-secondary" bindtap="cancelEditTag">取消</button>
      </view>
    </view>
  </block>

  <!-- 岗位精品 -->
  <block wx:if="{{sub === 'jobs'}}">
    <view class="adm-section-title">岗位列表 ({{jobPosts.length}})</view>
    <view class="adm-item" wx:for="{{jobPosts}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub">{{item.merchantShopName}} · <text class="adm-status {{st.cls(item.status)}}">{{st.text(item.status)}}</text>{{item.urgent ? ' · 急招' : ''}}{{item.featured ? ' · 精品' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{item.status === 'PUBLISHED'}}" size="mini" data-id="{{item.id}}" data-featured="{{item.featured}}" bindtap="toggleJobFeature">{{item.featured ? '取消精品' : '设精品'}}</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{jobPosts.length === 0}}">暂无岗位</view>
  </block>

  <!-- 单价 -->
  <block wx:if="{{sub === 'pricing'}}">
    <view class="adm-section-title">发布单价配置</view>
    <view class="adm-item" wx:for="{{pricing}}" wx:key="duration">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.duration === 'D90' ? '90 天' : '30 天'}}</text>
        <text class="adm-item-sub">¥{{item.price}}</text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{editingDuration !== item.duration}}" size="mini" data-dur="{{item.duration}}" data-price="{{item.price}}" bindtap="startEdit">编辑</button>
      </view>
    </view>
    <view class="adm-edit-row" wx:if="{{editingDuration}}">
      <text>{{editingDuration === 'D90' ? '90天' : '30天'}} 单价：¥</text>
      <input class="adm-price-input" type="digit" value="{{editingPrice}}" bindinput="onPriceInput" />
      <button size="mini" bindtap="savePrice">保存</button>
      <button size="mini" bindtap="cancelEdit">取消</button>
    </view>
  </block>

  <!-- 推广价（内容推广档位） -->
  <block wx:if="{{sub === 'boost'}}">
    <view class="adm-section-title">内容推广档位价格</view>
    <view class="adm-item" wx:for="{{boostPlans}}" wx:key="code">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.name}}</text>
        <text class="adm-item-sub">{{item.durationHours}} 小时 · ¥{{item.price}} · <text class="adm-status {{item.enabled ? 'adm-status--approved' : 'adm-status--neutral'}}">{{item.enabled ? '启用' : '停用'}}</text></text>
      </view>
      <view class="adm-item-actions">
        <button wx:if="{{editingBoostCode !== item.code}}" size="mini" data-code="{{item.code}}" data-price="{{item.price}}" bindtap="startEditBoost">编辑</button>
      </view>
    </view>
    <view class="adm-edit-row" wx:if="{{editingBoostCode}}">
      <text>推广价：¥</text>
      <input class="adm-price-input" type="digit" value="{{editingBoostPrice}}" bindinput="onBoostPriceInput" />
      <button size="mini" bindtap="saveBoostPrice">保存</button>
      <button size="mini" bindtap="cancelEditBoost">取消</button>
    </view>
  </block>

  <!-- 广告位 Banner -->
  <block wx:if="{{sub === 'banner'}}">
    <view class="adm-section-title">新建广告位</view>
    <view class="adm-form">
      <input class="adm-input" placeholder="标题（如：欢迎来到综合大学圈）" value="{{bnTitle}}" data-field="bnTitle" bindinput="onBannerInput" maxlength="50" />
      <view class="adm-upload-row">
        <image wx:if="{{bnImageUrl}}" class="adm-banner-preview" src="{{bnImageUrl}}" mode="aspectFill" />
        <button size="mini" bindtap="chooseBannerImage">{{bnUploading ? '上传中…' : (bnImageUrl ? '更换图片' : '上传图片')}}</button>
      </view>
      <input class="adm-input" placeholder="跳转链接（选填）" value="{{bnLinkUrl}}" data-field="bnLinkUrl" bindinput="onBannerInput" />
      <input class="adm-input" placeholder="排序（数字，越小越靠前）" type="number" value="{{bnSortOrder}}" data-field="bnSortOrder" bindinput="onBannerInput" />
      <button class="yt-btn-primary" bindtap="createBanner">发布</button>
    </view>
    <view class="adm-section-title">广告位列表 ({{banners.length}})</view>
    <view class="adm-item" wx:for="{{banners}}" wx:key="id">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.title}}</text>
        <text class="adm-item-sub">{{item.community ? item.community.name + ' · ' : '全局 · '}}<text class="adm-status {{item.status === 'ENABLED' ? 'adm-status--approved' : 'adm-status--neutral'}}">{{item.status === 'ENABLED' ? '启用' : '停用'}}</text> · 排序 {{item.sortOrder}}</text>
        <image wx:if="{{item.imageUrl}}" class="adm-banner-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
      </view>
      <view class="adm-item-actions">
        <button size="mini" data-id="{{item.id}}" data-enabled="{{item.status === 'ENABLED'}}" bindtap="toggleBanner">{{item.status === 'ENABLED' ? '停用' : '启用'}}</button>
        <button wx:if="{{editingBannerId !== item.id}}" size="mini" data-id="{{item.id}}" data-sort="{{item.sortOrder}}" data-link="{{item.linkUrl}}" bindtap="startEditBanner">编辑</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteBanner">删除</button>
      </view>
    </view>
    <view class="adm-edit-row" wx:if="{{editingBannerId}}">
      <text>排序</text>
      <input class="adm-price-input" type="number" value="{{editingBannerSort}}" data-field="editingBannerSort" bindinput="onEditBannerInput" />
      <text>链接</text>
      <input class="adm-input" value="{{editingBannerLink}}" data-field="editingBannerLink" bindinput="onEditBannerInput" placeholder="跳转链接" />
      <button size="mini" bindtap="saveBanner">保存</button>
      <button size="mini" bindtap="cancelEditBanner">取消</button>
    </view>
    <view class="adm-empty" wx:if="{{banners.length === 0}}">暂无广告位</view>
  </block>

  <!-- 圈子（Community）管理 -->
  <block wx:if="{{sub === 'community'}}">
    <view class="adm-section-title">圈子管理 ({{communities.length}})</view>
    <view class="adm-search-row">
      <input class="adm-input" placeholder="按圈子名称搜索" value="{{cmKeyword}}" bindinput="onCommunitySearch" confirm-type="search" bindconfirm="searchCommunities" />
      <button size="mini" bindtap="searchCommunities">搜索</button>
    </view>
    <view class="adm-filter">
      <view class="adm-filter-btn {{cmStatus === '' ? 'on' : ''}}" data-s="" bindtap="switchCmStatus">全部</view>
      <view class="adm-filter-btn {{cmStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchCmStatus">待审核{{cmPendingCount > 0 ? ' ('+cmPendingCount+')' : ''}}</view>
      <view class="adm-filter-btn {{cmStatus === 'ACTIVE' ? 'on' : ''}}" data-s="ACTIVE" bindtap="switchCmStatus">已通过</view>
      <view class="adm-filter-btn {{cmStatus === 'DISABLED' ? 'on' : ''}}" data-s="DISABLED" bindtap="switchCmStatus">已禁用</view>
    </view>
    <view class="adm-item" wx:for="{{communities}}" wx:key="id">
      <view class="adm-item-main">
        <view class="adm-item-title-row">
          <text class="adm-item-title">{{item.name}}</text>
          <text class="adm-status {{item.status === 'ACTIVE' ? 'adm-status--approved' : item.status === 'PENDING' ? 'adm-status--pending' : 'adm-status--rejected'}}">
            {{item.status === 'ACTIVE' ? '已通过' : item.status === 'PENDING' ? '待审核' : '已禁用'}}
          </text>
        </view>
        <text class="adm-item-sub">成员 {{item.memberCount}} · 动态 {{item.postCount}}{{item.ownerId ? ' · 有圈主' : ''}}{{item.rejectReason ? ' · 拒绝原因: ' + item.rejectReason : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <text wx:if="{{item.id === 'cm_default'}}" class="adm-default-tag">默认圈</text>
        <block wx:elif="{{item.status === 'PENDING'}}">
          <button size="mini" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="approveCommunity">通过</button>
          <button size="mini" type="warn" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="rejectCommunity">拒绝</button>
        </block>
        <button wx:else size="mini" data-id="{{item.id}}" data-disabled="{{item.status === 'DISABLED'}}" bindtap="toggleCommunity">{{item.status === 'DISABLED' ? '启用' : '禁用'}}</button>
      </view>
    </view>
    <view class="adm-empty" wx:if="{{communities.length === 0}}">暂无圈子</view>
  </block>

  <!-- P2-26 全局设置（功能开关）-->
  <block wx:if="{{sub === 'settings'}}">
    <view class="adm-section-title">功能开关</view>
    <view class="adm-item" wx:for="{{appConfigs}}" wx:key="key">
      <view class="adm-item-main">
        <text class="adm-item-title">{{item.key === 'community.need_review' ? '建圈审核' : item.key}}</text>
        <text class="adm-item-sub">{{item.key === 'community.need_review' ? '开启后，用户创建的圈子需审核通过才可使用' : ''}}</text>
      </view>
      <view class="adm-item-actions">
        <switch wx:if="{{item.key === 'community.need_review'}}" checked="{{item.value === true}}" color="#F9C801" disabled="{{togglingNeedReview}}" bindchange="toggleNeedReview" />
      </view>
    </view>
    <view class="adm-empty" wx:if="{{appConfigs.length === 0}}">暂无配置</view>
  </block>
</view>
