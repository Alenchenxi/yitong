@import "../admin-common.wxss";

/* 管理员资料卡（品牌黄，对标商家 auth-card） */
.profile-card {
  background: linear-gradient(135deg, var(--yt-primary-light), var(--yt-primary));
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--yt-text-main);
}
.profile-info { flex: 1; }
.profile-name { font-size: 36rpx; font-weight: 600; color: var(--yt-text-main); }
.profile-badge {
  margin-top: 12rpx;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
  color: var(--yt-text-main);
}

/* 分区 + 菜单（对标商家 profile） */
.profile-section { margin-bottom: 24rpx; }
.profile-section-title { font-size: 26rpx; color: var(--yt-text-sub); margin-bottom: 8rpx; }
.profile-menu {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--yt-text-main);
  border-bottom: 1rpx solid var(--yt-border);
}
.profile-menu:last-child { border-bottom: none; }
.profile-menu text:first-child { flex: 1; }
.profile-arrow { color: var(--yt-text-weak); font-size: 32rpx; }

/* 退出按钮（危险色文字 + 白底描边） */
.profile-logout {
  margin-top: 32rpx;
  background: var(--yt-card) !important;
  color: var(--yt-danger) !important;
  border: 1rpx solid var(--yt-border) !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
}
