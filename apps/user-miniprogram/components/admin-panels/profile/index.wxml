<view class="adm-page">
  <!-- 管理员资料卡 -->
  <view class="profile-card">
    <view class="profile-avatar">{{nickname ? nickname.slice(0,1) : '管'}}</view>
    <view class="profile-info">
      <view class="profile-name">{{nickname || '管理员'}}</view>
      <view class="profile-badge">管理员</view>
    </view>
  </view>

  <!-- 管理入口 -->
  <view class="yt-card profile-section">
    <view class="profile-section-title">管理入口</view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-tab="dashboard"><text>看板</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-tab="review"><text>审核</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-tab="ops"><text>运营</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-tab="users"><text>用户</text><text class="profile-arrow">›</text></view>
  </view>

  <!-- 账号 -->
  <view class="yt-card profile-section">
    <view class="profile-section-title">账号</view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="goAccountSecurity"><text>账号与安全</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="goSettings"><text>设置</text><text class="profile-arrow">›</text></view>
  </view>

  <!-- 关于 -->
  <view class="yt-card profile-section">
    <view class="profile-section-title">关于</view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="openPrivacyGuide"><text>用户隐私保护指引</text><text class="profile-arrow">›</text></view>
  </view>

  <!-- 切换角色 -->
  <view class="yt-card profile-section" wx:if="{{myRoles.length > 1}}">
    <view class="profile-section-title">切换角色</view>
    <view
      wx:for="{{myRoles}}"
      wx:key="*this"
      class="profile-menu {{currentRole === item ? 'adm-role-current' : ''}} {{switchingRole === item ? 'adm-role-switching' : ''}}"
      data-role="{{item}}"
      hover-class="adm-hover"
      catchtap="onSwitchRole"
    >
      <text>{{item === 'USER' ? '👤 用户端' : item === 'MERCHANT' ? '🏪 商家端' : '⚙ 管理端'}}</text>
      <text wx:if="{{currentRole === item}}" style="font-size:22rpx;color:var(--yt-primary-dark);background:var(--yt-primary-light);padding:2rpx 12rpx;border-radius:999rpx;">当前</text>
      <text wx:elif="{{switchingRole === item}}" style="font-size:22rpx;color:var(--yt-text-sub)">切换中…</text>
      <text wx:else class="profile-arrow">›</text>
    </view>
  </view>

  <button class="profile-logout" bindtap="logout">退出登录</button>
</view>
