.page { padding: 0 24rpx 120rpx; }

/* M4-04 订阅授权入口 */
.subscribe-bar {
  padding: 24rpx;
  margin-top: 16rpx;
}
.subscribe-tip { font-size: 24rpx; color: var(--yt-text-sub); margin-bottom: 16rpx; }
.subscribe-actions { display: flex; gap: 16rpx; }
.subscribe-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--yt-primary);
  color: var(--yt-text-main);
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.topbar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.unread-text { font-size: 26rpx; color: var(--yt-danger); font-weight: 600; }
.read-all { font-size: 26rpx; color: var(--yt-info); }

/* M4-01 分类 tab */
.category-tabs {
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
  display: flex;
}
.cat-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--yt-card);
  font-size: 26rpx;
  color: var(--yt-text-sub);
  position: relative;
}
.cat-tab-active {
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-weight: 600;
}
.cat-badge {
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: var(--yt-danger);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  margin-left: 8rpx;
}

.list { margin-top: 8rpx; }
.item { display: flex; background: var(--yt-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; position: relative; }
.item.unread { background: var(--yt-primary-lighter); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--yt-danger); margin-right: 16rpx; margin-top: 8rpx; flex-shrink: 0; }
.main { flex: 1; min-width: 0; }
.title { font-size: 30rpx; font-weight: 600; color: var(--yt-text-main); }
.content { font-size: 26rpx; color: var(--yt-text-body); margin-top: 8rpx; }
.time { font-size: 22rpx; color: var(--yt-text-weak); margin-top: 12rpx; }
.empty { text-align: center; padding-top: 200rpx; color: var(--yt-text-sub); }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
