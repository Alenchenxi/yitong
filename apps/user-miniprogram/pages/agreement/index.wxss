.page { padding: 24rpx; }
.tabs {
  display: flex;
  background: var(--yt-card);
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--yt-text-sub);
}
.tab-active {
  color: var(--yt-text-main);
  font-weight: 600;
  border-bottom: 4rpx solid var(--yt-primary);
}
.content { padding: 32rpx 24rpx; }
.para {
  font-size: 28rpx;
  color: var(--yt-text-body);
  line-height: 1.7;
  margin-bottom: 16rpx;
}
