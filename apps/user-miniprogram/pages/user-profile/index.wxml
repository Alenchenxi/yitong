<view class="page">
  <view class="loading-state" wx:if="{{loading && !profile}}">正在加载...</view>

  <view class="error-state" wx:elif="{{loadFailed && !profile}}">
    <view class="error-title">无法查看该用户</view>
    <view class="error-desc">用户不存在或账号已不可用</view>
    <button class="retry-btn" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:elif="{{profile}}">
    <view class="profile-head">
      <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-ph">{{profile.nickname[0]}}</view>
      <view class="identity">
        <view class="nickname">{{profile.nickname}}</view>
        <view class="identity-label">燚桐用户</view>
      </view>
      <button
        wx:if="{{!profile.isSelf}}"
        class="follow-btn {{profile.following ? 'followed' : ''}}"
        bindtap="toggleFollow"
        loading="{{followLoading}}"
        disabled="{{followLoading}}"
      >{{profile.following ? '已关注' : '关注'}}</button>
    </view>

    <view class="profile-stats">
      <view class="stat"><text class="stat-value">{{profile.postCount}}</text><text class="stat-label">动态</text></view>
      <view class="stat"><text class="stat-value">{{profile.followerCount}}</text><text class="stat-label">粉丝</text></view>
      <view class="stat"><text class="stat-value">{{profile.followingCount}}</text><text class="stat-label">关注</text></view>
    </view>

    <view class="section-title">公开动态</view>
    <view class="post-list" wx:if="{{posts.length > 0}}">
      <post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:like="onLike"></post-card>
      <view class="list-tip" wx:if="{{loadingMore}}">加载中...</view>
      <view class="list-tip" wx:elif="{{!hasMore}}">没有更多了</view>
    </view>
    <view class="empty-posts" wx:elif="{{!loading}}">TA 还没有公开动态</view>
  </block>
</view>
