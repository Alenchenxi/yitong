<view class="page">
  <view class="brand">
    <view class="brand-mark">燚</view>
    <view class="brand-main">
      <view class="logo">燚桐</view>
      <view class="subtitle">统一校园生活平台</view>
    </view>
  </view>

  <view class="section-title">选择进入身份</view>

  <view class="referral-tip" wx:if="{{referralTip}}">{{referralTip}}</view>

  <view class="roles">
    <view
      class="role-card {{pendingRole === 'user' ? 'pending' : ''}}"
      data-role="user"
      bindtap="chooseRole"
    >
      <view class="role-mark">用</view>
      <view class="role-main">
        <view class="role-name">用户端</view>
        <view class="role-desc">表白墙 · 兼职</view>
      </view>
      <view class="role-arrow">›</view>
    </view>

    <view
      class="role-card {{pendingRole === 'merchant' ? 'pending' : ''}}"
      data-role="merchant"
      bindtap="chooseRole"
    >
      <view class="role-mark">商</view>
      <view class="role-main">
        <view class="role-name">商家端</view>
        <view class="role-desc">入驻 · 发岗 · 报名管理</view>
      </view>
      <view class="role-arrow">›</view>
    </view>

    <view
      class="role-card {{pendingRole === 'admin' ? 'pending' : ''}}"
      data-role="admin"
      bindtap="chooseRole"
    >
      <view class="role-mark">管</view>
      <view class="role-main">
        <view class="role-name">管理端</view>
        <view class="role-desc">审核 · 单价 · 封禁</view>
      </view>
      <view class="role-arrow">›</view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">登录中…</view>
</view>
