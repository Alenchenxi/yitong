.page {
  min-height: 100vh;
  padding: 72rpx 32rpx 48rpx;
  background: var(--yt-bg, #F6F7FB);
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.brand-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: var(--yt-primary, #F9C801);
  color: var(--yt-text-main, #1D2129);
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-main {
  flex: 1;
  min-width: 0;
}

.logo {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--yt-text-main, #1D2129);
  letter-spacing: 0;
  line-height: 1.2;
}

.subtitle {
  color: var(--yt-text-sub, #86909C);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--yt-text-main, #1D2129);
  margin-bottom: 20rpx;
}

.referral-tip {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--yt-primary-dark, #C59A00);
  background: var(--yt-primary-lighter, #FFFBEA);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--yt-primary-light, #FFF7D1);
}

.roles {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-card {
  background: var(--yt-card, #FFFFFF);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--yt-border, #E5E6EB);
  transition: transform 0.1s;
}

.role-card:active {
  transform: scale(0.98);
}

.role-card.pending {
  border-color: var(--yt-primary, #F9C801);
  background: var(--yt-primary-lighter, #FFFBEA);
}

.role-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--yt-disabled-bg, #F2F3F5);
  color: var(--yt-text-main, #1D2129);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.role-card.pending .role-mark {
  background: var(--yt-primary, #F9C801);
}

.role-main {
  flex: 1;
  min-width: 0;
}

.role-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--yt-text-main, #1D2129);
}

.role-desc {
  font-size: 24rpx;
  color: var(--yt-text-sub, #86909C);
  margin-top: 6rpx;
}

.role-arrow {
  font-size: 44rpx;
  color: var(--yt-text-weak, #C9CDD4);
  margin-left: 16rpx;
}

.loading {
  text-align: center;
  color: var(--yt-text-sub, #86909C);
  font-size: 26rpx;
  margin-top: 40rpx;
}
