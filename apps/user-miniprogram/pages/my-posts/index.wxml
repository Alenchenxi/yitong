<view class="page">
  <view class="list" wx:if="{{posts.length > 0}}">
    <view class="item" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="content">{{item.content}}</view>
      <view class="meta">
        <text>{{item.timeText}}</text>
        <text class="stats">♥ {{item.likeCount}} · 💬 {{item.commentCount}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-emoji">📝</view>
    <view class="empty-text">还没有发过帖子</view>
  </view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
