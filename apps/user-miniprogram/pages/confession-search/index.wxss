.page { padding: 20rpx 24rpx 40rpx; }
.search-bar {
  display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx;
}
.input {
  flex: 1;
  background: #F2F3F5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
}
.search-btn {
  font-size: 28rpx;
  color: var(--yt-primary, #F9C801);
  font-weight: 600;
}
.tabs {
  display: flex; gap: 32rpx; padding: 12rpx 8rpx; border-bottom: 1rpx solid #eee;
}
.tab { font-size: 28rpx; color: #86909C; padding: 8rpx 0; }
.tab.active { color: #1D2129; font-weight: 600; border-bottom: 4rpx solid var(--yt-primary, #F9C801); }

.section { margin-top: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.section-title { font-size: 26rpx; color: #1D2129; font-weight: 600; }
.section-action { font-size: 24rpx; color: #86909C; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 10rpx 24rpx;
  background: #F7F8FA;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4E5969;
}
.hot-list { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.hot-item { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.hot-item:last-child { border-bottom: none; }
.hot-keyword { font-size: 28rpx; color: #1D2129; }
.hot-count { font-size: 22rpx; color: #C9CDD4; }

.post { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.post-content { font-size: 28rpx; line-height: 1.6; color: #1D2129; word-break: break-word; }
.post-meta { font-size: 22rpx; color: #86909C; margin-top: 12rpx; }

.user { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.u-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #f2f2f2; }
.u-ph {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #ffb3c1, #ff8fa3);
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.u-nick { font-size: 28rpx; color: #1D2129; }

.tag-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.tag-name { font-size: 28rpx; color: #1D2129; font-weight: 500; }
.tag-count { font-size: 22rpx; color: #86909C; }

.empty { text-align: center; color: #C9CDD4; padding: 40rpx 0; font-size: 24rpx; }
.loading { text-align: center; color: #86909C; padding: 24rpx 0; font-size: 24rpx; }
