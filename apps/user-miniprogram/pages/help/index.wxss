.page { padding: 24rpx; }

.search-bar {
  display: flex;
  align-items: center;
  background: var(--yt-card);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 32rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.clear { color: var(--yt-text-weak); font-size: 32rpx; padding: 0 8rpx; }

.cat-list { display: flex; flex-direction: column; gap: 16rpx; }
.cat-card {
  position: relative;
  background: var(--yt-card);
  border-radius: 16rpx;
  padding: 32rpx;
}
.cat-title { font-size: 30rpx; font-weight: 600; color: var(--yt-text-main); margin-bottom: 8rpx; }
.cat-desc { font-size: 24rpx; color: var(--yt-text-sub); padding-right: 40rpx; }
.cat-arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); color: var(--yt-text-weak); font-size: 36rpx; }

.result-title { font-size: 26rpx; color: var(--yt-text-sub); margin-bottom: 16rpx; }
.result-list { display: flex; flex-direction: column; gap: 16rpx; }
.result-item {
  background: var(--yt-card);
  border-radius: 12rpx;
  padding: 24rpx;
}
.result-q { font-size: 28rpx; font-weight: 600; color: var(--yt-text-main); margin-bottom: 12rpx; }
.result-a { font-size: 26rpx; color: var(--yt-text-body); line-height: 1.6; }
.empty { text-align: center; color: var(--yt-text-weak); padding: 80rpx 0; font-size: 26rpx; }
