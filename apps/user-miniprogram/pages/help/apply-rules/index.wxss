.page { padding: 24rpx; }
.faq-item {
  background: var(--yt-card);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.faq-q { font-size: 28rpx; font-weight: 600; color: var(--yt-text-main); margin-bottom: 12rpx; }
.faq-a { font-size: 26rpx; color: var(--yt-text-body); line-height: 1.6; }
.empty { text-align: center; color: var(--yt-text-weak); padding: 80rpx 0; font-size: 26rpx; }
