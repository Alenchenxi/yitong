<view class="page">
  <view class="search-bar">
    <input class="search-input" value="{{keyword}}" placeholder="搜索问题" bindinput="onInput" />
    <text class="clear" wx:if="{{keyword}}" bindtap="clearInput">✕</text>
  </view>

  <block wx:if="{{!searching}}">
    <view class="cat-list">
      <view class="cat-card" wx:for="{{categories}}" wx:key="id" data-path="{{item.path}}" bindtap="goCategory">
        <view class="cat-title">{{item.title}}</view>
        <view class="cat-desc">{{item.desc}}</view>
        <text class="cat-arrow">›</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="result-title">搜索结果（{{searchResults.length}}）</view>
    <view class="result-list" wx:if="{{searchResults.length > 0}}">
      <view class="result-item" wx:for="{{searchResults}}" wx:key="id" data-id="{{item.id}}" bindtap="tapResult">
        <view class="result-q">{{item.q}}</view>
        <view class="result-a">{{item.a}}</view>
      </view>
    </view>
    <view class="empty" wx:else>未找到相关问题</view>
  </block>
</view>
