<view class="page">
  <!-- 圈子动态上方统一为一个沉浸式容器；背景图来自当前圈子 -->
  <view class="community-header {{community.backgroundImage ? 'has-background' : ''}}">
    <image wx:if="{{community.backgroundImage}}" class="community-background" src="{{community.backgroundImage}}" mode="aspectFill" />

    <!-- 自定义导航：圈子切换与搜索直接占用原标题区域，并避开微信胶囊 -->
    <view class="topbar" style="padding-top: {{navTop}}px;">
      <view class="topbar-actions" style="height: {{navHeight}}px; padding-right: {{navRight}}px;">
        <view class="header-actions">
          <view class="circle-switch" bindtap="goSwitch">
            <image wx:if="{{community.logo}}" class="cs-logo" src="{{community.logo}}" mode="aspectFill" />
            <text wx:else class="cs-logo cs-logo-fallback">{{community ? community.name[0] : '圈'}}</text>
            <text class="cs-name" wx:if="{{community}}">{{community.name}}</text>
            <text class="cs-arrow">▾</text>
          </view>
          <view class="search-box" bindtap="goSearch">
            <text class="search-icon">⌕</text>
            <text class="search-ph">搜索圈内内容</text>
          </view>
        </view>
      </view>
    </view>

    <view class="community-header-content">
      <!-- 当前圈子信息；右侧改为菜单图标 -->
      <view class="community-card">
        <image wx:if="{{community.logo}}" class="c-logo" src="{{community.logo}}" mode="aspectFill" />
        <view wx:else class="c-logo c-logo-fallback">{{community ? community.name[0] : '圈'}}</view>
        <view class="c-info" wx:if="{{community}}">
          <view class="c-name">{{community.name}}</view>
          <view class="c-stats">动态 {{community.postCount}} · 圈友 {{community.memberCount}}</view>
          <view class="c-description" wx:if="{{community.description}}">{{community.description}}</view>
        </view>
        <view
          class="c-menu"
          wx:if="{{community}}"
          bindtap="showCommunityMenu"
          aria-role="button"
          aria-label="打开圈子菜单"
        >
          <image class="c-menu-icon" src="/assets/icons/community-menu.svg" mode="aspectFit" />
        </view>
        <view class="c-info c-empty" wx:else bindtap="goCommunityList">
          <view class="c-name">未加入圈子</view>
          <view class="c-stats">点击选择或创建圈子</view>
        </view>
      </view>

      <!-- 公告、Banner、今日上头均在同一大容器内，不再使用独立纯色卡片 -->
      <view class="announce-bar" wx:if="{{announcements.length > 0}}">
        <swiper class="announce-swiper" autoplay circular interval="4000" vertical>
          <swiper-item wx:for="{{announcements}}" wx:key="id">
            <text class="announce-text">公告 · {{item.title}}：{{item.content}}</text>
          </swiper-item>
        </swiper>
      </view>

      <view class="banner-wrap" wx:if="{{banners.length > 0}}">
        <swiper class="banner-swiper" autoplay circular interval="4000" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ffffff">
          <swiper-item wx:for="{{banners}}" wx:key="id">
            <image class="banner-img" src="{{item.imageUrl}}" mode="aspectFill" />
          </swiper-item>
        </swiper>
      </view>

      <view class="hot-section" wx:if="{{todayHit.length > 0}}">
        <view class="hot-title">今日上头</view>
        <scroll-view class="hot-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view
            class="hot-item"
            wx:for="{{todayHit}}"
            wx:key="data.id"
            data-id="{{item.data.id}}"
            data-kind="{{item.kind}}"
            bindtap="goTodayHit"
          >
            <view class="hot-rank">{{index + 1}}</view>
            <view class="hot-info">
              <view class="hot-badge">{{item.kind === 'anon_post' ? '树洞' : '表白墙'}}</view>
              <view class="hot-content">{{item.data.content}}</view>
              <view class="hot-views">浏览 {{item.viewCount}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 圈子菜单：先展示当前圈子信息，再提供邀请与退出 -->
  <view wx:if="{{menuVisible}}" class="menu-mask" bindtap="hideCommunityMenu" catchtouchmove="stopMenuTap">
    <view class="menu-sheet" catchtap="stopMenuTap">
      <view class="sheet-handle"></view>
      <view class="sheet-community">
        <image wx:if="{{community.logo}}" class="sheet-logo" src="{{community.logo}}" mode="aspectFill" />
        <view wx:else class="sheet-logo sheet-logo-fallback">{{community.name[0]}}</view>
        <view class="sheet-info">
          <view class="sheet-name">{{community.name}}</view>
          <view class="sheet-stats">{{community.memberCount}} 位圈友 · {{community.postCount}} 条动态</view>
          <view class="sheet-description">{{community.description || community.location || '欢迎来到这个圈子'}}</view>
        </view>
      </view>
      <view class="sheet-actions">
        <button class="sheet-action" open-type="share" bindtap="hideCommunityMenu">
          <view class="sheet-action-icon share-icon">↗</view>
          <view class="sheet-action-text">
            <view class="sheet-action-title">邀请好友</view>
            <view class="sheet-action-sub">好友打开后自动加入并切换到这里</view>
          </view>
          <view class="sheet-action-arrow">›</view>
        </button>
        <button class="sheet-action leave-action" bindtap="confirmLeaveCommunity">
          <view class="sheet-action-icon leave-icon">↪</view>
          <view class="sheet-action-text">
            <view class="sheet-action-title leave-title">退出圈子</view>
            <view class="sheet-action-sub">退出后可重新选择或加入圈子</view>
          </view>
          <view class="sheet-action-arrow">›</view>
        </button>
      </view>
      <view class="sheet-safe"></view>
    </view>
  </view>

  <!-- 4 tab：圈子动态 / 表白墙 / 树洞 / 兼职 -->
  <view class="main-tabs">
    <view class="main-tab {{activeTab === 'dynamic' ? 'active' : ''}}" data-tab="dynamic" bindtap="switchTab">圈子动态</view>
    <view class="main-tab {{activeTab === 'confession' ? 'active' : ''}}" data-tab="confession" bindtap="switchTab">表白墙</view>
    <view class="main-tab {{activeTab === 'treehole' ? 'active' : ''}}" data-tab="treehole" bindtap="switchTab">树洞</view>
    <view class="main-tab {{activeTab === 'job' ? 'active' : ''}}" data-tab="job" bindtap="switchTab">兼职</view>
  </view>

  <!-- 混合流 / 各 tab 列表：按 kind 分发 -->
  <view class="list" wx:if="{{items.length > 0}}">
    <block wx:for="{{items}}" wx:key="data.id">
      <!-- 表白墙帖：post-card 内部 onTap 跳详情 -->
      <view wx:if="{{item.kind === 'post'}}" class="feed-item">
        <post-card post="{{item.data}}" bind:like="onLike"></post-card>
      </view>
      <!-- 树洞帖：匿名卡降级，父级 bindtap 分发跳树洞详情 -->
      <view wx:elif="{{item.kind === 'anon_post'}}" class="feed-item" data-id="{{item.data.id}}" data-kind="anon_post" bindtap="goPostDetail">
        <post-card
          post="{{item.data}}"
          anonymous="{{true}}"
          disabled="{{!anonTokenReady}}"
          disabledReason="请前往树洞签发匿名身份后互动"
          bind:like="onLike"
          bind:author="goAnonAuthor"
        ></post-card>
      </view>
      <!-- 兼职岗：job-card 内部 onTap 跳岗位详情 -->
      <view wx:elif="{{item.kind === 'job_post'}}" class="feed-item">
        <job-card job="{{item.data}}"></job-card>
      </view>
    </block>
    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    <view class="loading-tip" wx:elif="{{!hasMore}}">没有更多了</view>
  </view>

  <view class="yt-empty" wx:elif="{{!loading}}">
    <view class="yt-empty-emoji">📭</view>
    <view class="yt-empty-text">还没有内容，去发第一条吧</view>
  </view>

  <!-- 悬浮发帖 -->
  <view class="fab" bindtap="goCreate">
    <text class="fab-plus">＋</text>
  </view>
</view>
