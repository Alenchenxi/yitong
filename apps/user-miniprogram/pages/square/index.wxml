<view class="page">
  <!-- 顶部搜索：左侧切换按钮（当前圈子） + 搜索栏 -->
  <view class="topbar">
    <view class="circle-switch" bindtap="goSwitch">
      <image wx:if="{{community.logo}}" class="cs-logo" src="{{community.logo}}" mode="aspectFill" />
      <text wx:else class="cs-logo cs-logo-fallback">{{community ? community.name[0] : '圈'}}</text>
      <text class="cs-name" wx:if="{{community}}">{{community.name}}</text>
      <text class="cs-arrow">▾</text>
    </view>
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-ph">找人或搜索内容</text>
    </view>
  </view>

  <!-- 圈子头卡：LOGO + 名称 + 动态数/成员数（点击进圈子列表/切换） -->
  <view class="community-card yt-card" bindtap="goCommunityList">
    <image wx:if="{{community.logo}}" class="c-logo" src="{{community.logo}}" mode="aspectFill" />
    <view wx:else class="c-logo c-logo-fallback">{{community ? community.name[0] : '圈'}}</view>
    <view class="c-info" wx:if="{{community}}">
      <view class="c-name">{{community.name}}</view>
      <view class="c-stats">动态 {{community.postCount}} · 成员 {{community.memberCount}}</view>
    </view>
    <view class="c-switch" wx:if="{{community}}">切换 ›</view>
    <view class="c-info c-empty" wx:else>
      <view class="c-name">未加入圈子</view>
      <view class="c-stats">点击选择或创建圈子</view>
    </view>
  </view>

  <!-- 公告栏 -->
  <view class="announce-bar" wx:if="{{announcements.length > 0}}">
    <swiper class="announce-swiper" autoplay circular interval="4000" vertical>
      <swiper-item wx:for="{{announcements}}" wx:key="id">
        <text class="announce-text">📢 {{item.title}}：{{item.content}}</text>
      </swiper-item>
    </swiper>
  </view>

  <!-- 广告位轮播（Banner，圈子 + 全局） -->
  <view class="banner-wrap" wx:if="{{banners.length > 0}}">
    <swiper class="banner-swiper" autoplay circular interval="4000" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <image class="banner-img" src="{{item.imageUrl}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 今日上头：近24h 浏览量 Top10 横向滚动 -->
  <view class="hot-section" wx:if="{{todayHit.length > 0}}">
    <view class="hot-title">⚡ 今日上头</view>
    <scroll-view class="hot-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="hot-item"
        wx:for="{{todayHit}}"
        wx:key="data.id"
        data-id="{{item.data.id}}"
        data-kind="{{item.kind}}"
        bindtap="goTodayHit"
      >
        <view class="hot-rank">{{index + 1}}</view>
        <view class="hot-info">
          <view class="hot-badge">{{item.kind === 'anon_post' ? '树洞' : '表白墙'}}</view>
          <view class="hot-content">{{item.data.content}}</view>
          <view class="hot-views">👀 {{item.viewCount}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 4 tab：圈子动态 / 表白墙 / 树洞 / 兼职 -->
  <view class="main-tabs">
    <view class="main-tab {{activeTab === 'dynamic' ? 'active' : ''}}" data-tab="dynamic" bindtap="switchTab">圈子动态</view>
    <view class="main-tab {{activeTab === 'confession' ? 'active' : ''}}" data-tab="confession" bindtap="switchTab">表白墙</view>
    <view class="main-tab {{activeTab === 'treehole' ? 'active' : ''}}" data-tab="treehole" bindtap="switchTab">树洞</view>
    <view class="main-tab {{activeTab === 'job' ? 'active' : ''}}" data-tab="job" bindtap="switchTab">兼职</view>
  </view>

  <!-- 混合流 / 各 tab 列表：按 kind 分发 -->
  <view class="list" wx:if="{{items.length > 0}}">
    <block wx:for="{{items}}" wx:key="data.id">
      <!-- 表白墙帖：post-card 内部 onTap 跳详情 -->
      <view wx:if="{{item.kind === 'post'}}" class="feed-item">
        <post-card post="{{item.data}}" bind:like="onLike"></post-card>
      </view>
      <!-- 树洞帖：匿名卡降级，父级 bindtap 分发跳树洞详情 -->
      <view wx:elif="{{item.kind === 'anon_post'}}" class="feed-item" data-id="{{item.data.id}}" data-kind="anon_post" bindtap="goPostDetail">
        <post-card
          post="{{item.data}}"
          anonymous="{{true}}"
          disabled="{{!anonTokenReady}}"
          disabledReason="请前往树洞签发匿名身份后互动"
          bind:like="onLike"
        ></post-card>
      </view>
      <!-- 兼职岗：job-card 内部 onTap 跳岗位详情 -->
      <view wx:elif="{{item.kind === 'job_post'}}" class="feed-item">
        <job-card job="{{item.data}}"></job-card>
      </view>
    </block>
    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    <view class="loading-tip" wx:elif="{{!hasMore}}">没有更多了</view>
  </view>

  <view class="yt-empty" wx:elif="{{!loading}}">
    <view class="yt-empty-emoji">📭</view>
    <view class="yt-empty-text">还没有内容，去发第一条吧</view>
  </view>

  <!-- 悬浮发帖 -->
  <view class="fab" bindtap="goCreate">
    <text class="fab-plus">＋</text>
  </view>
</view>
