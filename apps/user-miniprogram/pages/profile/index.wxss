.page { padding: 24rpx; }

/* 身份卡 */
.profile-card {
  background: linear-gradient(135deg, var(--yt-primary-light), var(--yt-primary));
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.6);
}
.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--yt-text-main);
}
.info { flex: 1; }
.nickname { font-size: 36rpx; font-weight: 600; color: var(--yt-text-main); }
.role-badge { margin-top: 12rpx; }

/* 分区卡片 */
.section { margin-bottom: 24rpx; }
.section-title { font-size: 26rpx; color: var(--yt-text-sub); margin-bottom: 16rpx; }

/* 菜单项 */
.menu-item {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--yt-text-main);
  border-bottom: 1rpx solid var(--yt-border);
}
.menu-item:last-child { border-bottom: none; }
.menu-item text:first-child { flex: 1; }
.badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--yt-danger);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  margin-right: 16rpx;
}
.arrow { color: var(--yt-text-weak); font-size: 32rpx; }

/* 退出按钮 */
.logout-btn {
  margin-top: 32rpx;
  background: var(--yt-card) !important;
  color: var(--yt-danger) !important;
  border: 1rpx solid var(--yt-border) !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
}
