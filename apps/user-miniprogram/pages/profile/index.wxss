.page { padding: 40rpx 24rpx; }
.header {
  background: linear-gradient(135deg, #ffb3c1, #ff4d6d);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
  margin-bottom: 32rpx;
}
.avatar {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
}
.avatar-ph {
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 600;
}
.nick-wrap { flex: 1; }
.nickname { font-size: 36rpx; font-weight: 600; }
.role-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 20rpx;
  font-size: 22rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title { font-size: 26rpx; color: #999; margin-bottom: 16rpx; }
.role-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.role-item {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #555;
}
.role-item.current { background: #ff4d6d; color: #fff; font-weight: 600; }

.menu { background: #fff; border-radius: 16rpx; overflow: hidden; }
.menu-item {
  padding: 28rpx 32rpx;
  display: flex; justify-content: space-between; align-items: center;
  font-size: 28rpx; color: #333;
  border-bottom: 1rpx solid #f4f4f4;
}
.menu-item:last-child { border-bottom: none; }
.arrow { color: #bbb; font-size: 32rpx; }

.logout-btn {
  margin-top: 48rpx;
  background: #fff !important;
  color: #ff4d6d !important;
  border-radius: 48rpx !important;
  font-size: 28rpx !important;
}
.logout-btn::after { border: 1rpx solid #ffd0d8 !important; }
