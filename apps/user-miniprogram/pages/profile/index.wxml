<view class="page">
  <!-- 身份卡 -->
  <view class="profile-card">
    <image wx:if="{{user && user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="avatar avatar-ph">{{avatarChar}}</view>
    <view class="info">
      <view class="nickname">{{user ? user.nickname : '未登录'}}</view>
      <view class="role-badge yt-tag-accent">{{roleText}}</view>
    </view>
  </view>

  <!-- 切换角色 -->
  <view class="section yt-card">
    <view class="section-title">切换角色</view>
    <view class="role-grid">
      <view
        wx:for="{{roleOptions}}"
        wx:key="key"
        class="role-cell {{currentRole === item.key ? 'role-current' : ''}} {{myRoles.indexOf(item.key) < 0 ? 'role-off' : ''}} {{switchingRole === item.key ? 'role-switching' : ''}}"
        data-role="{{item.key}}"
        bindtap="switchToRole"
      >
        <text class="role-emoji">{{item.emoji}}</text>
        <text class="role-label">{{item.label}}</text>
        <text class="role-desc">{{item.desc}}</text>
        <text class="role-tag" wx:if="{{currentRole === item.key}}">当前</text>
        <text class="role-tag role-tag-off" wx:elif="{{myRoles.indexOf(item.key) < 0}}">无权限</text>
      </view>
    </view>
  </view>

  <!-- 我的内容 -->
  <view class="section yt-card">
    <view class="section-title">我的内容</view>
    <view class="menu-item" bindtap="goMyPosts"><text>我的表白墙</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goMyJobs"><text>我的兼职</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goFavorites"><text>我的收藏</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goFollowing"><text>我的关注</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goFollowers"><text>我的粉丝</text><text class="arrow">›</text></view>
  </view>

  <!-- 账号 -->
  <view class="section yt-card">
    <view class="section-title">账号</view>
    <view class="menu-item" bindtap="goNotifications"><text>消息中心</text><text wx:if="{{unreadCount > 0}}" class="badge">{{unreadCount}}</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goReferral"><text>邀请好友</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goResume"><text>我的简历</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goAccountSecurity"><text>账号与安全</text><text class="arrow">›</text></view>
    <view class="menu-item" wx:if="{{currentRole === 'ADMIN'}}" bindtap="goAdmin"><text>管理后台</text><text class="arrow">›</text></view>
  </view>

  <!-- 关于 -->
  <view class="section yt-card">
    <view class="section-title">关于</view>
    <view class="menu-item" bindtap="goFeedback"><text>意见反馈</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goHelp"><text>帮助中心</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goSettings"><text>设置</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="openPrivacyGuide"><text>用户隐私保护指引</text><text class="arrow">›</text></view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>
