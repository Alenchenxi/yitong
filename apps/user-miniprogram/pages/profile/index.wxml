<view class="page">
  <view class="header">
    <image wx:if="{{user && user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="avatar avatar-ph">{{avatarChar}}</view>
    <view class="nickname">{{user ? user.nickname : '未登录'}}</view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goMyPosts">
      <text>我的表白墙</text><text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text>我的树洞</text><text class="arrow">›</text>
    </view>
    <view class="menu-item">
      <text>我的兼职</text><text class="arrow">›</text>
    </view>
  </view>
</view>
