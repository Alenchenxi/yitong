<view class="page">
  <!-- 顶部搜索 + 发布 -->
  <view class="topbar">
    <view class="search-box" bindtap="goSearch">
      <text class="search-icon">🔍</text>
      <text class="search-ph">搜索帖子/用户</text>
    </view>
    <view class="publish-btn" bindtap="goCreate">发布</view>
  </view>

  <!-- 公告栏（运营位） -->
  <view class="announce-bar" wx:if="{{announcements.length > 0}}">
    <swiper class="announce-swiper" autoplay circular interval="4000" vertical>
      <swiper-item wx:for="{{announcements}}" wx:key="id">
        <text class="announce-text">📢 {{item.title}}：{{item.content}}</text>
      </swiper-item>
    </swiper>
  </view>

  <!-- P2-01 置顶最热帖子（横向滚动前十条） -->
  <view class="hot-top" wx:if="{{hotTop.length > 0}}">
    <view class="section-label"><text class="section-emoji">🔥</text>最热</view>
    <scroll-view scroll-x class="hot-scroll" enhanced show-scrollbar="{{false}}">
      <view class="hot-card" wx:for="{{hotTop}}" wx:key="id" data-id="{{item.id}}" bindtap="goPostDetail">
        <view class="hot-rank">{{index + 1}}</view>
        <view class="hot-content">
          <text class="hot-text">{{item.content}}</text>
          <view class="hot-meta">
            <text class="hot-author">{{item.isAnonymous ? (item.authorNickname || '匿名') : item.authorNickname}}</text>
            <text class="hot-likes">♡ {{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- P2-02 今日上头运营区（横向滚动 + 查看更多） -->
  <view class="today-hit" wx:if="{{todayHit.length > 0}}">
    <view class="section-label">
      <text><text class="section-emoji">⚡</text>今日上头</text>
      <text class="section-more" bindtap="goTodayHit">查看更多 ›</text>
    </view>
    <scroll-view scroll-x class="hot-scroll" enhanced show-scrollbar="{{false}}">
      <view class="hot-card today-card" wx:for="{{todayHit}}" wx:key="id" data-id="{{item.id}}" bindtap="goPostDetail">
        <view class="hot-content">
          <text class="hot-text">{{item.content}}</text>
          <view class="hot-meta">
            <text class="hot-author">{{item.isAnonymous ? (item.authorNickname || '匿名') : item.authorNickname}}</text>
            <text class="hot-likes">♡ {{item.likeCount}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 主 tab：推荐/最新/热门/关注 -->
  <view class="main-tabs">
    <view class="main-tab {{activeMainTab === 'recommend' ? 'active' : ''}}" data-tab="recommend" bindtap="switchMainTab">推荐</view>
    <view class="main-tab {{activeMainTab === 'latest' ? 'active' : ''}}" data-tab="latest" bindtap="switchMainTab">最新</view>
    <view class="main-tab {{activeMainTab === 'hot' ? 'active' : ''}}" data-tab="hot" bindtap="switchMainTab">热门</view>
    <view class="main-tab {{activeMainTab === 'follow' ? 'active' : ''}}" data-tab="follow" bindtap="switchMainTab">关注</view>
  </view>

  <!-- 帖子流 -->
  <view class="list" wx:if="{{posts.length > 0}}">
    <post-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:like="onLike"></post-card>
    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    <view class="loading-tip" wx:elif="{{!hasMore}}">没有更多了</view>
  </view>

  <view class="yt-empty" wx:elif="{{!loading}}">
    <view class="yt-empty-emoji">📭</view>
    <view class="yt-empty-text">还没有内容，去发第一条吧</view>
  </view>

  <!-- 悬浮发帖 -->
  <view class="fab" bindtap="goCreate">
    <text class="fab-plus">＋</text>
  </view>
</view>
