.page { padding: 0 0 120rpx; }
.hint { padding: 20rpx 24rpx; font-size: 24rpx; color: var(--yt-text-sub); }
.list { padding: 0 24rpx; }
.loading-tip { text-align: center; color: var(--yt-text-sub); font-size: 24rpx; padding: 24rpx 0; }
.yt-empty { text-align: center; padding-top: 200rpx; }
.yt-empty-emoji { font-size: 80rpx; }
.yt-empty-text { font-size: 26rpx; color: var(--yt-text-sub); margin-top: 16rpx; }
