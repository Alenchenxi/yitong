<view class="page">
  <view class="topic-item" wx:for="{{topics}}" wx:key="id" data-id="{{item.id}}" bindtap="goTopic">
    <view class="topic-hash">#</view>
    <view class="info">
      <view class="name">{{item.name}}</view>
      <view class="meta">
        <text class="desc" wx:if="{{item.description}}">{{item.description}}</text>
        <text class="count">{{item.postCount}} 篇内容</text>
      </view>
    </view>
  </view>
  <view class="yt-empty" wx:if="{{!loading && topics.length === 0}}">
    <view class="yt-empty-emoji">💬</view>
    <view class="yt-empty-text">暂无话题</view>
  </view>
</view>
