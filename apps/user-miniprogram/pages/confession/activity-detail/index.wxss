.page { padding: 0 0 120rpx; }
.header { padding: 24rpx; background: var(--yt-card); border-bottom: 1rpx solid var(--yt-border); }
.cover { width: 100%; height: 300rpx; border-radius: 16rpx; margin-bottom: 16rpx; }
.title { font-size: 34rpx; font-weight: 600; color: var(--yt-text-main); }
.desc { font-size: 26rpx; color: var(--yt-text-sub); margin-top: 12rpx; line-height: 1.6; }
.list { padding: 16rpx 24rpx; }
.yt-empty { text-align: center; padding-top: 200rpx; }
.yt-empty-emoji { font-size: 80rpx; }
.yt-empty-text { font-size: 26rpx; color: var(--yt-text-sub); margin-top: 16rpx; }
