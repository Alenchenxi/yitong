.page { padding: 0 0 120rpx; }

/* 顶部搜索 + 发布 */
.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--yt-card);
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--yt-border);
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--yt-disabled-bg);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.search-icon { font-size: 24rpx; }
.search-ph { font-size: 26rpx; color: var(--yt-text-sub); }
.publish-btn {
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 公告栏 */
.announce-bar {
  background: var(--yt-primary-lighter);
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.announce-swiper { height: 40rpx; }
.announce-text { font-size: 24rpx; color: var(--yt-primary-dark); line-height: 40rpx; }

/* P2-01/P2-02 最热条 + 今日上头 */
.hot-top, .today-hit { margin: 20rpx 0 0; }
.section-label {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 24rpx 12rpx; font-size: 28rpx; font-weight: 600; color: var(--yt-text-main);
}
.section-emoji { margin-right: 8rpx; }
.section-more { font-size: 24rpx; font-weight: 400; color: var(--yt-text-sub); }
.hot-scroll { white-space: nowrap; padding: 0 16rpx 4rpx; }
.hot-card {
  display: inline-flex; align-items: flex-start; gap: 12rpx;
  width: 440rpx; margin: 0 8rpx; padding: 20rpx;
  background: var(--yt-card); border-radius: 16rpx;
  vertical-align: top; white-space: normal; box-sizing: border-box;
}
.today-card { width: 380rpx; background: var(--yt-primary-lighter); }
.hot-rank {
  flex-shrink: 0; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  border-radius: 8rpx; background: var(--yt-primary); color: var(--yt-text-main);
  font-size: 24rpx; font-weight: 700;
}
.hot-content { flex: 1; min-width: 0; }
.hot-text {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  overflow: hidden; font-size: 26rpx; color: var(--yt-text-main); line-height: 1.5;
}
.hot-meta { display: flex; justify-content: space-between; margin-top: 12rpx; }
.hot-author { font-size: 22rpx; color: var(--yt-text-sub); max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hot-likes { font-size: 22rpx; color: var(--yt-primary-dark); }

/* P2-03/P2-04 运营入口 */
.ops-entry { display: flex; gap: 16rpx; padding: 16rpx 24rpx 0; }
.ops-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 24rpx 0; background: var(--yt-card); border-radius: 16rpx; border: 1rpx solid var(--yt-border); }
.ops-emoji { font-size: 44rpx; }
.ops-text { font-size: 24rpx; color: var(--yt-text-main); }

/* 主 tab */
.main-tabs {
  display: flex;
  gap: 40rpx;
  padding: 16rpx 24rpx;
  background: var(--yt-card);
  position: sticky;
  top: 96rpx;
  z-index: 9;
}
.main-tab {
  font-size: 28rpx;
  color: var(--yt-text-sub);
  padding: 8rpx 0;
  position: relative;
}
.main-tab.active { color: var(--yt-text-main); font-weight: 600; }
.main-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 32rpx;
  height: 4rpx;
  background: var(--yt-primary);
  border-radius: 2rpx;
}

/* 帖子流 */
.list { padding: 16rpx 24rpx; }
.loading-tip { text-align: center; color: var(--yt-text-sub); font-size: 24rpx; padding: 24rpx 0; }

/* 悬浮发帖按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  background: var(--yt-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(249, 200, 1, 0.4);
  z-index: 20;
}
.fab-plus { font-size: 48rpx; color: var(--yt-text-main); font-weight: 300; line-height: 1; }
