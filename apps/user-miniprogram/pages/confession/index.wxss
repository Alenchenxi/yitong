.page { padding: 0 0 calc(120rpx + env(safe-area-inset-bottom)); }

/* 顶部搜索 + 发布 */
.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--yt-card);
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--yt-border);
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--yt-disabled-bg);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.search-icon { font-size: 24rpx; }
.search-ph { font-size: 26rpx; color: var(--yt-text-sub); }
.publish-btn {
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 公告栏 */
.announce-bar {
  background: var(--yt-primary-lighter);
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.announce-swiper { height: 40rpx; }
.announce-text { font-size: 24rpx; color: var(--yt-primary-dark); line-height: 40rpx; }

/* 主 tab */
.main-tabs {
  display: flex;
  gap: 40rpx;
  padding: 16rpx 24rpx;
  background: var(--yt-card);
  position: sticky;
  top: 96rpx;
  z-index: 9;
}
.main-tab {
  font-size: 28rpx;
  color: var(--yt-text-sub);
  padding: 8rpx 0;
  position: relative;
}
.main-tab.active { color: var(--yt-text-main); font-weight: 600; }
.main-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 32rpx;
  height: 4rpx;
  background: var(--yt-primary);
  border-radius: 2rpx;
}

/* 帖子流 */
.list { padding: 16rpx 24rpx; }
.loading-tip { text-align: center; color: var(--yt-text-sub); font-size: 24rpx; padding: 24rpx 0; }

/* 悬浮发帖按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  background: var(--yt-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(249, 200, 1, 0.4);
  z-index: 20;
}
.fab-plus { font-size: 48rpx; color: var(--yt-text-main); font-weight: 300; line-height: 1; }
