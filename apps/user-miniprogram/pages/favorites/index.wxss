.page { padding: 24rpx; padding-bottom: 120rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.tab { padding: 10rpx 24rpx; border-radius: 40rpx; background: #fff; font-size: 24rpx; color: #666; }
.tab.active { background: #ff4d6d; color: #fff; font-weight: 600; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 12rpx; padding: 24rpx; }
.item-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.type-tag { display: inline-block; width: fit-content; padding: 4rpx 12rpx; border-radius: 8rpx; background: #fff8e6; color: #d48806; font-size: 22rpx; }
.item-id { font-size: 22rpx; color: #999; word-break: break-all; }
.item-time { font-size: 22rpx; color: #bbb; }
.item-actions { flex-shrink: 0; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }