<view class="page">
  <!-- 圈子选择 -->
  <view class="row" bindtap="openCirclePicker">
    <text class="label">圈子</text>
    <view class="value">
      <text>{{selectedCircleName}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 正文 + 表情入口 -->
  <view class="textarea-wrap">
    <textarea
      class="textarea"
      placeholder="{{isAnonymous ? '匿名写下你想分享的内容…' : '写下你想分享的内容…'}}"
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="{{2000}}"
      auto-height
      show-confirm-bar="{{false}}"
      adjust-position
    ></textarea>
    <view class="emoji-toggle {{showEmoji ? 'active' : ''}}" catchtap="toggleEmoji">😊</view>
  </view>

  <!-- 表情面板 -->
  <view class="emoji-panel" wx:if="{{showEmoji}}">
    <view
      class="emoji-item"
      wx:for="{{emojis}}"
      wx:key="*this"
      data-emoji="{{item}}"
      bindtap="insertEmoji"
    >{{item}}</view>
  </view>

  <!-- 媒体：图片或视频（互斥） -->
  <view class="images" wx:if="{{!video}}">
    <view class="img-box" wx:for="{{images}}" wx:key="*this">
      <image class="img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage"></image>
      <view class="img-del" data-idx="{{index}}" catchtap="removeImage">×</view>
    </view>
    <view class="img-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">
      <text class="plus">＋</text>
      <text class="add-tip">图片</text>
    </view>
    <view class="img-add" wx:if="{{images.length === 0}}" bindtap="chooseVideo">
      <text class="plus">▶</text>
      <text class="add-tip">视频</text>
    </view>
  </view>

  <view class="video-box" wx:if="{{video}}">
    <video class="video" src="{{video.localPath}}" poster="{{video.coverLocalPath}}" object-fit="cover" controls></video>
    <view class="img-del video-del" catchtap="removeVideo">×</view>
  </view>

  <!-- 标签 -->
  <view class="section">
    <view class="section-title">标签 <text class="section-tip">{{tagCount}}/{{5}}</text></view>
    <view class="tags">
      <view
        class="tag {{item.selected ? 'tag-on' : ''}}"
        wx:for="{{tags}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="toggleTag"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 匿名 -->
  <view class="row">
    <view class="anon-label">
      <text class="label">匿名发布</text>
      <text class="anon-tip">{{isAnonymous ? '将隐藏真实身份' : '默认显示昵称'}}</text>
    </view>
    <switch checked="{{isAnonymous}}" bindchange="toggleAnonymous" color="#F9C801" disabled="{{visibility !== 'PUBLIC'}}" />
  </view>

  <!-- P1-11 可见性：公开 / 私密 / 草稿 -->
  <view class="section">
    <view class="section-title">发布到</view>
    <view class="visibility-row">
      <text class="visibility-btn {{visibility === 'PUBLIC' ? 'on' : ''}}" data-visibility="PUBLIC" catchtap="setVisibility">公开</text>
      <text class="visibility-btn {{visibility === 'PRIVATE' ? 'on' : ''}}" data-visibility="PRIVATE" catchtap="setVisibility">仅自己可见（私密）</text>
      <text class="visibility-btn {{visibility === 'DRAFT' ? 'on' : ''}}" data-visibility="DRAFT" catchtap="setVisibility">草稿</text>
    </view>
    <view class="section-tip">
      {{visibility === 'PUBLIC' ? '所有人可见，进入公开信息流' : visibility === 'PRIVATE' ? '仅自己可见，不会出现在广场/搜索/关注流' : '保存到草稿箱，稍后可编辑再发布'}}
    </view>

    <!-- P2-06 定时发布（仅公开帖） -->
    <view class="schedule-row" wx:if="{{visibility === 'PUBLIC'}}">
      <view class="schedule-toggle">
        <text class="schedule-label">定时发布</text>
        <switch checked="{{scheduleEnabled}}" bindchange="toggleSchedule" color="#F9C801" />
      </view>
      <picker wx:if="{{scheduleEnabled}}" mode="date" value="{{publishAt}}" bindchange="onScheduleChange">
        <view class="schedule-picker">
          <text>{{publishAt || '选择发布日期'}}</text>
          <text class="schedule-arrow">›</text>
        </view>
      </picker>
      <view class="section-tip" wx:if="{{scheduleEnabled}}">到点自动发布并进入内容审核；审核通过后公开可见</view>
    </view>
  </view>

  <!-- 提交 -->
  <button
    class="submit"
    bindtap="submit"
    disabled="{{submitting || !hasContent || !selectedCircleId}}"
  >{{submitting ? '发布中...' : (visibility === 'DRAFT' ? '保存草稿' : visibility === 'PRIVATE' ? '保存私密' : (isAnonymous ? '匿名发布' : '发布'))}}</button>
</view>

<!-- 圈子选择弹窗 -->
<view class="mask" wx:if="{{showCirclePicker}}" bindtap="closeCirclePicker">
  <view class="picker" catchtap="">
    <view class="picker-title">选择圈子</view>
    <scroll-view scroll-y class="picker-list">
      <view
        wx:for="{{circles}}"
        wx:key="id"
        class="picker-item {{item.id === selectedCircleId ? 'active' : ''}}"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        data-icon="{{item.icon}}"
        bindtap="pickCircle"
      >{{item.icon ? item.icon + ' ' : ''}}{{item.name}}</view>
    </scroll-view>
  </view>
</view>
