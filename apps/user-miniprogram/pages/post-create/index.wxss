.page {
  padding: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.label { font-size: 28rpx; color: #333; font-weight: 500; }
.value { display: flex; align-items: center; color: #666; font-size: 28rpx; }
.arrow { margin-left: 8rpx; color: #bbb; font-size: 36rpx; line-height: 1; }

.textarea {
  width: 100%;
  min-height: 320rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.img-box {
  position: relative;
  aspect-ratio: 1;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.img { width: 100%; height: 100%; }
.img-del {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  line-height: 32rpx;
  text-align: center;
}
.img-add {
  aspect-ratio: 1;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #bbb;
  border: 2rpx dashed #e0e0e0;
}
.plus { font-size: 56rpx; line-height: 1; font-weight: 300; }
.add-tip { font-size: 22rpx; margin-top: 8rpx; }

.submit {
  width: 100%;
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  margin-top: 40rpx;
}
.submit[disabled] { background: #ffb3c1 !important; color: #fff !important; }

/* 弹窗 */
.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  max-height: 70vh;
}
.picker-title {
  font-size: 32rpx; font-weight: 600; text-align: center;
  padding: 16rpx 0 24rpx;
}
.picker-list { max-height: 60vh; }
.picker-item {
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f4f4f4;
}
.picker-item.active { color: #ff4d6d; font-weight: 600; }
