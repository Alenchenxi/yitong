.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.label { font-size: 28rpx; color: #1D2129; font-weight: 500; }
.value { display: flex; align-items: center; color: #86909C; font-size: 28rpx; }
.arrow { margin-left: 8rpx; color: #C9CDD4; font-size: 36rpx; line-height: 1; }

/* 正文 + 表情入口 */
.textarea-wrap {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.textarea {
  width: 100%;
  min-height: 320rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  padding-right: 72rpx;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}
.emoji-toggle {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  background: #FFFBEA;
  border-radius: 50%;
}
.emoji-toggle.active { background: #F9C801; }

/* 表情面板 */
.emoji-panel {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.emoji-item {
  text-align: center;
  font-size: 40rpx;
  padding: 12rpx 0;
}

/* 媒体 */
.images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.img-box {
  position: relative;
  aspect-ratio: 1;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}
.img { width: 100%; height: 100%; }
.img-del {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  line-height: 32rpx;
  text-align: center;
}
.img-add {
  aspect-ratio: 1;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #C9CDD4;
  border: 2rpx dashed #E5E6EB;
}
.plus { font-size: 48rpx; line-height: 1; font-weight: 300; }
.add-tip { font-size: 22rpx; margin-top: 8rpx; }

.video-box {
  position: relative;
  width: 100%;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.video { width: 100%; height: 400rpx; }
.video-del { top: 16rpx; right: 16rpx; }

/* 分区（标签） */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 20rpx;
}
.section-tip { font-size: 24rpx; color: #86909C; font-weight: 400; margin-left: 8rpx; }
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 24rpx;
}
.tag-on {
  background: #FFF7D1;
  color: #1D2129;
  font-weight: 500;
}

/* 匿名行 */
.anon-label { display: flex; flex-direction: column; }
.anon-tip { font-size: 22rpx; color: #C9CDD4; margin-top: 4rpx; }

/* P1-11 可见性切换 */
.visibility-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.visibility-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 26rpx;
}
.visibility-btn.on { background: var(--yt-primary, #F9C801); color: var(--yt-text-main, #1D2129); font-weight: 600; }
.section-tip { font-size: 22rpx; color: #86909C; margin-top: 8rpx; }

/* 提交 */
.submit {
  width: 100%;
  background: #F9C801 !important;
  color: #1D2129 !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
  margin-top: 40rpx;
}
.submit[disabled] { background: #FFF7D1 !important; color: #C9CDD4 !important; }

/* 圈子弹窗 */
.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  max-height: 70vh;
}
.picker-title {
  font-size: 32rpx; font-weight: 600; text-align: center;
  padding: 16rpx 0 24rpx;
  color: #1D2129;
}
.picker-list { max-height: 60vh; }
.picker-item {
  padding: 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  border-bottom: 1rpx solid #F7F8FA;
}
.picker-item.active { color: #1D2129; font-weight: 600; background: #FFFBEA; }
