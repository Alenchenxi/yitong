<view class="page">
  <view class="search-bar">
    <input class="input" placeholder="搜索表白墙 / 兼职" value="{{q}}" bindinput="onInput" bindconfirm="onConfirm" confirm-type="search" focus="{{true}}" />
    <text class="search-btn" bindtap="runSearch">搜索</text>
  </view>
  <view class="tabs">
    <text class="tab {{tab === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-tab="{{item.key}}" catchtap="switchTab">{{item.label}}</text>
  </view>

  <!-- 无搜索：历史 -->
  <block wx:if="{{!hasSearched}}">
    <view class="section" wx:if="{{history.length}}">
      <view class="section-head">
        <text class="section-title">历史搜索</text>
        <text class="section-action" bindtap="clearHistoryTap">清空</text>
      </view>
      <view class="chips">
        <text class="chip" wx:for="{{history}}" wx:key="*this" data-kw="{{item}}" catchtap="tapHistory">{{item}}</text>
      </view>
    </view>
  </block>

  <!-- 表白墙结果 -->
  <block wx:elif="{{tab === 'confession'}}">
    <view class="post" wx:for="{{postResults}}" wx:key="id" data-id="{{item.id}}" catchtap="openPost">
      <view class="post-content">{{item.content}}</view>
      <view class="post-meta">{{item.authorNickname}} · {{item.timeText}} · ♥ {{item.likeCount}} · 💬 {{item.commentCount}}</view>
    </view>
    <view class="empty" wx:if="{{!loading && postResults.length === 0}}">无结果</view>
  </block>

  <!-- 兼职结果 -->
  <block wx:else>
    <view class="job" wx:for="{{jobResults}}" wx:key="id" data-id="{{item.id}}" catchtap="openJob">
      <view class="job-title">{{item.title}}</view>
      <view class="job-meta">{{item.merchantShopName}} · {{item.salary}} · {{item.location}}</view>
    </view>
    <view class="empty" wx:if="{{!loading && jobResults.length === 0}}">无结果</view>
  </block>

  <view class="loading" wx:if="{{loading}}">搜索中…</view>
</view>
