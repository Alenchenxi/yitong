<view class="page">
  <view class="topbar">
    <view class="action" bindtap="goMyApps">我的报名</view>
    <block wx:if="{{isMerchant}}">
      <view class="action" bindtap="goPost">发布岗位</view>
      <view class="action" bindtap="goManage">管理报名</view>
    </block>
  </view>

  <view class="list" wx:if="{{posts.length > 0}}">
    <view class="card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="title">{{item.title}}</view>
      <view class="shop">{{item.merchantShopName}}</view>
      <view class="meta">
        <text class="salary">{{item.salary}}</text>
        <text class="loc">📍 {{item.location}}</text>
      </view>
      <view class="dur">{{item.duration === 'D90' ? '90 天' : '30 天'}}</view>
    </view>
    <view class="tip" wx:if="{{loading}}">加载中...</view>
    <view class="tip" wx:elif="{{!hasMore}}">没有更多了</view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-emoji">💼</view>
    <view class="empty-text">暂无兼职岗位</view>
  </view>
</view>
