.page { padding: 0 24rpx 120rpx; }
.topbar { display: flex; gap: 16rpx; padding: 16rpx 0; position: sticky; top: 0; background: #f5f6f8; z-index: 10; }
.action { padding: 12rpx 24rpx; border-radius: 40rpx; background: #fff; font-size: 26rpx; color: #ff4d6d; }
.list { margin-top: 8rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #222; }
.shop { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.meta { display: flex; justify-content: space-between; margin-top: 16rpx; }
.salary { color: #ff4d6d; font-size: 30rpx; font-weight: 600; }
.loc { color: #666; font-size: 24rpx; }
.dur { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.tip { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
