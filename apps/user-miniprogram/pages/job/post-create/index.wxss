.container { padding: 24rpx; background: #F6F7FB; min-height: 100vh; }
.top-chip {
  position: sticky; top: 0;
  background: #F9C801; color: #1D2129;
  padding: 16rpx 24rpx; border-radius: 12rpx;
  font-size: 26rpx; font-weight: 500;
  display: flex; justify-content: space-between; gap: 16rpx;
}
.field { margin-top: 24rpx; background: #FFFFFF; border-radius: 12rpx; padding: 24rpx; }
.field .label { font-size: 28rpx; color: #4E5969; margin-bottom: 12rpx; }
.input-row { display: flex; gap: 16rpx; align-items: center; }
.input { flex: 1 1 auto; font-size: 30rpx; color: #1D2129; padding: 8rpx 0; }
.textarea { width: 100%; min-height: 160rpx; font-size: 28rpx; color: #1D2129; }
.textarea-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.btn-refresh {
  background: #FFF7CC; color: #1D2129; font-size: 24rpx;
  padding: 8rpx 16rpx; border-radius: 8rpx;
}
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  background: #F2F3F5; color: #4E5969; font-size: 26rpx;
  padding: 12rpx 24rpx; border-radius: 999rpx;
}
.chip.active { background: #F9C801; color: #1D2129; }
.readonly-row { display: flex; align-items: center; gap: 16rpx; }
.readonly-row .value { flex: 1 1 auto; font-size: 30rpx; color: #1D2129; }
.readonly-row .link { color: #F9C801; font-size: 28rpx; }
.collapsible { display: flex; justify-content: space-between; align-items: center; }
.collapsible .arrow { color: #86909C; font-size: 24rpx; }
.more-fields .field { background: #FFFFFF; }
.action { margin-top: 48rpx; padding-bottom: 48rpx; }
.btn-primary {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #F9C801; color: #1D2129; font-size: 32rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
}
.btn-primary.disabled { background: #F2F3F5; color: #86909C; }