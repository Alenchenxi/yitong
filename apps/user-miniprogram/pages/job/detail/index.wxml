<view class="page" wx:if="{{post}}">
  <view class="title">{{post.title}}</view>

  <!-- P0-17 结构化标签 -->
  <view class="tags" wx:if="{{post.categoryLabel || post.urgent || post.online}}">
    <text class="tag tag-cat" wx:if="{{post.categoryLabel}}">{{post.categoryLabel}}</text>
    <text class="tag tag-urgent" wx:if="{{post.urgent}}">急招</text>
    <text class="tag tag-online" wx:if="{{post.online}}">可线上</text>
  </view>

  <view class="meta">
    <text class="salary">{{post.salary}}</text>
    <text class="loc">{{post.location}} · {{post.duration === 'D90' ? '90天' : '30天'}}</text>
  </view>

  <!-- P0-19 商家信息 -->
  <view class="merchant">
    <text class="shop">{{post.merchantShopName}}</text>
    <text class="verified">✓ 资质已认证</text>
  </view>

  <!-- P0-17 结构化信息 -->
  <view class="info">
    <view class="info-row" wx:if="{{post.settlementLabel}}"><text class="info-k">结算方式</text><text class="info-v">{{post.settlementLabel}}</text></view>
    <view class="info-row" wx:if="{{post.headcount}}"><text class="info-k">招聘人数</text><text class="info-v">{{post.headcount}} 人</text></view>
    <view class="info-row" wx:if="{{post.workDatesText}}"><text class="info-k">工作日期</text><text class="info-v">{{post.workDatesText}}</text></view>
    <view class="info-row" wx:if="{{post.workPeriodsText}}"><text class="info-k">工作时段</text><text class="info-v">{{post.workPeriodsText}}</text></view>
  </view>

  <!-- P0-19 工作内容 / 任职要求 -->
  <view class="section" wx:if="{{post.description}}">
    <view class="section-title">工作内容</view>
    <view class="section-body">{{post.description}}</view>
  </view>
  <view class="section" wx:if="{{post.requirements}}">
    <view class="section-title">任职要求</view>
    <view class="section-body">{{post.requirements}}</view>
  </view>

  <!-- P0-19 操作栏：收藏 / 分享 / 举报 -->
  <view class="actions">
    <view class="act {{post.favorited ? 'on' : ''}}" bindtap="onFavorite">{{post.favorited ? '★ 已收藏' : '☆ 收藏'}}</view>
    <button class="act share-btn" open-type="share">↗ 分享</button>
    <view class="act report" bindtap="onReport">举报</view>
  </view>

  <button wx:if="{{!isMerchantOwner}}" class="apply-btn" bindtap="apply" disabled="{{applying}}">{{applying ? '报名中…' : '立即报名'}}</button>

  <!-- P0-19 风险提示（固定区块） -->
  <view class="risk">
    <view class="risk-title">⚠️ 兼职安全提示</view>
    <view class="risk-item">· 不缴纳任何押金、培训费、体检费、服装费</view>
    <view class="risk-item">· 不扣押身份证、学生证等个人证件</view>
    <view class="risk-item">· 警惕高薪诱惑，拒绝刷单、转账、代付类兼职</view>
    <view class="risk-item">· 面试尽量结伴前往，注意人身与财产安全</view>
    <view class="risk-item">· 如遇诈骗或违规请立即举报并报警处理</view>
  </view>

  <view class="apps" wx:if="{{isMerchantOwner}}">
    <view class="apps-head">
      <view class="section-title">报名管理 ({{apps.length}})</view>
      <view class="batch-toggle" bindtap="toggleBatchMode">{{batchMode ? '取消批量' : '批量处理'}}</view>
    </view>
    <button class="subscribe-btn" size="mini" bindtap="subscribeJobApply" disabled="{{subscribingApply}}">{{subscribingApply ? '订阅中...' : '订阅报名提醒'}}</button>

    <view class="batch-bar" wx:if="{{batchMode}}">
      <view class="batch-btn" bindtap="selectAll">全选待处理</view>
      <view class="batch-btn primary" bindtap="batchAction" data-action="accept">批量录用</view>
      <view class="batch-btn danger" bindtap="batchAction" data-action="reject">批量拒绝</view>
    </view>

    <view class="app-item" wx:for="{{apps}}" wx:key="id">
      <view class="app-head">
        <view class="app-head-left">
          <text wx:if="{{batchMode && item.status === 'PENDING'}}" class="app-check" data-id="{{item.id}}" catchtap="toggleSelect">{{item.selected ? '☑' : '☐'}}</text>
          <text class="app-nick">{{item.userNickname}}</text>
        </view>
        <text class="app-status">{{item.statusText}}</text>
      </view>
      <!-- P0-21 简历快照 -->
      <view class="app-resume" wx:if="{{item.resume}}">
        <text class="app-resume-line">简历：{{item.resume.name}} · {{item.resume.phone}}</text>
        <text class="app-resume-line" wx:if="{{item.resume.skills.length > 0}}">技能：{{item.resume.skills}}</text>
      </view>
      <!-- P0-21 报名问题回答 -->
      <view class="app-answers" wx:if="{{item.answers && item.answers.length > 0}}">
        <view class="app-ans" wx:for="{{item.answers}}" wx:for-item="ans" wx:for-index="ai" wx:key="ai">
          <text class="app-q">Q：{{ans.question}}</text>
          <text class="app-a">A：{{ans.answer}}</text>
        </view>
      </view>
      <view class="app-actions" wx:if="{{!batchMode}}">
        <button wx:if="{{item.status === 'PENDING'}}" size="mini" bindtap="transition" data-id="{{item.id}}" data-action="accept">录用</button>
        <button wx:if="{{item.status === 'PENDING'}}" size="mini" bindtap="transition" data-id="{{item.id}}" data-action="reject">拒绝</button>
        <button wx:if="{{item.status === 'ACCEPTED'}}" size="mini" bindtap="transition" data-id="{{item.id}}" data-action="complete">标记完成</button>
      </view>
    </view>
    <view class="empty" wx:if="{{apps.length === 0}}">暂无报名</view>
  </view>

  <view class="reviews">
    <view class="section-title">评价 ({{reviews.length}})</view>
    <view class="r-item" wx:for="{{reviews}}" wx:key="id">
      <view class="r-stars">{{item.stars}}</view>
      <view class="r-content">{{item.content}}</view>
    </view>
    <view class="empty" wx:if="{{reviews.length === 0}}">暂无评价</view>
  </view>
</view>
