.page { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; color: #222; }
.merchant { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.merchant .shop { font-size: 26rpx; color: #888; }
.verified { font-size: 22rpx; color: #52c41a; border: 1rpx solid #52c41a; padding: 2rpx 12rpx; border-radius: 999rpx; }
.meta { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.salary { color: #ff4d6d; font-size: 34rpx; font-weight: 600; }
.loc { color: #666; font-size: 26rpx; }
.section { margin: 24rpx 0; }
.section-body { font-size: 30rpx; line-height: 1.6; color: #333; white-space: pre-wrap; }

.actions { display: flex; justify-content: space-around; align-items: center; margin: 24rpx 0; padding: 16rpx 0; border-top: 1rpx solid #f0f0f0; border-bottom: 1rpx solid #f0f0f0; }
.act { font-size: 26rpx; color: #666; padding: 8rpx 24rpx; }
.act.on { color: #ff4d6d; }
.act.report { color: #999; }
.share-btn { font-size: 26rpx; color: #666 !important; background: transparent !important; line-height: normal; padding: 8rpx 24rpx; }
.share-btn::after { border: none; }

.risk { background: #fff7e6; border: 1rpx solid #ffd591; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 24rpx 0; }
.risk-title { font-size: 26rpx; font-weight: 600; color: #d46b08; margin-bottom: 10rpx; }
.risk-item { font-size: 24rpx; color: #874d00; line-height: 1.8; }

.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.tag { font-size: 22rpx; padding: 4rpx 18rpx; border-radius: 999rpx; }
.tag-cat { background: #f5f6f8; color: #666; }
.tag-urgent { background: #ff4d6d; color: #fff; }
.tag-online { background: #fff0f3; color: #ff4d6d; border: 1rpx solid #ff4d6d; }
.info { margin-top: 20rpx; background: #fafafa; border-radius: 12rpx; padding: 16rpx 20rpx; }
.info-row { display: flex; justify-content: space-between; font-size: 26rpx; padding: 8rpx 0; }
.info-k { color: #999; }
.info-v { color: #333; }
.apply-btn {
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  margin: 16rpx 0 32rpx;
}
.apply-btn[disabled] { background: #ffb3c1 !important; }
.subscribe-btn {
  margin: 0 0 16rpx;
  border-radius: 32rpx !important;
  color: #1677ff !important;
  border: 1rpx solid #1677ff !important;
  background: #fff !important;
}
.fav-row { display: flex; justify-content: flex-end; margin: 16rpx 0 8rpx; }
.fav-btn { color: #999; font-size: 28rpx; padding: 8rpx 16rpx; }
.fav-btn.faved { color: #ff4d6d; }
/* 兼容旧样式（P0-19 改用 .actions） */
.section-title { font-size: 28rpx; font-weight: 600; margin: 24rpx 0 16rpx; color: #333; }
.apps, .reviews { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.app-item { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.app-item:last-child { border-bottom: none; }
.app-nick { font-size: 28rpx; color: #222; }
.app-status { font-size: 24rpx; color: #999; }
.r-item { padding: 16rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.r-item:last-child { border-bottom: none; }
.r-stars { color: #ffb400; font-size: 26rpx; }
.r-content { font-size: 28rpx; color: #333; margin-top: 8rpx; }
.empty { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
