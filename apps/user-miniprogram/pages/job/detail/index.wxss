.page { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; color: #222; }
.shop { font-size: 26rpx; color: #888; margin-top: 8rpx; }
.meta { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.salary { color: #ff4d6d; font-size: 34rpx; font-weight: 600; }
.loc { color: #666; font-size: 26rpx; }
.desc { font-size: 30rpx; line-height: 1.6; color: #333; margin: 24rpx 0; white-space: pre-wrap; }
.apply-btn {
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  margin: 16rpx 0 32rpx;
}
.apply-btn[disabled] { background: #ffb3c1 !important; }
.section-title { font-size: 28rpx; font-weight: 600; margin: 24rpx 0 16rpx; color: #333; }
.apps, .reviews { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.app-item { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.app-item:last-child { border-bottom: none; }
.app-nick { font-size: 28rpx; color: #222; }
.app-status { font-size: 24rpx; color: #999; }
.r-item { padding: 16rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.r-item:last-child { border-bottom: none; }
.r-stars { color: #ffb400; font-size: 26rpx; }
.r-content { font-size: 28rpx; color: #333; margin-top: 8rpx; }
.empty { text-align: center; color: #999; font-size: 24rpx; padding: 24rpx 0; }
