<view class="page">
  <view class="row"><text class="label">标题</text><input class="input" placeholder="如：周末奶茶店兼职" value="{{title}}" data-field="title" bindinput="onInput" /></view>
  <view class="row"><text class="label">薪资</text><input class="input" placeholder="如：150元/天" value="{{salary}}" data-field="salary" bindinput="onInput" /></view>
  <view class="row"><text class="label">地点</text><input class="input" placeholder="如：学校南门" value="{{location}}" data-field="location" bindinput="onInput" /></view>
  <view class="textarea-wrap">
    <text class="label">描述</text>
    <textarea class="textarea" placeholder="岗位职责 / 要求 / 时间等" value="{{description}}" data-field="description" bindinput="onInput" maxlength="2000" auto-height show-confirm-bar="{{false}}" />
  </view>
  <view class="row">
    <text class="label">下架时长</text>
    <view class="dur">
      <view class="dur-opt {{duration === 'D30' ? 'active' : ''}}" data-d="D30" bindtap="pickDuration">30 天</view>
      <view class="dur-opt {{duration === 'D90' ? 'active' : ''}}" data-d="D90" bindtap="pickDuration">90 天</view>
    </view>
  </view>
  <button class="submit" bindtap="submit" disabled="{{submitting}}">{{submitting ? '发布中…' : '发布岗位'}}</button>
  <view class="hint">创建为草稿，提交后需付费发布（30/90 天单价由后台配置）</view>
</view>
