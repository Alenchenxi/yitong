<view class="page">
  <view class="hint">点击岗位进入报名管理（录用 / 标记完成）</view>
  <view class="card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="title">{{item.title}}</view>
    <view class="meta">
      <text class="salary">{{item.salary}}</text>
      <text class="status status-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="dur">{{item.duration === 'D90' ? '90 天' : '30 天'}} · {{item.location}}</view>
  </view>
  <view class="empty" wx:if="{{posts.length === 0}}">还没发布过岗位</view>
</view>
