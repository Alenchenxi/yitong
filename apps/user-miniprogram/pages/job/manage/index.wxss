.page { padding: 24rpx; padding-bottom: 160rpx; box-sizing: border-box; min-height: 100vh; }
.hint { color: #999; font-size: 24rpx; margin-bottom: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.title { font-size: 30rpx; font-weight: 600; color: #222; }
.meta { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.salary { color: #ff4d6d; font-size: 28rpx; font-weight: 600; }
.status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; background: #f5f6f8; color: #666; }
.status-PUBLISHED { color: #fff; background: #52c41a; }
.status-EXPIRED, .status-TAKEN_DOWN { color: #999; }
.dur { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.pay-btn { margin-top: 16rpx; background: #ff4d6d !important; color: #fff !important; border-radius: 32rpx !important; font-size: 24rpx !important; }
.empty { text-align: center; color: #999; padding-top: 200rpx; font-size: 28rpx; }
