<view class="container">
  <view class="actions">
    <view class="btn-gps" bindtap="onUseGps">当前定位</view>
    <view class="city-tag">{{city}}</view>
  </view>

  <map
    id="jobLocationMap"
    class="map"
    latitude="{{center.lat}}"
    longitude="{{center.lng}}"
    scale="16"
    show-location="true"
    bindregionchange="onRegionChange"
  ></map>

  <view class="hint">拖动地图选点</view>

  <view class="bottom">
    <view class="address-preview">{{address || '请拖动地图选择工作地点'}}</view>
    <button
      class="btn-primary {{canConfirm ? '' : 'disabled'}}"
      bindtap="onConfirm"
      disabled="{{!canConfirm}}"
    >确认选择该地点</button>
  </view>
</view>