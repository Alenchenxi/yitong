.container { padding: 0; background: #F6F7FB; min-height: 100vh; display: flex; flex-direction: column; }
.actions {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF; border-bottom: 1rpx solid #F2F3F5;
}
.btn-gps {
  background: #F9C801; color: #1D2129;
  padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 26rpx;
}
.city-tag { font-size: 28rpx; color: #1D2129; font-weight: 500; }
.map { flex: 1 1 auto; width: 100%; }
.hint { text-align: center; padding: 12rpx; font-size: 24rpx; color: #86909C; }
.bottom {
  background: #FFFFFF; padding: 24rpx;
  border-top: 1rpx solid #F2F3F5;
}
.address-preview {
  font-size: 28rpx; color: #1D2129; padding: 12rpx 0;
  min-height: 36rpx;
}
.btn-primary {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #F9C801; color: #1D2129; font-size: 32rpx; font-weight: 600;
  border-radius: 16rpx; border: none;
}
.btn-primary.disabled { background: #F2F3F5; color: #86909C; }