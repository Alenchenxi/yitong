.page { padding: 24rpx; }
.app { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.app-head { display: flex; justify-content: space-between; align-items: center; }
.app-title { font-size: 30rpx; font-weight: 600; color: #222; flex: 1; }
.app-status { font-size: 24rpx; padding: 4rpx 16rpx; border-radius: 20rpx; background: #f5f6f8; color: #666; }
.app-status.DONE { color: #fff; background: #52c41a; }
.app-status.ACCEPTED { color: #fff; background: #ff4d6d; }
.app-status.REJECTED { color: #fff; background: #999; }
.app-status.CANCELLED { color: #fff; background: #C9CDD4; }
.app-time { font-size: 22rpx; color: #999; margin-top: 12rpx; }
.app-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.cancel-btn { background: #fff !important; color: #E63946 !important; border: 1rpx solid #E63946 !important; border-radius: 32rpx !important; font-size: 24rpx !important; }
.report-btn { background: #fff !important; color: #86909C !important; border: 1rpx solid #C9CDD4 !important; border-radius: 32rpx !important; font-size: 24rpx !important; }
.review-btn { background: #ff4d6d !important; color: #fff !important; border-radius: 32rpx !important; font-size: 24rpx !important; }
.empty { text-align: center; color: #999; padding-top: 200rpx; font-size: 28rpx; }

.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 100; display: flex; align-items: flex-end; }
.picker { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 32rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.picker-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.stars { text-align: center; font-size: 56rpx; margin-bottom: 24rpx; }
.star { margin: 0 8rpx; color: #ccc; }
.star.on { color: #ffb400; }
.review-input { width: 100%; min-height: 160rpx; background: #f5f6f8; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }
.send-btn { margin-top: 24rpx; background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important; color: #fff !important; border-radius: 48rpx !important; }
.send-btn[disabled] { background: #ffb3c1 !important; }
