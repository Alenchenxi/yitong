.page {
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 身份卡 */
.card {
  background: linear-gradient(135deg, var(--yt-primary-light, #ffe27a), var(--yt-primary, #f9c801));
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--yt-text-main, #1d2129);
}
.info { flex: 1; }
.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--yt-text-main, #1d2129);
}
.role-badge {
  margin-top: 12rpx;
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.4);
  font-size: 24rpx;
  color: var(--yt-text-main, #1d2129);
}

/* 分区卡片 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 26rpx;
  color: var(--yt-text-weak, #86909c);
  margin-bottom: 16rpx;
}

/* 管理入口 4 列 */
.grid {
  display: flex;
  flex-wrap: wrap;
}
.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.grid-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 8rpx;
  background: var(--yt-disabled-bg, #f5f6f8);
  color: var(--yt-text-main, #1d2129);
}
.icon-queue  { background: #ffe27a; }
.icon-stats  { background: #b5e3ff; }
.icon-price  { background: #ffb3c1; }
.icon-jobs   { background: #c8e6c9; }
.icon-users  { background: #d1c4e9; }
.icon-tickets{ background: #ffccbc; }
.icon-reports{ background: #fff59d; }
.icon-announce{ background: #b2ebf2; }
.grid-label {
  font-size: 24rpx;
  color: var(--yt-text-main, #1d2129);
}

/* 菜单项 */
.menu-item {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--yt-text-main, #1d2129);
  border-bottom: 1rpx solid var(--yt-border, #f0f0f0);
}
.menu-item:last-child { border-bottom: none; }
.menu-item text:first-child { flex: 1; }
.arrow {
  color: var(--yt-text-weak, #86909c);
  font-size: 32rpx;
}

/* 退出按钮 */
.logout-btn {
  margin-top: 32rpx;
  background: #fff !important;
  color: var(--yt-danger, #e63946) !important;
  border: 1rpx solid var(--yt-border, #f0f0f0) !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
}