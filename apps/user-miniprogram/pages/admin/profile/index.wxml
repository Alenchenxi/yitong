<view class="adm-page">
  <!-- 管理员资料卡 -->
  <view class="profile-card">
    <view class="profile-avatar">{{nickname ? nickname.slice(0,1) : '管'}}</view>
    <view class="profile-info">
      <view class="profile-name">{{nickname || '管理员'}}</view>
      <view class="profile-badge">管理员</view>
    </view>
  </view>

  <!-- 管理入口 -->
  <view class="yt-card profile-section">
    <view class="profile-section-title">管理入口</view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-url="/pages/admin/dashboard/index"><text>看板</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-url="/pages/admin/review/index"><text>审核</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-url="/pages/admin/ops/index"><text>运营</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="go" data-url="/pages/admin/users/index"><text>用户</text><text class="profile-arrow">›</text></view>
  </view>

  <!-- 账号 -->
  <view class="yt-card profile-section">
    <view class="profile-section-title">账号</view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="goAccountSecurity"><text>账号与安全</text><text class="profile-arrow">›</text></view>
    <view class="profile-menu" hover-class="adm-hover" bindtap="goSettings"><text>设置</text><text class="profile-arrow">›</text></view>
  </view>

  <button class="profile-logout" bindtap="logout">退出登录</button>

  <bottom-tab tabs="{{tabs}}" current="{{current}}"></bottom-tab>
</view>
