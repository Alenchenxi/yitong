<view class="page">
  <view class="card">
    <view class="avatar">{{nickname ? nickname.slice(0,1) : '?'}}</view>
    <view class="info">
      <view class="nickname">{{nickname || '管理员'}}</view>
      <view class="role-badge">{{roleText}}</view>
    </view>
  </view>

  <view class="section yt-card">
    <view class="menu-item" bindtap="goProfile"><text>个人资料</text><text class="arrow">›</text></view>
  </view>

  <button class="logout-btn" bindtap="logout">退出登录</button>

  <bottom-tab
    tabs="{{tabs}}"
    current="{{current}}"
  ></bottom-tab>
</view>