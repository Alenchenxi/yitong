<view class="page">
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tab {{tab === 'queue' ? 'active' : ''}}" data-tab="queue" bindtap="switchTab">审核</view>
    <view class="tab {{tab === 'stats' ? 'active' : ''}}" data-tab="stats" bindtap="switchTab">看板</view>
    <view class="tab {{tab === 'pricing' ? 'active' : ''}}" data-tab="pricing" bindtap="switchTab">单价</view>
    <view class="tab {{tab === 'announce' ? 'active' : ''}}" data-tab="announce" bindtap="switchTab">公告</view>
    <view class="tab {{tab === 'reports' ? 'active' : ''}}" data-tab="reports" bindtap="switchTab">举报</view>
    <view class="tab {{tab === 'tickets' ? 'active' : ''}}" data-tab="tickets" bindtap="switchTab">工单</view>
    <view class="tab {{tab === 'users' ? 'active' : ''}}" data-tab="users" bindtap="switchTab">用户</view>
    <view class="tab {{tab === 'activity' ? 'active' : ''}}" data-tab="activity" bindtap="switchTab">专题</view>
    <view class="tab {{tab === 'topic' ? 'active' : ''}}" data-tab="topic" bindtap="switchTab">话题</view>
    <view class="tab {{tab === 'tags' ? 'active' : ''}}" data-tab="tags" bindtap="switchTab">标签</view>
    <view class="tab {{tab === 'jobs' ? 'active' : ''}}" data-tab="jobs" bindtap="switchTab">岗位</view>
  </scroll-view>

  <!-- 审核队列 -->
  <block wx:if="{{tab === 'queue' && queue}}">
    <view class="section-title">商家入驻 ({{queue.merchants.length}})</view>
    <view class="batch-btn" wx:if="{{queue.merchants.length > 0}}" bindtap="batchApprove">批量通过待审核</view>
    <view class="item" wx:for="{{queue.merchants}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.shopName}}</text>
        <text class="item-sub">{{item.userNickname}} · {{item.status}}</text>
      </view>
      <view class="item-actions">
        <button wx:if="{{item.status === 'PENDING'}}" size="mini" data-id="{{item.id}}" bindtap="approve">通过</button>
        <button wx:if="{{item.status === 'PENDING' || item.status === 'APPROVED'}}" size="mini" data-id="{{item.id}}" bindtap="reject">拒绝</button>
      </view>
    </view>

    <view class="section-title">表白墙帖子 ({{queue.posts.length}})</view>
    <view class="item" wx:for="{{queue.posts}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.content}}</text>
        <text class="item-sub">{{item.authorNickname}} · {{item.circleName}} · {{item.status}}{{item.pinned ? ' · 置顶' : ''}}{{item.featured ? ' · 精' : ''}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" data-id="{{item.id}}" data-pinned="{{item.pinned}}" bindtap="togglePin">{{item.pinned ? '取消置顶' : '置顶'}}</button>
        <button size="mini" data-id="{{item.id}}" data-featured="{{item.featured}}" bindtap="toggleFeature">{{item.featured ? '取消加精' : '加精'}}</button>
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" data-id="{{item.id}}" bindtap="takedown">下架</button>
      </view>
    </view>

    <view class="section-title">树洞帖子 ({{queue.anonPosts.length}})</view>
    <view class="item" wx:for="{{queue.anonPosts}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.content}}</text>
        <text class="item-sub">{{item.anonId}} · {{item.status}}</text>
      </view>
      <view class="item-actions">
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" data-id="{{item.id}}" bindtap="takedownAnon">下架</button>
      </view>
    </view>

    <view class="section-title">举报记录 ({{queue.reports.length}})</view>
    <view class="item" wx:for="{{queue.reports}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.reason}}</text>
        <text class="item-sub">{{item.targetType}} · {{item.createdAt}}</text>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{queue.reports.length === 0}}">暂无举报</view>
  </block>

  <!-- 数据看板 -->
  <block wx:if="{{tab === 'stats' && stats}}">
    <view class="section-title">总览</view>
    <view class="stats-grid">
      <view class="stat-card"><text class="stat-num">{{stats.overview.totalUsers}}</text><text class="stat-label">总用户</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.overview.totalMerchants}}</text><text class="stat-label">商家</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.overview.totalPosts}}</text><text class="stat-label">表白墙帖</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.overview.totalAnonPosts}}</text><text class="stat-label">树洞帖</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.overview.publishedJobPosts}}</text><text class="stat-label">在招岗位</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.overview.totalApplications}}</text><text class="stat-label">总报名</text></view>
    </view>

    <view class="section-title">今日</view>
    <view class="stats-grid">
      <view class="stat-card"><text class="stat-num">{{stats.today.newUsers}}</text><text class="stat-label">新用户</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.today.newPosts}}</text><text class="stat-label">新表白帖</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.today.newAnonPosts}}</text><text class="stat-label">新树洞帖</text></view>
      <view class="stat-card"><text class="stat-num">{{stats.today.newApplications}}</text><text class="stat-label">新报名</text></view>
    </view>

    <view class="section-title">近 7 天趋势</view>
    <view class="trend-table">
      <view class="trend-head">
        <text>日期</text><text>发帖</text><text>报名</text><text>新用户</text>
      </view>
      <view class="trend-row" wx:for="{{stats.trend}}" wx:key="date">
        <text>{{item.date}}</text><text>{{item.posts}}</text><text>{{item.applications}}</text><text>{{item.newUsers}}</text>
      </view>
    </view>
  </block>

  <!-- 公告管理 -->
  <block wx:if="{{tab === 'announce'}}">
    <view class="section-title">新建公告</view>
    <view class="ann-form">
      <input class="ann-input" placeholder="标题（最多 100 字）" value="{{annTitle}}" data-field="annTitle" bindinput="onAnnInput" maxlength="100" />
      <textarea class="ann-textarea" placeholder="内容（最多 2000 字）" value="{{annContent}}" data-field="annContent" bindinput="onAnnInput" maxlength="2000" auto-height />
      <button class="ann-submit" bindtap="createAnn">发布</button>
    </view>

    <view class="section-title">公告列表 ({{announcements.length}})</view>
    <view class="item" wx:for="{{announcements}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-sub">{{item.active ? '启用' : '停用'}} · {{item.createdAt}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleAnn">{{item.active ? '停用' : '启用'}}</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteAnn">删除</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{announcements.length === 0}}">暂无公告</view>
  </block>

  <!-- 单价配置 -->
  <block wx:if="{{tab === 'pricing'}}">
    <view class="item" wx:for="{{pricing}}" wx:key="duration">
      <view class="item-main">
        <text class="item-title">{{item.duration === 'D90' ? '90 天' : '30 天'}}</text>
        <text class="item-sub">¥{{item.price}}</text>
      </view>
      <view class="item-actions">
        <button wx:if="{{editingDuration !== item.duration}}" size="mini" data-dur="{{item.duration}}" data-price="{{item.price}}" bindtap="startEdit">编辑</button>
      </view>
    </view>
    <view class="edit-row" wx:if="{{editingDuration}}">
      <text>{{editingDuration === 'D90' ? '90天' : '30天'}} 单价：¥</text>
      <input class="price-input" type="digit" value="{{editingPrice}}" bindinput="onPriceInput" />
      <button size="mini" bindtap="savePrice">保存</button>
      <button size="mini" bindtap="cancelEdit">取消</button>
    </view>
  </block>

  <!-- 举报处理 -->
  <block wx:if="{{tab === 'reports'}}">
    <view class="filter-row">
      <view class="filter-btn {{reportStatus === 'PENDING' ? 'on' : ''}}" data-s="PENDING" bindtap="switchReportStatus">待处理</view>
      <view class="filter-btn {{reportStatus === 'APPROVED' ? 'on' : ''}}" data-s="APPROVED" bindtap="switchReportStatus">成立</view>
      <view class="filter-btn {{reportStatus === 'REJECTED' ? 'on' : ''}}" data-s="REJECTED" bindtap="switchReportStatus">驳回</view>
    </view>
    <view class="item" wx:for="{{reports}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.targetSummary || item.targetType}}</text>
        <text class="item-sub">举报人：{{item.reporterNickname || '匿名'}} · {{item.status}} · {{item.createdAt}}</text>
        <text class="item-sub" wx:if="{{item.reason}}">理由：{{item.reason}}</text>
      </view>
      <view class="item-actions" wx:if="{{item.status === 'PENDING'}}">
        <button size="mini" data-id="{{item.id}}" data-action="approve" bindtap="resolveReportTap">成立</button>
        <button size="mini" data-id="{{item.id}}" data-action="reject" bindtap="resolveReportTap">驳回</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{reports.length === 0}}">暂无举报</view>
  </block>

  <!-- 工单 -->
  <block wx:if="{{tab === 'tickets'}}">
    <view class="filter-row">
      <view class="filter-btn {{ticketStatus === 'OPEN' ? 'on' : ''}}" data-s="OPEN" bindtap="switchTicketStatus">待处理</view>
      <view class="filter-btn {{ticketStatus === 'IN_PROGRESS' ? 'on' : ''}}" data-s="IN_PROGRESS" bindtap="switchTicketStatus">处理中</view>
      <view class="filter-btn {{ticketStatus === 'CLOSED' ? 'on' : ''}}" data-s="CLOSED" bindtap="switchTicketStatus">已关闭</view>
    </view>
    <view class="item" wx:for="{{tickets}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-sub">{{item.userNickname}}（{{item.role === 'merchant' ? '商家' : '用户'}}）· {{item.status}} · {{item.createdAt}}</text>
        <text class="item-sub">内容：{{item.content}}</text>
        <text class="item-sub" wx:if="{{item.reply}}">回复：{{item.reply}}</text>
      </view>
      <view class="item-actions" wx:if="{{item.status !== 'CLOSED'}}">
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketTap">回复关闭</button>
        <button size="mini" data-id="{{item.id}}" bindtap="replyTicketKeepTap">保留处理</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{tickets.length === 0}}">暂无工单</view>
  </block>

  <!-- 用户管理 -->
  <block wx:if="{{tab === 'users'}}">
    <view class="search-row">
      <input class="search-input" placeholder="搜索昵称/用户ID" value="{{userKeyword}}" bindinput="onUserKeywordInput" bindconfirm="searchUsers" />
      <button size="mini" bindtap="searchUsers">搜索</button>
    </view>
    <view class="item" wx:for="{{users}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.nickname}}</text>
        <text class="item-sub">{{item.banned ? '已封禁' : '正常'}}{{item.mutedUntil ? ' · 禁言至' + item.mutedUntil : ''}}</text>
      </view>
      <view class="item-actions">
        <button wx:if="{{!item.banned}}" size="mini" type="warn" data-id="{{item.id}}" bindtap="banUserTap">封禁</button>
        <button size="mini" data-id="{{item.id}}" data-muted="{{item.mutedUntil}}" bindtap="muteUserTap">{{item.mutedUntil ? '解除禁言' : '禁言'}}</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{users.length === 0}}">暂无用户</view>
  </block>

  <!-- 活动专题 -->
  <block wx:if="{{tab === 'activity'}}">
    <view class="section-title">新建专题</view>
    <view class="ann-form">
      <input class="ann-input" placeholder="专题标题" value="{{actTitle}}" data-field="actTitle" bindinput="onActInput" />
      <textarea class="ann-textarea" placeholder="简介（选填）" value="{{actDesc}}" data-field="actDesc" bindinput="onActInput" auto-height />
      <button class="ann-submit" bindtap="createAct">发布（PUBLISHED）</button>
    </view>
    <view class="section-title">专题列表 ({{activityTopics.length}})</view>
    <view class="item" wx:for="{{activityTopics}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-sub">{{item.status}} · {{item.createdAt}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteAct">删除</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{activityTopics.length === 0}}">暂无专题</view>
  </block>

  <!-- 话题 -->
  <block wx:if="{{tab === 'topic'}}">
    <view class="section-title">新建话题</view>
    <view class="ann-form">
      <input class="ann-input" placeholder="话题名称" value="{{topicName}}" data-field="topicName" bindinput="onTopicInput" />
      <textarea class="ann-textarea" placeholder="描述（选填）" value="{{topicDesc}}" data-field="topicDesc" bindinput="onTopicInput" auto-height />
      <button class="ann-submit" bindtap="createTopic">发布（PUBLISHED）</button>
    </view>
    <view class="section-title">话题列表 ({{topics.length}})</view>
    <view class="item" wx:for="{{topics}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">#{{item.name}}</text>
        <text class="item-sub">{{item.status}} · {{item.createdAt}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteTopic">删除</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{topics.length === 0}}">暂无话题</view>
  </block>

  <!-- 树洞标签 -->
  <block wx:if="{{tab === 'tags'}}">
    <view class="section-title">新建标签</view>
    <view class="ann-form">
      <input class="ann-input" placeholder="标签名" value="{{tagName}}" data-field="tagName" bindinput="onTagInput" />
      <view class="tag-cat-row">
        <text class="tag-cat {{tagCategory === 'personality' ? 'on' : ''}}" data-c="personality" bindtap="pickTagCat">性格</text>
        <text class="tag-cat {{tagCategory === 'interest' ? 'on' : ''}}" data-c="interest" bindtap="pickTagCat">兴趣</text>
        <text class="tag-cat {{tagCategory === 'mood' ? 'on' : ''}}" data-c="mood" bindtap="pickTagCat">心情</text>
      </view>
      <button class="ann-submit" bindtap="createTag">创建</button>
    </view>
    <view class="section-title">标签列表 ({{anonTags.length}})</view>
    <view class="item" wx:for="{{anonTags}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.name}}</text>
        <text class="item-sub">{{item.category}} · {{item.active ? '启用' : '停用'}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" data-id="{{item.id}}" data-active="{{item.active}}" bindtap="toggleTag">{{item.active ? '停用' : '启用'}}</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="deleteTag">删除</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{anonTags.length === 0}}">暂无标签</view>
  </block>

  <!-- 岗位精品管理 -->
  <block wx:if="{{tab === 'jobs'}}">
    <view class="section-title">岗位列表 ({{jobPosts.length}})</view>
    <view class="item" wx:for="{{jobPosts}}" wx:key="id">
      <view class="item-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-sub">{{item.merchantShopName}} · {{item.status}}{{item.urgent ? ' · 急招' : ''}}{{item.featured ? ' · 精品' : ''}}</text>
      </view>
      <view class="item-actions">
        <button size="mini" data-id="{{item.id}}" data-featured="{{item.featured}}" bindtap="toggleJobFeature">{{item.featured ? '取消精品' : '设精品'}}</button>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{jobPosts.length === 0}}">暂无岗位</view>
  </block>
</view>
