<view class="shell">
  <scroll-view scroll-y class="shell-content" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindscrolltolower="onScrollLower" bindrefresherrefresh="onRefresh">
    <view hidden="{{activeTab !== 'dashboard'}}">
      <dashboard-panel
        wx:if="{{loaded.dashboard}}"
        id="panel-dashboard"
        params="{{tabParams.dashboard}}"
        bind:switchtab="onPanelSwitchTab"
      ></dashboard-panel>
    </view>
    <view hidden="{{activeTab !== 'review'}}">
      <review-panel
        wx:if="{{loaded.review}}"
        id="panel-review"
        params="{{tabParams.review}}"
        bind:switchtab="onPanelSwitchTab"
      ></review-panel>
    </view>
    <view hidden="{{activeTab !== 'ops'}}">
      <ops-panel
        wx:if="{{loaded.ops}}"
        id="panel-ops"
        params="{{tabParams.ops}}"
        bind:switchtab="onPanelSwitchTab"
      ></ops-panel>
    </view>
    <view hidden="{{activeTab !== 'users'}}">
      <users-panel
        wx:if="{{loaded.users}}"
        id="panel-users"
        params="{{tabParams.users}}"
        bind:switchtab="onPanelSwitchTab"
      ></users-panel>
    </view>
    <view hidden="{{activeTab !== 'profile'}}">
      <profile-panel
        wx:if="{{loaded.profile}}"
        id="panel-profile"
        params="{{tabParams.profile}}"
        bind:switchtab="onPanelSwitchTab"
      ></profile-panel>
    </view>
  </scroll-view>

  <bottom-tab tabs="{{tabs}}" current="{{activeTab}}" bind:change="onTabChange" />
</view>
