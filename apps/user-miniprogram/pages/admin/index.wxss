.page { padding: 24rpx; padding-bottom: 160rpx; box-sizing: border-box; min-height: 100vh; }
.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab { display: inline-block; padding: 16rpx 28rpx; border-radius: 12rpx; background: #fff; font-size: 26rpx; color: #666; margin-right: 12rpx; }
.tab.active { background: #ff4d6d; color: #fff; font-weight: 600; }
.filter-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.filter-btn { padding: 10rpx 24rpx; border-radius: 999rpx; background: #fff; font-size: 24rpx; color: #666; }
.filter-btn.on { background: #ff4d6d; color: #fff; font-weight: 600; }
.search-row { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.search-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 26rpx; }
.tag-cat-row { display: flex; gap: 12rpx; margin: 12rpx 0; }
.tag-cat { padding: 8rpx 20rpx; border-radius: 999rpx; background: #f5f6f8; font-size: 24rpx; color: #666; }
.tag-cat.on { background: #ff4d6d; color: #fff; }
.section-title { font-size: 26rpx; color: #999; margin: 24rpx 0 12rpx; }
.batch-btn { background: #52c41a; color: #fff; font-size: 26rpx; padding: 12rpx 24rpx; border-radius: 12rpx; display: inline-block; margin-bottom: 12rpx; }
.empty-tip { text-align: center; color: #ccc; font-size: 24rpx; padding: 24rpx 0; }
.item { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx; }
.item-main { flex: 1; min-width: 0; }
.item-title { display: block; font-size: 28rpx; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-sub { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.item-actions { display: flex; gap: 12rpx; flex-shrink: 0; }
.edit-row { display: flex; align-items: center; gap: 16rpx; background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 16rpx; font-size: 28rpx; }
.price-input { width: 120rpx; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 8rpx 16rpx; font-size: 28rpx; }
.stats-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.stat-card { width: calc(33.33% - 8rpx); background: #fff; border-radius: 12rpx; padding: 20rpx 0; text-align: center; }
.stat-num { display: block; font-size: 40rpx; font-weight: 700; color: #ff4d6d; }
.stat-label { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.trend-table { background: #fff; border-radius: 12rpx; overflow: hidden; }
.trend-head, .trend-row { display: flex; justify-content: space-between; padding: 16rpx 24rpx; font-size: 24rpx; }
.trend-head { background: #f5f6f8; color: #999; font-weight: 600; }
.trend-row { border-top: 1rpx solid #f4f4f4; color: #555; }
.trend-head text, .trend-row text { flex: 1; text-align: center; }
.ann-form { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; display: flex; flex-direction: column; gap: 16rpx; }
.ann-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.ann-textarea { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 26rpx; min-height: 160rpx; width: 100%; box-sizing: border-box; }
.ann-submit { background: #ff4d6d; color: #fff; font-size: 28rpx; border-radius: 8rpx; }
