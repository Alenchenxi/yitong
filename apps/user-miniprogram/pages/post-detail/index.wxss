.page {
  padding: 20rpx 24rpx 160rpx;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 16rpx;
}
.avatar-ph {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #ffb3c1, #ff8fa3);
  color: #fff; font-size: 28rpx; font-weight: 600;
}
.meta { flex: 1; }
.nickname { font-size: 28rpx; font-weight: 600; color: #222; }
.anon-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #1D2129;
  background: #FFF7D1;
  border-radius: 999rpx;
  vertical-align: middle;
}
.time { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.content { font-size: 30rpx; line-height: 1.6; color: #222; white-space: pre-wrap; word-break: break-word; }
.images { display: grid; gap: 8rpx; margin-top: 16rpx; }
.images-one { grid-template-columns: 1fr; }
.images-two { grid-template-columns: repeat(2, 1fr); }
.images-three { grid-template-columns: repeat(3, 1fr); }
.img { background: #f2f2f2; border-radius: 8rpx; width: 100%; }
.img-one { height: 360rpx; width: 540rpx; }
.img-two { height: 200rpx; }
.img-three { height: 200rpx; }

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.tag {
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  color: #4E5969;
  background: #F2F3F5;
  border-radius: 999rpx;
}

.video {
  width: 100%;
  height: 380rpx;
  margin-top: 16rpx;
  border-radius: 8rpx;
  background: #000;
}
.stats {
  display: flex; gap: 32rpx; color: #999; font-size: 24rpx;
  margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0;
}
.report-link { margin-left: auto; color: #ccc; font-size: 22rpx; }
.fav-link { color: var(--yt-text-weak); font-size: 22rpx; margin-right: 16rpx; }
.fav-link.faved { color: var(--yt-primary); }
.follow-btn { padding: 8rpx 24rpx; border-radius: 999rpx; background: var(--yt-primary); color: var(--yt-text-main); font-size: 24rpx; font-weight: 600; margin-left: 16rpx; }
.follow-btn.followed { background: var(--yt-disabled-bg); color: var(--yt-text-sub); font-weight: 400; }

.comments {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.comments-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.comment {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f4f4;
}

.comment:last-child { border-bottom: none; }

.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb3c1, #ff8fa3);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.c-ph { text-align: center; }

.c-main {
  flex: 1;
}

.c-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.c-nick {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.c-time {
  font-size: 22rpx;
  color: #aaa;
}

.c-content {
  font-size: 28rpx;
  line-height: 1.5;
  color: #222;
  word-break: break-word;
}

.c-actions { margin-top: 8rpx; }
.c-reply {
  display: inline-block;
  font-size: 22rpx;
  color: #86909C;
  padding: 4rpx 0;
}

/* P0-10 子回复 */
.replies {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #F7F8FA;
  border-radius: 8rpx;
}
.reply {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 6rpx 0;
}
.reply-main {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #4E5969;
  word-break: break-word;
}
.r-nick { color: #1D2129; font-weight: 500; }
.r-reply-to { color: #86909C; }
.r-content { color: #4E5969; }
.r-reply { flex-shrink: 0; margin-left: 16rpx; }

.tip {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* 底部输入栏 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #86909C;
}
.reply-cancel { font-size: 32rpx; color: #C9CDD4; padding: 0 8rpx; }

.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  flex: 1;
  background: #f5f6f8;
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  font-size: 28rpx;
}

.like-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}
.like-btn.liked { color: #ff4d6d; }

.send-btn {
  background: #ff4d6d !important;
  color: #fff !important;
  border-radius: 32rpx !important;
  font-size: 26rpx !important;
}

.send-btn[disabled] {
  background: #ffb3c1 !important;
  color: #fff !important;
}
