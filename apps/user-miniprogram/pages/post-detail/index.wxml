<view class="page" wx:if="{{post}}">
  <!-- 详情头：头像昵称时间 + 正文 + 图 -->
  <view class="detail-card">
    <view class="header">
      <image wx:if="{{post.authorAvatarUrl}}" class="avatar" src="{{post.authorAvatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-ph">{{post.authorNickname[0]}}</view>
      <view class="meta">
        <view class="nickname">
          {{post.authorNickname}}
          <text class="yt-platform-badge" wx:if="{{post.platformPublished}}">平台发布</text>
          <text class="anon-badge" wx:if="{{post.isAnonymous}}">匿名</text>
          <text class="boost-badge" wx:if="{{post.boosted}}">推广</text>
        </view>
        <view class="time">{{post.timeText}}</view>
      </view>
      <view class="follow-btn {{post.following ? 'followed' : ''}}" wx:if="{{!post.isAnonymous}}" catchtap="onFollow">{{post.following ? '已关注' : '关注'}}</view>
    </view>
    <view class="content">{{post.content}}</view>
    <view class="tags" wx:if="{{post.tags.length}}">
      <text class="tag" wx:for="{{post.tags}}" wx:key="*this">#{{item}}</text>
    </view>
    <video wx:if="{{post.videoUrl}}" class="video" src="{{post.videoUrl}}" poster="{{post.videoCover}}" object-fit="cover" controls></video>
    <view class="images images-{{post.imgLayout}}" wx:elif="{{post.imgLayout}}">
      <image
        wx:for="{{post.images}}"
        wx:key="*this"
        class="img img-{{post.imgLayout}}"
        src="{{item}}"
        mode="aspectFill"
        data-src="{{item}}"
        bindtap="previewImage"
      ></image>
    </view>
    <view class="stats">
      <text>♥ {{post.likeCount}}</text>
      <text>💬 {{post.commentCount}}</text>
      <text>👁 {{post.viewCount}}</text>
      <button class="share-btn" open-type="share">↗ 转发</button>
      <text class="report-link" bindtap="onReport">举报</text>
      <text class="fav-link {{post.favorited ? 'faved' : ''}}" bindtap="onFavorite">{{post.favorited ? '★' : '☆'}} 收藏</text>
    </view>
    <!-- P1-10 作者操作（自己的帖） -->
    <view class="author-actions" wx:if="{{isAuthor}}">
      <text class="author-btn" bindtap="onEdit">编辑</text>
      <text class="author-btn" bindtap="onBoost">提升曝光</text>
      <text class="author-btn danger" bindtap="onDelete">删除</text>
    </view>
    <view class="edited-tip" wx:if="{{post.editedAt && isAuthor}}">已编辑于 {{post.editedAt}}</view>
  </view>

  <view class="comments">
    <view class="comments-title">评论 ({{post.commentCount}})</view>
    <view class="comment {{anchorId === item.id ? 'anchor' : ''}}" id="c-{{item.id}}" wx:for="{{commentList}}" wx:key="id">
      <view class="c-avatar">
        <text class="c-ph">{{item.authorNickname[0]}}</text>
      </view>
      <view class="c-main">
        <view class="c-head">
          <text class="c-nick">{{item.authorNickname}}</text>
          <text class="c-pin" wx:if="{{item.pinned}}">置顶</text>
          <text class="c-time">{{item.timeText}}</text>
        </view>
        <view class="c-content">{{item.content}}</view>
        <view class="c-actions">
          <text class="c-reply" data-parent-id="{{item.id}}" data-nickname="{{item.authorNickname}}" catchtap="startReply">回复</text>
          <text class="c-like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" catchtap="onCommentLike">
            <text class="c-like-icon">{{item.liked ? '♥' : '♡'}}</text>
            <text class="c-like-count" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text>
          </text>
        </view>
        <view class="replies" wx:if="{{item.replies.length}}">
          <view class="reply {{anchorId === r.id ? 'anchor' : ''}}" id="c-{{r.id}}" wx:for="{{item.replies}}" wx:for-item="r" wx:key="id">
            <view class="reply-main">
              <text class="r-nick">{{r.authorNickname}}</text>
              <text class="r-reply-to" wx:if="{{r.replyToNickname}}"> 回复 {{r.replyToNickname}}</text>
              <text class="r-content">：{{r.content}}</text>
            </view>
            <view class="reply-actions">
              <text class="c-like r-like {{r.liked ? 'liked' : ''}}" data-id="{{r.id}}" catchtap="onCommentLike">
                <text class="c-like-icon">{{r.liked ? '♥' : '♡'}}</text>
                <text class="c-like-count" wx:if="{{r.likeCount > 0}}">{{r.likeCount}}</text>
              </text>
              <text class="c-reply r-reply" data-parent-id="{{item.id}}" data-reply-to-id="{{r.id}}" data-nickname="{{r.authorNickname}}" catchtap="startReply">回复</text>
            </view>
          </view>
        </view>
        <!-- P1-01 回复分页：预览 3 条，更多走分页加载 -->
        <view
          class="reply-more"
          wx:if="{{item.replies.length < item.replyCount}}"
          data-id="{{item.id}}"
          catchtap="loadMoreReplies"
        >{{item.replyLoading ? '加载中…' : (item.replyPage <= 1 ? '查看全部 ' + item.replyCount + ' 条回复' : '展开更多回复（剩余 ' + (item.replyCount - item.replies.length) + ' 条）')}}</view>
      </view>
    </view>
    <view class="tip" wx:if="{{commentList.length === 0 && !loading}}">还没有评论，来说点什么吧</view>
    <view class="tip" wx:if="{{loading}}">加载中...</view>
    <view class="tip" wx:elif="{{!hasMore && commentList.length > 0}}">没有更多评论了</view>
  </view>
</view>

<view class="bar" wx:if="{{post}}">
  <view class="reply-bar" wx:if="{{reply}}">
    <text class="reply-hint">回复 {{reply.nickname}}</text>
    <text class="reply-cancel" catchtap="cancelReply">×</text>
  </view>
  <view class="bar-row">
    <input
      class="input"
      placeholder="{{reply ? '回复 ' + reply.nickname + '…' : (focus ? '写下你的评论…' : '说点什么…')}}"
      value="{{commentText}}"
      bindinput="onInput"
      focus="{{focus}}"
      confirm-type="send"
      bindconfirm="sendComment"
      adjust-position
    />
    <view class="like-btn {{post.liked ? 'liked' : ''}}" bindtap="onLike">
      <text>{{post.liked ? '♥' : '♡'}}</text>
    </view>
    <button class="send-btn" size="mini" bindtap="sendComment" disabled="{{!commentText || sending}}">发送</button>
  </view>
</view>
