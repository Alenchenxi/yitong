<view class="page">
  <!-- 匿名身份卡 -->
  <view class="anon-card yt-card" bindtap="goProfile">
    <view class="anon-avatar">🌙</view>
    <view class="anon-info">
      <view class="anon-nick">{{anonNickname || '匿名用户'}}</view>
      <view class="anon-sub">匿名身份 · 点击编辑资料</view>
    </view>
    <view class="anon-tag yt-tag-accent">匿名</view>
  </view>

  <!-- 入口区：心情 / 灵魂问卷 / 随机匹配 / 群聊广场 -->
  <view class="entries">
    <view class="entry" bindtap="goMood">
      <view class="entry-icon">💭</view>
      <view class="entry-text">心情</view>
    </view>
    <view class="entry" bindtap="goQuiz">
      <view class="entry-icon">✨</view>
      <view class="entry-text">灵魂问卷</view>
    </view>
    <view class="entry" bindtap="goMatch">
      <view class="entry-icon">🎲</view>
      <view class="entry-text">随机匹配</view>
    </view>
    <view class="entry" bindtap="goMatches">
      <view class="entry-icon">📋</view>
      <view class="entry-text">匹配历史</view>
    </view>
    <view class="entry" bindtap="goGroups">
      <view class="entry-icon">👥</view>
      <view class="entry-text">群聊广场</view>
    </view>
  </view>

  <!-- tab：推荐/最新/情绪 -->
  <view class="main-tabs">
    <view class="main-tab {{activeTab === 'recommend' ? 'active' : ''}}" data-tab="recommend" bindtap="switchTab">推荐</view>
    <view class="main-tab {{activeTab === 'latest' ? 'active' : ''}}" data-tab="latest" bindtap="switchTab">最新</view>
    <view class="main-tab {{activeTab === 'mood' ? 'active' : ''}}" data-tab="mood" bindtap="switchTab">情绪</view>
  </view>

  <!-- 情绪分类筛选 -->
  <scroll-view scroll-x class="mood-bar" wx:if="{{activeTab === 'mood'}}">
    <view class="mood-chip {{selectedMood === item ? 'on' : ''}}" wx:for="{{moods}}" wx:key="*this" data-mood="{{item}}" bindtap="pickMood">{{item}}</view>
  </scroll-view>

  <!-- 广场列表 -->
  <view class="list" wx:if="{{posts.length > 0}}">
    <view class="card yt-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="anon" data-anon-id="{{item.anonId}}" catchtap="goAuthor">🌙 {{item.anonShort}}<text wx:if="{{item.mood}}" class="post-mood">{{item.mood}}</text><text wx:if="{{item.boosted}}" class="post-boost">推广</text></view>
      <view class="content">{{item.content}}</view>
      <view class="row">
        <text class="time">{{item.timeText}}</text>
        <view class="row-stats">
          <text class="stat">💬 {{item.commentCount || 0}}</text>
          <text class="stat">👁 {{item.viewCount || 0}}</text>
          <!-- 转发给微信好友：open-type=share 触发宿主页 onShareAppMessage；catchtap 吞冒泡防跳详情 -->
          <button class="share-btn" open-type="share" data-id="{{item.id}}" catchtap="onShareTap">↗</button>
          <view class="like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" catchtap="onLike">
            {{item.liked ? '♥' : '♡'}} {{item.likeCount || 0}}
          </view>
        </view>
      </view>
    </view>
    <view class="tip" wx:if="{{loading}}">加载中...</view>
    <view class="tip" wx:elif="{{!hasMore}}">没有更多了</view>
  </view>

  <view class="yt-empty" wx:elif="{{!loading}}">
    <view class="yt-empty-emoji">🌙</view>
    <view class="yt-empty-text">树洞空空的，说点什么吧</view>
  </view>

  <!-- 发动态 FAB -->
  <view class="fab" bindtap="goPost">
    <text class="fab-plus">＋</text>
  </view>
</view>
