.page { padding: 24rpx; padding-bottom: 80rpx; }
.form-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 16rpx; }
.label { width: 160rpx; font-size: 28rpx; color: var(--yt-text-main); }
.avatar-preview { width: 96rpx; height: 96rpx; border-radius: 20rpx; background: var(--yt-primary-lighter); display: flex; align-items: center; justify-content: center; font-size: 56rpx; }
.emoji-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; padding: 16rpx; background: var(--yt-card); border-radius: 16rpx; }
.emoji-opt { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; }
.emoji { font-size: 40rpx; padding: 6rpx; border-radius: 12rpx; }
.emoji.on { background: var(--yt-primary); }
.block { background: var(--yt-card); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.block .label { display: block; width: auto; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--yt-border); }
.row:last-child { border-bottom: none; }
.input { flex: 1; font-size: 28rpx; }
.textarea { width: 100%; min-height: 80rpx; font-size: 28rpx; line-height: 1.6; }
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { padding: 10rpx 24rpx; border-radius: 999rpx; background: var(--yt-disabled-bg); font-size: 24rpx; color: var(--yt-text-sub); }
.tag.on { background: var(--yt-primary); color: var(--yt-text-main); font-weight: 600; }
.submit { width: 100%; background: var(--yt-primary) !important; color: var(--yt-text-main) !important; border-radius: 48rpx !important; font-size: 30rpx !important; font-weight: 600; margin-top: 24rpx; }
.submit[disabled] { background: var(--yt-disabled-bg) !important; color: var(--yt-text-sub) !important; }
