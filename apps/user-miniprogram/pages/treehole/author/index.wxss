.page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.author-head { display: flex; align-items: center; gap: 20rpx; }
.author-avatar {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #FFF7D1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.author-main { flex: 1; min-width: 0; }
.author-name { font-size: 36rpx; font-weight: 700; color: #1D2129; word-break: break-all; }
.author-meta { margin-top: 8rpx; font-size: 24rpx; color: #86909C; }
.anon-badge { padding: 6rpx 16rpx; border-radius: 8rpx; background: #F9C801; color: #1D2129; font-size: 22rpx; font-weight: 600; }
.mood { margin-top: 28rpx; font-size: 26rpx; color: #4E5969; }
.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.tag { padding: 8rpx 18rpx; border-radius: 8rpx; background: #F2F3F5; color: #4E5969; font-size: 23rpx; }
.section-title { margin: 42rpx 0 18rpx; font-size: 30rpx; font-weight: 700; color: #1D2129; }
.post-list { display: flex; flex-direction: column; gap: 18rpx; }
.post-card { background: #FFFFFF; border: 1rpx solid #E5E6EB; border-radius: 16rpx; padding: 24rpx; }
.post-content { font-size: 29rpx; line-height: 1.65; color: #1D2129; white-space: pre-wrap; word-break: break-word; }
.post-images { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 18rpx; }
.post-image { width: 100%; height: 190rpx; border-radius: 8rpx; background: #F2F3F5; }
.post-foot { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; }
.post-time { flex-shrink: 0; font-size: 22rpx; color: #86909C; }
.post-stats { display: flex; align-items: center; justify-content: flex-end; gap: 18rpx; font-size: 22rpx; color: #86909C; }
.like.liked { color: #C59A00; }
.loading-state, .error-state, .empty-posts, .list-tip { text-align: center; color: #86909C; font-size: 26rpx; }
.loading-state { padding-top: 280rpx; }
.error-state { padding-top: 220rpx; }
.error-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.error-desc { margin-top: 14rpx; }
.retry-btn { width: 280rpx; margin-top: 36rpx; border-radius: 40rpx; background: #F9C801; color: #1D2129; font-size: 26rpx; }
.empty-posts { padding: 100rpx 0; }
.list-tip { padding: 24rpx 0; }
.chat-fab {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #F9C801 !important;
  color: #1D2129 !important;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 20;
}
.chat-fab[disabled] { background: #F2F3F5 !important; color: #86909C !important; }
