<view class="page">
  <!-- 无 anonToken：显式初始化匿名身份引导（不再静默签发） -->
  <view wx:if="{{needAnon}}" class="anon-guide">
    <view class="anon-guide-emoji">🌙</view>
    <view class="anon-guide-title">需要匿名身份</view>
    <view class="anon-guide-desc">评论、点赞、转发都需要先初始化你的树洞匿名身份</view>
    <button class="anon-guide-btn" bindtap="initAnon">初始化匿名身份</button>
  </view>

  <block wx:else>
    <view wx:if="{{post}}" class="card">
      <view class="anon" catchtap="goAuthor">树洞 {{post.anonShort}}<text class="boost-badge" wx:if="{{post.boosted}}">推广</text></view>
      <view class="content">{{post.content}}</view>
      <view wx:if="{{post.images.length > 0}}" class="images">
        <image wx:for="{{post.images}}" wx:key="*this" class="image" src="{{item}}" mode="aspectFill" data-src="{{item}}" catchtap="previewImage" />
      </view>
      <!-- 统计：浏览数 / 评论数 / 转发给微信好友 -->
      <view class="stats">
        <text>👁 {{post.viewCount}}</text>
        <text>💬 {{post.commentCount}}</text>
        <button class="share-btn" open-type="share">↗ 转发</button>
      </view>
      <view class="row">
        <text class="time">{{post.timeText}}</text>
        <view class="actions">
          <view class="boost" wx:if="{{isAuthor}}" catchtap="onBoost">提升曝光</view>
          <view class="block" catchtap="blockAuthor">屏蔽</view>
          <view class="like {{post.liked ? 'liked' : ''}}" catchtap="onLike">
            {{post.liked ? '已赞' : '点赞'}} {{post.likeCount || ''}}
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{!loading}}" class="empty">
      <view class="empty-title">帖子不存在或已下架</view>
    </view>

    <!-- 评论区（平铺无回复，最新优先） -->
    <view class="comments" wx:if="{{post}}">
      <view class="comments-title">评论 ({{post.commentCount}})</view>
      <view class="comment" wx:for="{{comments}}" wx:key="id">
        <view class="c-head">
          <text class="c-lz" wx:if="{{item.isLZ}}">楼主</text>
          <text class="c-anon">{{item.anonShort}}</text>
          <text class="c-time">{{item.timeText}}</text>
        </view>
        <view class="c-content">{{item.content}}</view>
        <view class="c-actions">
          <text class="c-like {{item.liked ? 'liked' : ''}}" data-id="{{item.id}}" catchtap="onCommentLike">
            {{item.liked ? '♥' : '♡'}} {{item.likeCount || ''}}
          </text>
        </view>
      </view>
      <view class="tip" wx:if="{{comments.length === 0 && !loadingComments}}">还没有评论，来说点什么吧</view>
      <view class="tip" wx:if="{{loadingComments}}">加载中...</view>
      <view class="tip" wx:elif="{{!hasMoreComments && comments.length > 0}}">没有更多评论了</view>
    </view>

    <!-- 底部评论输入条 -->
    <view class="bar" wx:if="{{post}}">
      <input
        class="bar-input"
        placeholder="写下你的评论…"
        value="{{commentText}}"
        bindinput="onCommentInput"
        focus="{{commentFocus}}"
        confirm-type="send"
        bindconfirm="sendComment"
        adjust-position
      />
      <button class="bar-send" size="mini" bindtap="sendComment" disabled="{{!commentText || sendingComment}}">发送</button>
    </view>
  </block>
</view>
