.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 20rpx;
}
.tip {
  font-size: 22rpx;
  color: #C9CDD4;
  font-weight: 400;
  margin-left: 8rpx;
}

.nick-input {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.avatars {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 16rpx;
}
.avatar-opt {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #F7F8FA;
  border-radius: 50%;
  border: 2rpx solid transparent;
}
.avatar-opt.on {
  background: #FFF7D1;
  border-color: #F9C801;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 24rpx;
}
.tag.on {
  background: #FFF7D1;
  color: #1D2129;
  font-weight: 500;
}

.block-list { display: flex; flex-direction: column; gap: 16rpx; }
.block-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 20rpx; background: #F7F8FA; border-radius: 12rpx; }
.block-name { font-size: 26rpx; color: #4E5969; }
.block-unblock { font-size: 24rpx; color: #E63946; padding: 6rpx 20rpx; border: 1rpx solid #E63946; border-radius: 28rpx; }
.block-empty { font-size: 26rpx; color: #C9CDD4; }

.save {
  width: 100%;
  background: #F9C801 !important;
  color: #1D2129 !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
  margin-top: 40rpx;
}
.save[disabled] {
  background: #FFF7D1 !important;
  color: #C9CDD4 !important;
}
