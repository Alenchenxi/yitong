.page { min-height: 100vh; display: flex; flex-direction: column; }
.center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.top-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.session-label { flex: 1; font-size: 26rpx; color: #4E5969; font-weight: 600; }
.countdown { flex: 1; font-size: 24rpx; color: #B45309; }
.countdown.expired { color: #E63946; }
.block-btn { font-size: 26rpx; color: #E63946; padding: 6rpx 20rpx; border: 1rpx solid #E63946; border-radius: 28rpx; }
.skip-btn { font-size: 26rpx; color: #86909C; padding: 6rpx 20rpx; border: 1rpx solid #C9CDD4; border-radius: 28rpx; }

/* P1-15 匹配度卡片 */
.match-card { background: linear-gradient(135deg, #FFF7D1, #FFE89A); padding: 20rpx 24rpx; border-radius: 0; }
.mc-score { font-size: 30rpx; font-weight: 700; color: #B45309; margin-bottom: 8rpx; }
.mc-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 8rpx; }
.mc-tag { padding: 4rpx 16rpx; background: #fff; color: #B45309; border-radius: 999rpx; font-size: 22rpx; font-weight: 500; }
.mc-peer-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.mc-peer-label { font-size: 22rpx; color: #86909C; }
.mc-peer-tag { font-size: 22rpx; color: #4E5969; background: rgba(255,255,255,0.6); padding: 2rpx 12rpx; border-radius: 999rpx; }

.emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.hint { font-size: 28rpx; color: #999; margin-bottom: 48rpx; }
.match-btn { background: #F9C801 !important; color: #1D2129 !important; border-radius: 48rpx !important; font-size: 30rpx !important; font-weight: 600; }
.match-btn[disabled] { background: #FFF7D1 !important; color: #C9CDD4 !important; }
.msgs { flex: 1; padding: 24rpx; overflow-y: auto; }
.message-row { display: flex; flex-direction: column; align-items: flex-start; width: 100%; margin-bottom: 20rpx; }
.message-row.mine { align-items: flex-end; }
.message-bubble {
  box-sizing: border-box;
  display: inline-flex;
  max-width: 50vw;
  padding: 16rpx 22rpx;
  background: #FFFEFA;
  border: 2rpx solid #C9CDD4;
  border-radius: 26rpx 26rpx 26rpx 6rpx;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}
.message-row.mine .message-bubble {
  background: #FFFEFA;
  border-color: #F59E0B;
  border-radius: 26rpx 26rpx 6rpx 26rpx;
  color: #1D2129;
}
.message-bubble.voice-bubble { min-width: 18vw; }
.msg-text {
  min-width: 0;
  max-width: 100%;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.message-time { margin-top: 8rpx; padding: 0 6rpx; color: #86909C; font-size: 20rpx; line-height: 1.3; }
.msg-img { width: 42vw; max-width: 100%; border-radius: 12rpx; display: block; }
/* P2-36 语音消息 */
.msg-voice { display: flex; align-items: center; justify-content: space-between; width: 100%; min-width: 0; }
.voice-icon { font-size: 26rpx; }
.voice-len { font-size: 26rpx; color: inherit; opacity: 0.75; }
.msg-voice.playing .voice-icon { color: #B45309; font-weight: 700; }
.record-btn { flex: 1; background: #f5f6f8; border-radius: 32rpx; padding: 14rpx 24rpx; font-size: 28rpx; text-align: center; color: #4E5969; user-select: none; }
.record-btn.recording { background: #F9C801; color: #1D2129; font-weight: 600; }
.empty-tip { text-align: center; color: #999; font-size: 26rpx; padding: 48rpx 0; }
.bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #eee; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.img-btn { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; font-size: 40rpx; color: #86909C; flex-shrink: 0; }
.input { flex: 1; background: #f5f6f8; border-radius: 32rpx; padding: 14rpx 24rpx; font-size: 28rpx; }
.send-btn { background: #F9C801 !important; color: #1D2129 !important; border-radius: 32rpx !important; font-size: 26rpx !important; font-weight: 600; }
.send-btn[disabled] { background: #FFF7D1 !important; color: #C9CDD4 !important; }
