<view class="page">
  <block wx:if="{{!matched}}">
    <view class="center">
      <view class="emoji">🔮</view>
      <view class="hint">随机匹配一位陌生人匿名聊天</view>
      <button class="match-btn" bindtap="startMatch" disabled="{{matching}}">{{matching ? '匹配中…' : '开始匹配'}}</button>
    </view>
  </block>

  <block wx:else>
    <!-- P1-15 匹配度卡片 -->
    <view class="match-card" wx:if="{{matchScore > 0 || matchedTags.length > 0}}">
      <view class="mc-score">匹配度 {{matchScore}}%</view>
      <view class="mc-tags" wx:if="{{matchedTags.length > 0}}">
        <text class="mc-tag" wx:for="{{matchedTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="mc-peer-tags" wx:if="{{peerTags.length > 0}}">
        <text class="mc-peer-label">TA 的标签：</text>
        <text class="mc-peer-tag" wx:for="{{peerTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <view class="top-bar">
      <view class="block-btn" bindtap="blockPeer">屏蔽对方</view>
    </view>
    <view class="msgs">
      <view class="msg {{item.mine ? 'mine' : 'peer'}}" wx:for="{{messages}}" wx:key="index">
        <image
          wx:if="{{item.type === 'image'}}"
          class="msg-img"
          src="{{item.content}}"
          mode="widthFix"
          data-url="{{item.content}}"
          bindtap="previewImage"
        ></image>
        <text wx:else>{{item.content}}</text>
      </view>
      <view class="empty-tip" wx:if="{{messages.length === 0}}">对方已连接，打个招呼吧</view>
    </view>
    <view class="bar">
      <view class="img-btn" bindtap="sendImage">📷</view>
      <input class="input" placeholder="发消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" adjust-position />
      <button class="send-btn" size="mini" bindtap="send">发送</button>
    </view>
  </block>
</view>
