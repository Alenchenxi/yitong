<view class="page">
  <block wx:if="{{!matched}}">
    <view class="center">
      <view class="emoji">🔮</view>
      <view class="hint">随机匹配一位陌生人匿名聊天</view>
      <button class="match-btn" bindtap="startMatch" disabled="{{matching}}">{{matching ? '匹配中…' : '开始匹配'}}</button>
    </view>
  </block>

  <block wx:else>
    <!-- P1-15 匹配度卡片 -->
    <view class="match-card" wx:if="{{matchScore > 0 || matchedTags.length > 0}}">
      <view class="mc-score">匹配度 {{matchScore}}%</view>
      <view class="mc-tags" wx:if="{{matchedTags.length > 0}}">
        <text class="mc-tag" wx:for="{{matchedTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="mc-peer-tags" wx:if="{{peerTags.length > 0}}">
        <text class="mc-peer-label">TA 的标签：</text>
        <text class="mc-peer-tag" wx:for="{{peerTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
    <view class="top-bar">
      <view class="countdown {{expired ? 'expired' : ''}}" wx:if="{{remainingText}}">⏳ {{remainingText}}</view>
      <view class="skip-btn" bindtap="skipPeer">跳过</view>
      <view class="block-btn" bindtap="blockPeer">屏蔽</view>
    </view>
    <view class="msgs">
      <view class="msg {{item.mine ? 'mine' : 'peer'}}" wx:for="{{messages}}" wx:key="index">
        <image
          wx:if="{{item.type === 'image'}}"
          class="msg-img"
          src="{{item.content}}"
          mode="widthFix"
          data-url="{{item.content}}"
          bindtap="previewImage"
        ></image>
        <!-- P1-18 语音气泡：按时长撑宽，点击播放 -->
        <view
          wx:elif="{{item.type === 'voice'}}"
          class="msg-voice {{item.mine ? 'mine' : 'peer'}} {{playingIdx === index ? 'playing' : ''}}"
          style="width: {{120 + (item.duration || 1) * 6 > 380 ? 380 : 120 + (item.duration || 1) * 6}}rpx"
          data-url="{{item.content}}"
          data-idx="{{index}}"
          bindtap="playVoice"
        >
          <text class="voice-icon">{{item.mine ? '◀' : '▶'}}</text>
          <text class="voice-len">{{item.duration || 1}}″</text>
        </view>
        <text wx:else>{{item.content}}</text>
      </view>
      <view class="empty-tip" wx:if="{{messages.length === 0}}">对方已连接，打个招呼吧</view>
    </view>
    <view class="bar">
      <view class="img-btn" bindtap="toggleVoiceMode">{{voiceMode ? '⌨️' : '🎤'}}</view>
      <view class="img-btn" wx:if="{{!voiceMode}}" bindtap="sendImage">📷</view>
      <!-- P1-18 语音模式：按住说话 -->
      <view
        wx:if="{{voiceMode}}"
        class="record-btn {{recording ? 'recording' : ''}}"
        bindtouchstart="startRecord"
        bindtouchend="stopRecord"
        bindtouchcancel="cancelRecord"
      >{{recording ? '松开 发送' : '按住 说话'}}</view>
      <block wx:else>
        <input class="input" placeholder="发消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" adjust-position />
        <button class="send-btn" size="mini" bindtap="send">发送</button>
      </block>
    </view>
  </block>
</view>
