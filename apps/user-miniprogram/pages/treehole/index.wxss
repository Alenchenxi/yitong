.page { padding: 0 24rpx 120rpx; }

/* 匿名身份卡 */
.anon-card { display: flex; align-items: center; margin-top: 16rpx; }
.anon-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--yt-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}
.anon-info { flex: 1; }
.anon-nick { font-size: 30rpx; font-weight: 600; color: var(--yt-text-main); }
.anon-sub { font-size: 22rpx; color: var(--yt-text-sub); margin-top: 4rpx; }

/* 入口区 */
.entries { display: flex; gap: 16rpx; margin-top: 20rpx; }
.entry {
  flex: 1;
  background: var(--yt-card);
  border: 1rpx solid var(--yt-border);
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
}
.entry-icon { font-size: 40rpx; }
.entry-text { font-size: 24rpx; color: var(--yt-text-body); margin-top: 8rpx; }

/* tab */
.main-tabs {
  display: flex;
  gap: 40rpx;
  padding: 24rpx 0 16rpx;
  position: sticky;
  top: 0;
  background: var(--yt-bg);
  z-index: 9;
}
.main-tab { font-size: 28rpx; color: var(--yt-text-sub); padding: 8rpx 0; position: relative; }
.main-tab.active { color: var(--yt-text-main); font-weight: 600; }
.main-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 32rpx;
  height: 4rpx;
  background: var(--yt-primary);
  border-radius: 2rpx;
}

/* P0-13 情绪分类筛选条 */
.mood-bar { white-space: nowrap; padding: 4rpx 0 16rpx; }
.mood-chip {
  display: inline-block;
  margin-right: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--yt-card);
  border: 1rpx solid var(--yt-border);
  color: var(--yt-text-sub);
  font-size: 24rpx;
}
.mood-chip.on { background: #FFF7D1; color: var(--yt-text-main); border-color: var(--yt-primary); font-weight: 500; }
.post-mood {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--yt-disabled-bg);
  color: var(--yt-text-sub);
  font-size: 20rpx;
  font-weight: 400;
}
.post-boost {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-size: 20rpx;
  font-weight: 600;
}

/* 列表 */
.list { margin-top: 8rpx; }
.anon { font-size: 24rpx; color: var(--yt-primary-dark); font-weight: 600; }
.content { font-size: 30rpx; line-height: 1.6; color: var(--yt-text-main); margin: 12rpx 0; white-space: pre-wrap; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.time { font-size: 22rpx; color: var(--yt-text-sub); }
.row-stats { display: flex; align-items: center; gap: 20rpx; }
.stat { font-size: 22rpx; color: var(--yt-text-sub); }
.share-btn { font-size: 26rpx; color: var(--yt-text-sub) !important; background: transparent !important; line-height: normal; padding: 0; margin: 0; }
.share-btn::after { border: none; }
.like { font-size: 26rpx; color: var(--yt-text-sub); }
.like.liked { color: var(--yt-primary); }
.tip { text-align: center; color: var(--yt-text-sub); font-size: 24rpx; padding: 24rpx 0; }

/* FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 96rpx;
  height: 96rpx;
  background: var(--yt-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(249, 200, 1, 0.4);
  z-index: 20;
}
.fab-plus { font-size: 48rpx; color: var(--yt-text-main); font-weight: 300; line-height: 1; }
