.page { padding: 32rpx 24rpx 60rpx; min-height: 100vh; }

.header { margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1D2129; }
.sub { font-size: 26rpx; color: #86909C; margin-top: 8rpx; line-height: 1.5; }

.type-list { display: flex; flex-direction: column; gap: 20rpx; }
.type-card {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border-radius: 16rpx; padding: 28rpx 24rpx;
}
.type-icon { font-size: 48rpx; width: 72rpx; text-align: center; }
.type-info { flex: 1; }
.type-title { font-size: 30rpx; font-weight: 600; color: #1D2129; }
.type-desc { font-size: 24rpx; color: #86909C; margin-top: 4rpx; }
.arrow { font-size: 36rpx; color: #C9CDD4; }

.quiz-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.quiz-title { font-size: 32rpx; font-weight: 600; color: #1D2129; }
.progress { font-size: 26rpx; color: #86909C; }
.progress-bar { height: 6rpx; background: #F2F3F5; border-radius: 3rpx; overflow: hidden; margin-bottom: 40rpx; }
.progress-fill { height: 100%; background: var(--yt-primary, #F9C801); transition: width 0.3s; }

.question { background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; }
.q-text { font-size: 32rpx; font-weight: 600; color: #1D2129; line-height: 1.5; margin-bottom: 28rpx; }
.options { display: flex; flex-direction: column; gap: 16rpx; }
.option {
  padding: 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4E5969;
  border: 2rpx solid transparent;
}
.option.on {
  background: #FFF7D1;
  border-color: var(--yt-primary, #F9C801);
  color: #1D2129;
  font-weight: 500;
}

.nav { display: flex; justify-content: space-between; margin-top: 40rpx; gap: 16rpx; }
.nav-btn {
  flex: 1; text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #4E5969;
  font-size: 28rpx;
}
.nav-btn.primary { background: var(--yt-primary, #F9C801); color: var(--yt-text-main, #1D2129); font-weight: 600; }

.result { text-align: center; padding-top: 120rpx; }
.result-emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.result-title { font-size: 32rpx; font-weight: 600; color: #1D2129; margin-bottom: 32rpx; }
.result-tags { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; margin-bottom: 24rpx; }
.result-tag {
  padding: 12rpx 32rpx;
  background: #FFF7D1;
  color: #B45309;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.result-tip { font-size: 24rpx; color: #86909C; margin-bottom: 60rpx; }
.result-actions { display: flex; gap: 16rpx; padding: 0 40rpx; }
