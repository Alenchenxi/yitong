<view class="page" wx:if="{{group}}">
  <view class="header">
    <view class="group-avatar">
      <image wx:if="{{group.avatarUrl}}" class="group-avatar-img" src="{{group.avatarUrl}}" mode="aspectFill"></image>
      <text wx:else>{{group.name.slice(0, 1)}}</text>
    </view>
    <view class="group-name">{{group.name}}</view>
    <view class="group-meta">
      <text class="group-private" wx:if="{{group.isPrivate}}">🔒 私密</text>
      <text class="group-count">👥 {{group.memberCount}}/{{group.maxMembers}}</text>
    </view>
    <view class="group-desc" wx:if="{{group.description}}">{{group.description}}</view>
    <view class="group-tags" wx:if="{{group.tags.length > 0}}">
      <text class="group-tag" wx:for="{{group.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="announce" wx:if="{{group.announcement}}">
    <view class="announce-title">📢 群公告</view>
    <view class="announce-body">{{group.announcement}}</view>
  </view>

  <view class="action-row">
    <button wx:if="{{!group.isMember && !group.isPrivate}}" class="btn btn-primary" bindtap="join" disabled="{{acting}}">加入群聊</button>
    <button wx:if="{{group.isPrivate && !group.isMember}}" class="btn btn-disabled" disabled>私密群，需申请</button>
    <button wx:if="{{group.isMember}}" class="btn btn-danger" bindtap="leave" disabled="{{acting}}">{{isOwner ? '解散群聊' : '退出群聊'}}</button>
  </view>

  <view class="members-section">
    <view class="members-title">成员 ({{members.length}})<text class="members-hint" wx:if="{{canManage}}"> · 点击成员可管理</text></view>
    <view class="member" wx:for="{{members}}" wx:key="anonId" bindtap="onTapMember" data-anon-id="{{item.anonId}}" data-nickname="{{item.nickname}}" data-role="{{item.role}}">
      <view class="member-avatar">{{item.nickname.slice(0, 1)}}</view>
      <view class="member-info">
        <view class="member-name">{{item.nickname}}</view>
        <view class="member-role-row">
          <view class="member-role {{item.role}}">{{item.roleText}}</view>
          <text wx:if="{{item.muted}}" class="member-muted">已禁言</text>
        </view>
      </view>
      <text wx:if="{{canManage && item.role !== 'OWNER' && item.anonId !== myAnonId}}" class="member-transfer">›</text>
    </view>
  </view>

  <!-- P2-11 群消息流 -->
  <view class="chat-section">
    <view class="chat-title">群消息 ({{messages.length}})</view>
    <view class="chat-list" wx:if="{{messages.length > 0}}">
      <view wx:for="{{messages}}" wx:key="id">
        <view wx:if="{{item.type === 'system'}}" class="chat-system">{{item.contentText}}</view>
        <view wx:else class="chat-msg {{item.isMine ? 'mine' : ''}} {{item.deleted ? 'deleted' : ''}}">
          <view class="chat-meta">
            <text class="chat-nick">{{item.nickname}}</text>
            <text class="chat-time">{{item.createdAt}}</text>
          </view>
          <image
            wx:if="{{item.type === 'image' && !item.deleted}}"
            class="chat-img"
            src="{{item.content}}"
            mode="widthFix"
            data-url="{{item.content}}"
            bindtap="previewImg"
          ></image>
          <view wx:else class="chat-content">{{item.contentText}}</view>
          <view wx:if="{{item.isMine && !item.deleted}}" class="chat-revoke" data-id="{{item.id}}" bindtap="revokeMsg">撤回</view>
        </view>
      </view>
      <view class="chat-tip" wx:if="{{hasMoreMsg}}" bindtap="loadMore">加载更多</view>
      <view class="chat-tip" wx:elif="{{messages.length > 0}}">没有更多了</view>
    </view>
    <view class="chat-empty" wx:elif="{{!loading}}">暂无消息</view>
  </view>

  <!-- 发送输入（仅成员） -->
  <view class="chat-input" wx:if="{{group.isMember}}">
    <view class="img-btn" bindtap="sendImage">📷</view>
    <input class="input" placeholder="发消息…" value="{{draft}}" bindinput="onDraft" confirm-type="send" bindconfirm="send" />
    <button class="send-btn" size="mini" bindtap="send" disabled="{{sending || !draft.trim()}}">发送</button>
  </view>
  <view class="chat-input-disabled" wx:else>加入群聊后可发送消息</view>
</view>
