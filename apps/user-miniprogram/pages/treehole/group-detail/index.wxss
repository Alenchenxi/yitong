.page { padding: 0 0 120rpx; }
.header { padding: 32rpx 24rpx; background: var(--yt-card); border-bottom: 1rpx solid var(--yt-border); display: flex; flex-direction: column; align-items: center; }
.group-avatar { width: 120rpx; height: 120rpx; border-radius: 24rpx; background: var(--yt-primary-lighter); display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 600; color: var(--yt-primary-dark); }
.group-name { font-size: 36rpx; font-weight: 700; color: var(--yt-text-main); margin-top: 16rpx; }
.group-meta { display: flex; gap: 16rpx; margin-top: 10rpx; }
.group-private { font-size: 24rpx; color: #B45309; background: #FFF7D1; padding: 4rpx 14rpx; border-radius: 999rpx; }
.group-count { font-size: 24rpx; color: var(--yt-text-sub); }
.group-desc { font-size: 26rpx; color: var(--yt-text-sub); margin-top: 12rpx; text-align: center; }
.group-tags { display: flex; gap: 10rpx; margin-top: 12rpx; flex-wrap: wrap; justify-content: center; }
.group-tag { font-size: 22rpx; color: var(--yt-primary-dark); background: var(--yt-primary-lighter); padding: 4rpx 14rpx; border-radius: 999rpx; }

.announce { margin: 16rpx 24rpx; padding: 20rpx; background: #FFF7E6; border: 1rpx solid #FFD591; border-radius: 16rpx; }
.announce-title { font-size: 26rpx; font-weight: 600; color: #B45309; margin-bottom: 8rpx; }
.announce-body { font-size: 26rpx; color: #874d00; line-height: 1.6; }

.action-row { padding: 24rpx; }
.btn { width: 100%; border-radius: 48rpx; font-size: 30rpx; font-weight: 600; padding: 20rpx 0; }
.btn-primary { background: var(--yt-primary) !important; color: var(--yt-text-main) !important; }
.btn-danger { background: #fff !important; color: #E63946 !important; border: 1rpx solid #E63946 !important; }
.btn-disabled { background: var(--yt-disabled-bg) !important; color: var(--yt-text-sub) !important; }
.btn[disabled] { opacity: 0.6; }

.members-section { background: var(--yt-card); border-radius: 16rpx; margin: 0 24rpx 24rpx; padding: 20rpx; }
.members-title { font-size: 28rpx; font-weight: 600; color: var(--yt-text-main); margin-bottom: 16rpx; }
.member { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--yt-border); }
.member:last-child { border-bottom: none; }
.member-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--yt-primary-lighter); display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 600; color: var(--yt-primary-dark); flex-shrink: 0; }
.member-info { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; }
.member-name { font-size: 28rpx; color: var(--yt-text-main); }
.member-role { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 999rpx; }
.member-role.OWNER { background: #F9C801; color: #1D2129; font-weight: 600; }
.member-role.ADMIN { background: var(--yt-primary-lighter); color: var(--yt-primary-dark); }
.member-role.MEMBER { background: var(--yt-disabled-bg); color: var(--yt-text-sub); }
