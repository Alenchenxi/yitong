<view class="page">
  <view class="banner">
    <view class="banner-title">候选人管理</view>
    <view class="banner-sub">跨岗位查看报名学生，点卡片进岗位处理</view>
  </view>

  <!-- M2-02 筛选区：岗位 / 状态 / 关键词 -->
  <view class="filter yt-card">
    <picker class="post-picker" range="{{postOptions}}" value="{{postIndex}}" bindchange="onPostChange">
      <view class="post-picker-inner">
        <text class="post-picker-text">{{postOptions[postIndex]}}</text>
        <text class="post-picker-arrow">▾</text>
      </view>
    </picker>
    <scroll-view class="status-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="status-row">
        <view
          wx:for="{{statusFilters}}"
          wx:key="value"
          class="status-chip {{activeStatus === item.value ? 'status-chip-active' : ''}}"
          data-value="{{item.value}}"
          catchtap="onStatusTap"
        >{{item.label}}</view>
      </view>
    </scroll-view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="搜索学生昵称 / 岗位标题"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view class="search-btn" catchtap="onSearch">搜索</view>
    </view>
  </view>

  <!-- M2-02 候选人列表 -->
  <view class="summary" wx:if="{{loaded}}">共 {{total}} 条报名</view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card yt-card"
    data-job-post-id="{{item.jobPostId}}"
    catchtap="onCardTap"
  >
    <view class="card-head">
      <text class="card-name">{{item.userNickname || '匿名用户'}}</text>
      <text class="tag tag-{{item.status}}">{{item.statusLabel}}</text>
    </view>
    <view class="card-line">岗位：{{item.jobPostTitle}}</view>
    <view class="card-line">简历：{{item.resumeSummary}}</view>
    <view class="card-foot">报名时间：{{item.createdAtText}}</view>
  </view>

  <view wx:if="{{loaded && list.length === 0}}" class="empty yt-card">
    <view class="empty-title">暂无候选人</view>
    <view class="empty-sub">用户在「兼职」tab 报名你的岗位后会出现在这里</view>
  </view>

  <view wx:if="{{loading}}" class="more">加载中…</view>
  <view wx:elif="{{loaded && list.length > 0 && list.length < total}}" class="more" catchtap="loadMore">加载更多</view>
  <view wx:elif="{{loaded && list.length >= total && total > 0}}" class="more more-end">没有更多了</view>

  <bottom-tab
    tabs="{{tabs}}"
    current="{{current}}"
  ></bottom-tab>
</view>
