.page {
  padding: 24rpx;
  padding-bottom: 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.empty {
  margin-top: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--yt-text-weak, #86909c);
}
.empty-title {
  font-size: 32rpx;
  color: var(--yt-text-main, #1d2129);
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
}