.page {
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.banner {
  background: linear-gradient(135deg, #ffe27a, var(--yt-primary, #f9c801));
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: var(--yt-text-main, #1d2129);
}
.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}
.banner-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.8;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 26rpx;
  color: var(--yt-text-weak, #86909c);
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--yt-border, #f0f0f0);
}
.row:last-child {
  border-bottom: none;
}
.row-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--yt-primary, #f9c801);
  color: var(--yt-text-main, #1d2129);
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.row-main {
  flex: 1;
  min-width: 0;
}
.row-title {
  font-size: 28rpx;
  color: var(--yt-text-main, #1d2129);
  font-weight: 500;
}
.row-sub {
  font-size: 22rpx;
  color: var(--yt-text-weak, #86909c);
  margin-top: 4rpx;
}

.placeholder {
  padding: 32rpx 0;
  text-align: center;
}
.placeholder-title {
  font-size: 28rpx;
  color: var(--yt-text-main, #1d2129);
  margin-bottom: 8rpx;
}
.placeholder-sub {
  font-size: 22rpx;
  color: var(--yt-text-weak, #86909c);
}