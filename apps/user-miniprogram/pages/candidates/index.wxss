.page {
  padding: 24rpx;
  padding-bottom: 160rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.banner {
  background: linear-gradient(135deg, #ffe27a, var(--yt-primary, #f9c801));
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: var(--yt-text-main, #1d2129);
}
.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}
.banner-sub {
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.8;
}

/* 筛选区 */
.filter {
  margin-bottom: 16rpx;
}
.post-picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--yt-bg, #f6f7fb);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.post-picker-text {
  font-size: 26rpx;
  color: var(--yt-text-main, #1d2129);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.post-picker-arrow {
  font-size: 24rpx;
  color: var(--yt-text-sub, #86909c);
  margin-left: 16rpx;
}
.status-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}
.status-row {
  display: inline-flex;
}
.status-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--yt-bg, #f6f7fb);
  color: var(--yt-text-body, #4e5969);
}
.status-chip-active {
  background: var(--yt-primary, #f9c801);
  color: var(--yt-text-main, #1d2129);
  font-weight: 600;
}
.search-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  background: var(--yt-bg, #f6f7fb);
  border-radius: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.search-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  background: var(--yt-primary, #f9c801);
  color: var(--yt-text-main, #1d2129);
  font-size: 26rpx;
  font-weight: 600;
}

.summary {
  font-size: 22rpx;
  color: var(--yt-text-sub, #86909c);
  margin: 8rpx 4rpx 16rpx;
}

/* 候选人卡片 */
.card {
  margin-bottom: 16rpx;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--yt-text-main, #1d2129);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.tag-PENDING {
  background: #fff7e6;
  color: #ff7d00;
}
.tag-ACCEPTED {
  background: #e8f7ee;
  color: var(--yt-success, #00b42a);
}
.tag-DONE {
  background: #e8f3ff;
  color: var(--yt-info, #2f80ed);
}
.tag-REJECTED {
  background: var(--yt-disabled-bg, #f2f3f5);
  color: var(--yt-text-sub, #86909c);
}
.tag-CANCELLED {
  background: var(--yt-disabled-bg, #f2f3f5);
  color: var(--yt-text-weak, #c9cdd4);
}
.card-line {
  font-size: 26rpx;
  color: var(--yt-text-body, #4e5969);
  margin-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.card-foot {
  font-size: 22rpx;
  color: var(--yt-text-sub, #86909c);
  margin-top: 12rpx;
}

.empty {
  text-align: center;
  padding: 64rpx 24rpx;
}
.empty-title {
  font-size: 28rpx;
  color: var(--yt-text-main, #1d2129);
  margin-bottom: 8rpx;
}
.empty-sub {
  font-size: 22rpx;
  color: var(--yt-text-sub, #86909c);
}

.more {
  text-align: center;
  font-size: 24rpx;
  color: var(--yt-text-sub, #86909c);
  padding: 24rpx 0;
}
.more-end {
  color: var(--yt-text-weak, #c9cdd4);
}
