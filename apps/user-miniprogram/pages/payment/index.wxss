.page { padding: 24rpx; background: #F6F7FB; min-height: 100vh; }
.card { background: #FFFFFF; border-radius: 16rpx; padding: 32rpx; margin-bottom: 32rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #1D2129; margin-bottom: 8rpx; }
.subtitle { font-size: 26rpx; color: #86909C; margin-bottom: 24rpx; }
.row { font-size: 28rpx; color: #4E5969; margin-top: 12rpx; }
.pay-btn {
  background: #F9C801 !important;
  color: #1D2129 !important;
  border-radius: 48rpx !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border: none;
}
.pay-btn[disabled] { background: #F2F3F5 !important; color: #86909C !important; }
.hint { text-align: center; color: #86909C; font-size: 22rpx; margin-top: 20rpx; }
.success { text-align: center; padding-top: 80rpx; }
.success-emoji { font-size: 96rpx; }
.success-text { font-size: 30rpx; color: #1D2129; margin: 24rpx 0 40rpx; }
.back-btn { background: #FFFFFF !important; color: #1D2129 !important; border-radius: 48rpx !important; border: 1rpx solid #F2F3F5 !important; }
