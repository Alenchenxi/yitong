.page { padding: 0 24rpx 120rpx; }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; }
.unread-text { font-size: 26rpx; color: #ff4d6d; font-weight: 600; }
.read-all { font-size: 26rpx; color: #1677ff; }
.list { margin-top: 8rpx; }
.item { display: flex; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; position: relative; }
.item.unread { background: #fff8f9; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ff4d6d; margin-right: 16rpx; margin-top: 8rpx; flex-shrink: 0; }
.main { flex: 1; min-width: 0; }
.title { font-size: 30rpx; font-weight: 600; color: #222; }
.content { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.time { font-size: 22rpx; color: #aaa; margin-top: 12rpx; }
.empty { text-align: center; padding-top: 200rpx; color: #999; }
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; }
