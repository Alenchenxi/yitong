<view class="page">
  <!-- 圈子背景图：广场沉浸式头部使用 -->
  <view class="background-picker" bindtap="chooseBackground">
    <image wx:if="{{backgroundImage}}" class="background-preview" src="{{backgroundImage}}" mode="aspectFill" />
    <view wx:else class="background-empty">
      <view class="background-plus">＋</view>
      <view>{{backgroundUploading ? '上传中…' : '上传圈子背景图（可选）'}}</view>
      <view class="background-help">建议横向图片，广场顶部会自动裁切</view>
    </view>
    <view wx:if="{{backgroundImage}}" class="background-change">点击更换背景图</view>
  </view>

  <!-- LOGO 选择 -->
  <view class="logo-row" bindtap="chooseLogo">
    <image wx:if="{{logo}}" class="logo" src="{{logo}}" mode="aspectFill" />
    <view wx:else class="logo logo-fallback">{{uploading ? '上传中…' : '＋'}}</view>
    <view class="logo-tip">{{logo ? '点击更换 LOGO' : '上传圈子 LOGO（可选）'}}</view>
  </view>

  <!-- 名称 -->
  <view class="field">
    <text class="label">圈子名称 *</text>
    <input class="input" placeholder="1-20 个字，如：综合大学" maxlength="20" value="{{name}}" bindinput="onNameInput" />
  </view>

  <!-- 类型 -->
  <view class="field">
    <text class="label">圈子类型 *</text>
    <view class="chips">
      <view
        class="chip {{category === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="pickCategory"
      >{{item}}</view>
    </view>
  </view>

  <!-- 所在地区（省市区三级选择器） -->
  <view class="field">
    <text class="label">所在地区 *</text>
    <picker mode="region" bindchange="onRegionChange">
      <view class="input picker {{region ? '' : 'placeholder'}}">{{region || '请选择省 / 市 / 区'}}</view>
    </picker>
  </view>

  <!-- 所在地点（地图搜索选点，复用岗位发布 place-suggest） -->
  <view class="field">
    <text class="label">所在地点 *</text>
    <input
      class="input"
      placeholder="搜索地点（如：图书馆 / 大学生活动中心）"
      value="{{searchInput}}"
      bindinput="onSearchInput"
      bindfocus="onSearchFocus"
      bindblur="onSearchBlur"
      confirm-type="search"
    />
    <view wx:if="{{location && !searchFocus}}" class="locked-location">📍 {{location}}</view>
    <view wx:if="{{candidates.length > 0}}" class="candidates">
      <view
        wx:for="{{candidates}}"
        wx:key="poiId"
        wx:for-index="idx"
        class="candidate"
        bindtap="onPickCandidate"
        data-idx="{{idx}}"
      >
        <view class="candidate-icon">📍</view>
        <view class="candidate-info">
          <view class="candidate-address">{{item.address}}</view>
          <view class="candidate-city">{{item.city}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 简介 -->
  <view class="field">
    <text class="label">圈子简介</text>
    <textarea class="textarea" placeholder="一句话介绍这个圈子（可选）" maxlength="200" value="{{description}}" bindinput="onDescInput" auto-height />
  </view>

  <button class="submit-btn" bindtap="submit" disabled="{{submitting || uploading || backgroundUploading}}">{{submitting ? '创建中…' : '创建圈子'}}</button>
</view>
