.page { padding: 32rpx 24rpx; }
.logo-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
}
.logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--yt-disabled-bg);
  color: var(--yt-text-sub);
  font-size: 56rpx;
  border: 1rpx dashed var(--yt-border);
}
.logo-tip { font-size: 24rpx; color: var(--yt-text-sub); margin-top: 16rpx; }
.field { margin-bottom: 32rpx; }
.label { font-size: 28rpx; color: var(--yt-text-main); font-weight: 600; display: block; margin-bottom: 12rpx; }
.input {
  background: var(--yt-card);
  border: 1rpx solid var(--yt-border);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 36rpx;
  background: var(--yt-disabled-bg);
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--yt-text-sub);
  border: 2rpx solid transparent;
}
.chip.active {
  background: var(--yt-primary-lighter);
  color: var(--yt-primary-dark);
  border-color: var(--yt-primary);
  font-weight: 600;
}
.picker {
  /* 复用 .input 盒子，文本垂直居中 */
  display: flex;
  align-items: center;
  min-height: 44rpx;
}
.placeholder { color: var(--yt-text-sub); }
.locked-location {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--yt-text-main);
  background: var(--yt-primary-lighter);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
}
.candidates {
  margin-top: 16rpx;
  border: 1rpx solid var(--yt-border);
  border-radius: 12rpx;
  background: var(--yt-card);
  max-height: 600rpx;
  overflow-y: auto;
}
.candidate {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--yt-border);
}
.candidate:last-child { border-bottom: none; }
.candidate-icon { font-size: 28rpx; flex: 0 0 auto; }
.candidate-info { flex: 1 1 auto; min-width: 0; }
.candidate-address { font-size: 28rpx; color: var(--yt-text-main); }
.candidate-city { font-size: 22rpx; color: var(--yt-text-sub); padding-top: 4rpx; }
.textarea {
  background: var(--yt-card);
  border: 1rpx solid var(--yt-border);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
}
.submit-btn {
  margin-top: 48rpx;
  background: var(--yt-primary);
  color: var(--yt-text-main);
  font-size: 30rpx;
  border-radius: 999rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.submit-btn[disabled] { opacity: 0.6; }
