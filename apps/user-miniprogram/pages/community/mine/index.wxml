<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'joined' ? 'on' : ''}}" data-t="joined" bindtap="switchTab">已加入<text wx:if="{{joined.length > 0}}" class="count"> ({{joined.length}})</text></view>
    <view class="tab {{tab === 'pending' ? 'on' : ''}}" data-t="pending" bindtap="switchTab">待审核<text wx:if="{{pending.length > 0}}" class="count"> ({{pending.length}})</text></view>
    <view class="tab {{tab === 'rejected' ? 'on' : ''}}" data-t="rejected" bindtap="switchTab">未通过<text wx:if="{{rejected.length > 0}}" class="count"> ({{rejected.length}})</text></view>
  </view>

  <!-- 已加入 -->
  <block wx:if="{{tab === 'joined'}}">
    <view class="empty" wx:if="{{joined.length === 0}}">
      <view class="empty-text">你还没加入任何圈子</view>
      <button class="btn-primary" bindtap="goCreate">创建圈子</button>
      <button class="btn-secondary" bindtap="goPlaza">去圈子广场逛逛</button>
    </view>
    <view class="card" wx:for="{{joined}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onSwitch">
      <view class="card-title">{{item.name}}</view>
      <view class="card-meta">{{item.memberCount}} 位圈友 · {{item.postCount}} 条动态</view>
      <view class="card-region" wx:if="{{item.region || item.location}}">{{item.region || ''}}{{item.location ? ' · ' + item.location : ''}}</view>
    </view>
  </block>

  <!-- 待审核 -->
  <block wx:if="{{tab === 'pending'}}">
    <view class="empty" wx:if="{{pending.length === 0}}">
      <view class="empty-text">没有待审核的圈子</view>
      <button class="btn-primary" bindtap="goCreate">创建圈子</button>
    </view>
    <view class="card" wx:for="{{pending}}" wx:key="id">
      <view class="card-title-row">
        <text class="card-title">{{item.name}}</text>
        <text class="status status-pending">审核中</text>
      </view>
      <view class="card-meta">{{item.category}} · 创建于 {{item.createdAt}}</view>
      <view class="card-tip">管理员正在审核中，通过后会通知你</view>
    </view>
  </block>

  <!-- 未通过 -->
  <block wx:if="{{tab === 'rejected'}}">
    <view class="empty" wx:if="{{rejected.length === 0}}">
      <view class="empty-text">没有被拒绝的圈子</view>
    </view>
    <view class="card card-rejected" wx:for="{{rejected}}" wx:key="id">
      <view class="card-title-row">
        <text class="card-title">{{item.name}}</text>
        <text class="status status-rejected">未通过</text>
      </view>
      <view class="card-meta">{{item.category}} · 创建于 {{item.createdAt}}</view>
      <view class="reject-reason" wx:if="{{item.rejectReason}}">
        <text class="reject-label">拒绝原因：</text>
        <text class="reject-text">{{item.rejectReason}}</text>
      </view>
      <button
        class="btn-primary"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onResubmit"
        disabled="{{resubmittingId === item.id}}"
      >{{resubmittingId === item.id ? '提交中…' : '重新提交'}}</button>
    </view>
  </block>
</view>
