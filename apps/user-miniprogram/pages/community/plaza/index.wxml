<view class="page">
  <view class="layout">
    <!-- 左侧类型列表 -->
    <scroll-view class="left" scroll-y>
      <view
        class="cat {{activeCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="switchCategory"
      >{{item}}</view>
    </scroll-view>

    <!-- 右侧圈子列表 -->
    <scroll-view class="right" scroll-y>
      <view
        class="card yt-card"
        wx:for="{{circles}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onTapCircle"
      >
        <image wx:if="{{item.logo}}" class="logo" src="{{item.logo}}" mode="aspectFill" />
        <view wx:else class="logo logo-fallback">{{item.name[0]}}</view>
        <view class="info">
          <view class="name-row">
            <text class="name">{{item.name}}</text>
            <text class="joined-tag" wx:if="{{item.isMember}}">已加入</text>
          </view>
          <view class="stats">{{item.memberCount}} 成员 · 动态 {{item.postCount}}</view>
        </view>
        <view wx:if="{{!item.isMember}}" class="join-btn" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="onJoin">加入</view>
      </view>
      <view class="yt-empty" wx:if="{{!loading && circles.length === 0}}">
        <view class="yt-empty-emoji">🌐</view>
        <view class="yt-empty-text">该分类暂无圈子</view>
      </view>
      <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    </scroll-view>
  </view>
</view>
