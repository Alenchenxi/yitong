<view class="page">
  <view class="item" wx:for="{{reviews}}" wx:key="id">
    <view class="head">
      <text class="job">{{item.jobPostTitle}}</text>
      <text class="stars">{{'★'.repeat(item.rating)}}</text>
    </view>
    <view class="content">{{item.content}}</view>
    <view class="meta">{{item.reviewerNickname}} · {{item.createdAt}}</view>
  </view>
  <view class="empty" wx:if="{{reviews.length === 0 && !loading}}">暂无评价</view>
</view>
