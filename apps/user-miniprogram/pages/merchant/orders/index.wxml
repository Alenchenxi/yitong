<view class="page">
  <view class="item" wx:for="{{orders}}" wx:key="id">
    <view class="head">
      <text class="job">{{item.jobPostTitle}}</text>
      <text class="amount">¥{{item.amount}}</text>
    </view>
    <view class="meta">
      <text>{{item.duration === 'D90' ? '90天' : '30天'}}</text>
      <text class="status status-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="refund-reason" wx:if="{{item.refundReason}}">{{item.refundReason}}</view>
    <view class="time">{{item.createdAt}}</view>
    <view class="actions">
      <button wx:if="{{item.status === 'PAID'}}" class="refund" size="mini" data-id="{{item.id}}" catchtap="onRefund">退款</button>
      <button wx:if="{{item.status === 'PENDING' || item.status === 'REFUNDING'}}" class="sync" size="mini" data-id="{{item.id}}" catchtap="onSync">刷新状态</button>
    </view>
  </view>
  <view class="empty" wx:if="{{orders.length === 0 && !loading}}">暂无订单</view>
</view>
