/* M3-07 商家端职位详情页：复用 .yt-card / .yt-footer-bar 全局样式，单独定义本页 hero / info / stats / support 卡 */
.page {
  padding: 24rpx;
  padding-bottom: 200rpx; /* 留底部 fixed bar 空间 */
}

/* Card 1：标题卡 */
.hero {
  display: flex;
  flex-direction: column;
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.hero-status {
  font-size: 24rpx;
  color: var(--yt-text-body);
  font-weight: 500;
}
.hero-badge {
  font-size: 22rpx;
  color: var(--yt-text-sub);
  background: var(--yt-disabled-bg);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.hero-time {
  font-size: 24rpx;
  color: var(--yt-text-sub);
  margin-bottom: 24rpx;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--yt-text-main);
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.hero-salary {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--yt-danger); /* 决策 C：用户允许红色 */
  line-height: 1.3;
  margin-bottom: 20rpx;
}
.hero-chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.chip {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--yt-disabled-bg);
  color: var(--yt-text-body);
  display: inline-block;
}
.chip.primary {
  background: var(--yt-primary-light);
  color: var(--yt-text-main);
  font-weight: 500;
}

/* Card 2：工作信息卡 */
.info-card {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--yt-border);
}
.info-row:last-of-type {
  border-bottom: none;
}
.info-k {
  color: var(--yt-text-sub);
  font-size: 26rpx;
}
.info-v {
  color: var(--yt-text-main);
  font-size: 28rpx;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}
.info-expand {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0 4rpx;
  color: var(--yt-text-sub);
  font-size: 24rpx;
}
.info-expand .arrow {
  font-size: 28rpx;
  line-height: 1;
}

/* Card 3：展开段 */
.detail-card {
  margin-top: 24rpx;
}
.section-block {
  margin-top: 16rpx;
}
.section-block:first-of-type {
  margin-top: 0;
}
.section-h {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--yt-text-main);
  margin-bottom: 8rpx;
}
.section-body {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--yt-text-body);
}
.section-body.prewrap {
  white-space: pre-wrap;
  word-break: break-word;
}
.contact-section { margin-top: 24rpx; }
.contact-row { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; border-top: 1rpx solid var(--yt-border); }
.contact-left { display: flex; align-items: center; gap: 12rpx; }
.contact-icon { width: 32rpx; height: 32rpx; }
.contact-label { font-size: 26rpx; color: var(--yt-text-body); }
.contact-value { max-width: 58%; font-size: 26rpx; color: var(--yt-text-main); text-align: right; word-break: break-all; }
.contact-copy { color: var(--yt-primary-dark, #c59a00); }
.contact-empty { font-size: 26rpx; color: var(--yt-text-sub); padding: 12rpx 0; }
.info-collapse {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0 4rpx;
  color: var(--yt-text-sub);
  font-size: 24rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid var(--yt-border);
}
.info-collapse .arrow.up {
  font-size: 28rpx;
  line-height: 1;
}

/* Card 4：职位数据卡 */
.stats-card {
  margin-top: 24rpx;
}
.stats-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--yt-text-main);
}
.stats-range {
  font-size: 22rpx;
  color: var(--yt-text-sub);
  background: var(--yt-disabled-bg);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.stats-row {
  display: flex;
  justify-content: space-between;
}
.stats-cell {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--yt-text-main);
  line-height: 1.2;
}
.stats-label {
  font-size: 24rpx;
  color: var(--yt-text-sub);
  margin-top: 6rpx;
}

/* Card 5：专属客服 */
.support-card {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}
.support-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.support-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--yt-primary-light);
  color: var(--yt-text-main);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.support-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--yt-text-main);
}
.support-sub {
  font-size: 22rpx;
  color: var(--yt-text-sub);
  margin-top: 4rpx;
}
.support-arrow {
  font-size: 36rpx;
  color: var(--yt-text-weak);
  line-height: 1;
}

/* 底部固定 bar */
.bottom-spacer {
  height: 24rpx;
}
.yt-footer-bar {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.bar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.bar-btn-primary {
  background: var(--yt-primary);
  color: var(--yt-text-main);
}
.bar-btn-primary.bar-btn-full {
  flex: 1;
  width: 100%;
}
.bar-btn-danger-outline {
  background: var(--yt-card);
  color: var(--yt-danger);
  border: 1rpx solid var(--yt-danger);
  flex: 0 0 30%;
}
