.page { padding: 24rpx; }
.card {
  background: linear-gradient(135deg, #ffb3c1, #ff4d6d);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.shop { font-size: 34rpx; font-weight: 600; }
.status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; background: rgba(255,255,255,0.25); }
.status-REJECTED { background: rgba(0,0,0,0.2); }

.info { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.row:last-child { border-bottom: none; }
.label { width: 180rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.value { flex: 1; font-size: 28rpx; color: #222; }
.input { flex: 1; font-size: 28rpx; }

.btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #ff6b8a, #ff4d6d) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
}
.btn[disabled] { background: #ffb3c1 !important; }

.tip { text-align: center; color: #999; font-size: 24rpx; margin-top: 24rpx; }
