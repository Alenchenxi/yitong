<view class="page">
  <view class="title">商家入驻</view>
  <view class="hint">填写资质信息，提交后等待审核（开发环境自动通过）</view>

  <view class="form">
    <view class="row">
      <text class="label">店铺名称</text>
      <input class="input" placeholder="如：校园奶茶店" value="{{shopName}}" data-field="shopName" bindinput="onInput" />
    </view>
    <view class="row">
      <text class="label">营业执照号</text>
      <input class="input" placeholder="统一社会信用代码" value="{{licenseNo}}" data-field="licenseNo" bindinput="onInput" />
    </view>
    <view class="row">
      <text class="label">联系电话</text>
      <input class="input" type="number" placeholder="11 位手机号" value="{{contactPhone}}" data-field="contactPhone" bindinput="onInput" maxlength="11" />
    </view>
  </view>

  <button class="submit" bindtap="submit" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '提交入驻'}}
  </button>
</view>
